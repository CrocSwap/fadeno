    next,
    runtime: {
      invocationSource,
      managedVersion,
      managedPath: installation.runtime?.path ?? null,
      versionCurrent,
      installedHarnesses: Object.keys(installation.harnesses).sort(),
      skew,
      preferredCli,
      preferredReason,
      observedVersion,
      observedSource
    },
    activeLoadout: null,
    staleProjectPin: null,
    staleUserPin: null,
    pinOverrides: {}
  };
}

