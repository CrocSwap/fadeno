var RunError = class extends Error {
};
var TERMINAL_STATUSES = /* @__PURE__ */ new Set(["completed", "failed", "aborted"]);
var VALID_STATUSES = /* @__PURE__ */ new Set(["running", ...TERMINAL_STATUSES]);
function normalizeArtifactPath(runDir, artifactArg) {
  const rel = (0, import_node_path20.isAbsolute)(artifactArg) ? (0, import_node_path20.relative)(runDir, artifactArg) : artifactArg;
  const normalized = rel.split("\\").join("/");
  if (normalized.startsWith("..")) {
    throw new RunError(
      `artifact path ${artifactArg} escapes the run directory; record paths under the run (e.g. artifacts/...).`
    );
  }
  return normalized;
}
function resolveRunDir2(repoRoot, cwd, run) {
  const candidates = (0, import_node_path20.isAbsolute)(run) ? [run] : [(0, import_node_path20.join)(repoRoot, ".fadeno", "runs", run), (0, import_node_path20.resolve)(cwd, run)];
  for (const candidate of candidates) {
    const dir = candidate.endsWith("run.yaml") ? candidate.slice(0, -"run.yaml".length) : candidate;
    if ((0, import_node_fs20.existsSync)((0, import_node_path20.join)(dir, "run.yaml"))) return dir;
  }
  throw new RunError(`No run found for "${run}" (looked for run.yaml under .fadeno/runs).`);
}
function parseFieldValue(raw) {
  const trimmed = raw.trim();
  if (trimmed === "") return "";
  try {
    return JSON.parse(trimmed);
  } catch {
    return raw;
  }
}
function parseFields(fields) {
  if (!fields || fields.length === 0) return {};
  const out = {};
  for (const entry of fields) {
    const eq = entry.indexOf("=");
    if (eq <= 0) {
      throw new RunError(`Invalid --field "${entry}"; expected k=v (e.g. branch=approve).`);
    }
    const key = entry.slice(0, eq).trim();
    const value = entry.slice(eq + 1);
    if (!key) {
      throw new RunError(`Invalid --field "${entry}"; expected k=v (e.g. branch=approve).`);
    }
    out[key] = parseFieldValue(value);
  }
  return out;
}
function runRun(opts) {
  const extraFields = parseFields(opts.fields);
  const hasAttribution = opts.member != null || Object.keys(extraFields).length > 0;
  if (!opts.step && !opts.status && !opts.event && !opts.artifact && !hasAttribution) {
    throw new RunError("Nothing to do: pass --step, --status, --event, and/or --artifact.");
  }
  if (hasAttribution && !opts.event && !opts.artifact && !opts.step && !opts.status) {
    throw new RunError("--member / --field require an event to attach to (--event and/or --artifact).");
  }
  const cwd = opts.cwd ?? process.cwd();
  const repoRoot = opts.repoRoot ?? findRepoRoot(cwd);
  const runDir = resolveRunDir2(repoRoot, cwd, opts.run);
  const runYamlPath = (0, import_node_path20.join)(runDir, "run.yaml");
  let writer;
  try {
    writer = new LedgerWriter(runDir);
  } catch (err) {
    if (err instanceof LedgerWriteError) throw new RunError(err.message);
    throw err;
  }
  const run = (0, import_yaml10.parse)((0, import_node_fs20.readFileSync)(runYamlPath, "utf8"));
  const now = opts.now ?? /* @__PURE__ */ new Date();
  const iso = now.toISOString();
  const appendedEvents = [];
  const updatedFields = [];
  const appendEvent2 = (event) => {
    writer.append(event, now);
    appendedEvents.push(event.type);
  };
  const buildManifestFor = (artifactArg) => {
    const rel = normalizeArtifactPath(runDir, artifactArg);
    const schemaPaths = runSchemaDirectories(runDir, repoRoot);
    const schemas = new SchemaSet(schemaPaths.snapshot, schemaPaths.project, schemaPaths.builtin);
    let fields;
    try {
      fields = buildArtifactManifest(runDir, rel, `artifact-${writer.nextSeq}`, schemas);
    } catch (err) {
      if (err instanceof ManifestError) throw new RunError(err.message);
      throw err;
    }
    const { events: priorEvents } = readEvents(runDir);
    for (const prior of priorEvents) {
      if (prior.type !== "artifact_created" || prior.extra.artifact !== fields.artifact) continue;
      if (typeof prior.extra.sha256 === "string" && prior.extra.sha256 !== fields.sha256) {
        throw new RunError(
          `${fields.artifact} was already recorded with a different sha256; artifacts are immutable \u2014 write a new generation (.v<G>) instead.`
        );
      }
    }
    return fields;
  };
  if (opts.step) {
    run.current_step = opts.step;
    updatedFields.push("current_step");
    appendEvent2({ type: "step_started", step: opts.step });
  }
  const eventStep = opts.step ?? (run.current_step ?? null);
  const attachAttribution = (event) => {
    if (opts.member != null) event.member = opts.member;
    for (const [key, value] of Object.entries(extraFields)) {
      event[key] = value;
    }
  };
  let manifest;
  if (opts.event) {
    const event = { type: opts.event, step: eventStep };
    if (opts.event === "artifact_created") {
      if (!opts.artifact) {
        throw new RunError("An artifact_created event requires --artifact <path>.");
      }
      manifest = buildManifestFor(opts.artifact);
      attachAttribution(event);
      Object.assign(event, manifest);
    } else if (opts.event === "artifact_superseded") {
      if (!opts.artifact) {
        throw new RunError("An artifact_superseded event requires --artifact <superseded path>.");
      }
      const rel = normalizeArtifactPath(runDir, opts.artifact);
      const byRaw = extraFields.superseded_by;
      if (typeof byRaw !== "string" || byRaw === "") {
        throw new RunError(
          "artifact_superseded requires --field superseded_by=<recorded artifact path>."
        );
      }
      const byRel = normalizeArtifactPath(runDir, byRaw);
      if (byRel === rel) {
        throw new RunError("artifact_superseded: superseded_by must name a different artifact.");
      }
      const { events: priorEvents } = readEvents(runDir);
      const recorded = new Set(
        priorEvents.filter((e) => e.type === "artifact_created" && typeof e.extra.artifact === "string").map((e) => e.extra.artifact)
      );
      for (const [label, path] of [["artifact", rel], ["superseded_by", byRel]]) {
        if (!recorded.has(path)) {
          throw new RunError(
            `artifact_superseded: ${label} ${path} was never recorded as artifact_created.`
          );
        }
      }
      attachAttribution(event);
      event.artifact = rel;
      event.superseded_by = byRel;
    } else {
      if (opts.artifact) {
        event.artifact = opts.artifact;
      }
      attachAttribution(event);
    }
    appendEvent2(event);
  } else if (opts.artifact) {
    manifest = buildManifestFor(opts.artifact);
    const event = { type: "artifact_created", step: eventStep };
    attachAttribution(event);
    Object.assign(event, manifest);
    appendEvent2(event);
  } else if (hasAttribution) {
    throw new RunError("--member / --field require an event to attach to (--event and/or --artifact).");
  }
  if (opts.status) {
    if (!VALID_STATUSES.has(opts.status)) {
      throw new RunError(
        `Invalid status "${opts.status}". Use one of: ${[...VALID_STATUSES].join(", ")}.`
      );
    }
    run.status = opts.status;
    updatedFields.push("status");
    if (TERMINAL_STATUSES.has(opts.status)) {
      run.ended_at = iso;
      updatedFields.push("ended_at");
      run.current_step = null;
      appendEvent2({ type: `run_${opts.status}`, step: null });
    }
  }
  writeRunDocument(runDir, run);
  return { runDir, appendedEvents, updatedFields, manifest };
}

