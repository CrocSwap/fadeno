      const nextOutgoing = transfer(byId.get(id), nextIncoming, byId);
      if (!sameSet(incoming.get(id), nextIncoming) || !sameSet(outgoing.get(id), nextOutgoing)) changed = true;
      incoming.set(id, nextIncoming);
