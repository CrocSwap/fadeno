function readStepIds(repoRoot, runRef) {
  const run = resolveRun2(safeRuns(repoRoot), runRef);
  if (run == null) return [];
  const file = playbookFile(repoRoot, run);
  if (file == null) return [];
  try {
    const doc = (0, import_yaml17.parse)((0, import_node_fs34.readFileSync)(file, "utf8"));
    if (!Array.isArray(doc?.flow)) return [];
    const byId = /* @__PURE__ */ new Map();
    for (const raw of doc.flow) {
      if (raw != null && typeof raw === "object" && !Array.isArray(raw)) {
        const id = raw.id;
        if (typeof id === "string") byId.set(id, raw);
      }
    }
    const found = /* @__PURE__ */ new Set();
    const visit = (id) => {
      if (found.has(id)) return;
      const step = byId.get(id);
      if (step == null) return;
      found.add(id);
      if (Array.isArray(step.body)) {
        for (const child of step.body) if (typeof child === "string") visit(child);
      }
    };
    for (const id of byId.keys()) visit(id);
    return uniqueSorted(found);
  } catch {
    return [];
  }
}
