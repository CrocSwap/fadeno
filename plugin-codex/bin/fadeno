function locatePlaybook2(runDir, repoRoot, name) {
  const found = resolveRunPlaybookFile(runDir, repoRoot, name);
  if (found) return found.path;
  throw new DriveError(`Playbook "${name}" not found in bundled or project definitions.`);
}
function loadValidatedPlaybook(runDir, repoRoot, name, schemas) {
  const playbookPath = locatePlaybook2(runDir, repoRoot, name);
  let playbook;
  try {
    const parsed = (0, import_yaml11.parse)((0, import_node_fs22.readFileSync)(playbookPath, "utf8"));
    if (parsed == null || typeof parsed !== "object" || Array.isArray(parsed)) {
      throw new Error("playbook is not a mapping");
    }
    playbook = parsed;
  } catch (err) {
    throw new DriveError(`could not parse playbook ${name}: ${err.message}`);
  }
  const validation = validateFile(playbookPath, schemas, "playbook");
  const errors = validation.issues.filter((issue) => issue.severity === "error");
  if (errors.length > 0) {
    const detail2 = errors.map((issue) => `${issue.path || "/"}: ${issue.message}`).join("; ");
    throw new DriveError(`playbook ${name} is invalid; fix it before driving: ${detail2}`);
  }
  return playbook;
}
