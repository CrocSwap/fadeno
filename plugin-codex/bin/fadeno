  const writeConflict = compiled.spec.adapter === "command" ? explainWriteConflict({ executor: refString, spec: compiled.spec }, archetype, profile) : null;
  if (writeConflict != null && opts.force !== true) throw new DialError(writeConflict);
  if (writeConflict != null) dial.force_write_posture = true;
