var ToolExecError = class extends Error {
};
var TOOL_SUMMARY_MAX_BYTES = 4e3;
var TOOL_DETAILS_MAX_BYTES = 32 * 1024;
var SPAWN_MAX_BUFFER2 = 32 * 1024 * 1024;
function renderArgv(argv) {
  return argv.map((part) => {
    if (/^[a-zA-Z0-9._\/:=-]+$/.test(part)) return part;
    return `'${part.replace(/'/g, `'"'"'`)}'`;
  }).join(" ");
}
function commandDigest(argv) {
  return sha256Hex(JSON.stringify(argv));
}
function toolAttemptIds(stepId, generation) {
