  try {
    for (const segment of rel.split("/")) {
      cursor = (0, import_node_path36.join)(cursor, segment);
      if ((0, import_node_fs36.lstatSync)(cursor).isSymbolicLink()) {
        throw new DispatchPromptError(`prompt snapshot traverses a symlink: ${promptRel}`);
      }
    }
    const realRel = (0, import_node_path36.relative)((0, import_node_fs36.realpathSync)(runAbsolute), (0, import_node_fs36.realpathSync)(promptAbs)).split("\\").join("/");
    if (realRel === ".." || realRel.startsWith("../") || (0, import_node_path36.isAbsolute)(realRel)) {
      throw new DispatchPromptError(`prompt snapshot escapes its run directory: ${promptRel}`);
    }
  } catch (err) {
    if (err instanceof DispatchPromptError) throw err;
    if (err.code === "ENOENT") {
      throw new DispatchPromptError(`prompt snapshot is missing: ${promptRel}`);
    }
    throw new DispatchPromptError(`cannot inspect prompt snapshot ${promptRel}: ${err.message}`);
  }
  let promptBytes;
  try {
    promptBytes = (0, import_node_fs36.readFileSync)(promptAbs);
