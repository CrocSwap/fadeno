var SHADOW_POLL_MS = 50;
var SHADOW_LIVENESS_EVERY = 20;
var SHADOW_MARKER_SUFFIX = ".shadow.json";
var SHADOW_MAX_LIVE_DEFAULT = 4;
function shadowLiveCap(env = process.env) {
  const raw = env.FADENO_SHADOW_MAX_LIVE;
  if (raw == null || raw.trim() === "") return SHADOW_MAX_LIVE_DEFAULT;
  const parsed = Number(raw.trim());
  if (!Number.isInteger(parsed) || parsed < 0) return SHADOW_MAX_LIVE_DEFAULT;
  return parsed;
}
var PID_START_TOLERANCE_MS = 5 * 60 * 1e3;
function realPidStartedAt(pid) {
  try {
    const res = (0, import_node_child_process5.spawnSync)("ps", ["-o", "lstart=", "-p", String(pid)], {
      encoding: "utf8",
      env: { ...process.env, LC_ALL: "C" }
    });
    if (res.error != null || res.status !== 0) return null;
    const out = String(res.stdout ?? "").trim();
    return out.length > 0 ? out : null;
  } catch {
    return null;
  }
}
function countLiveShadows(repoRoot, killProbe = (pid, signal) => process.kill(pid, signal), startProbe = realPidStartedAt) {
  const dir = (0, import_node_path15.join)(repoRoot, ...INFLIGHT_DIR.split("/"));
  let names;
  try {
    names = (0, import_node_fs15.readdirSync)(dir);
  } catch {
    return 0;
  }
  let live = 0;
  for (const name of names) {
    if (!name.endsWith(SHADOW_MARKER_SUFFIX)) continue;
    const abs = (0, import_node_path15.join)(dir, name);
    let record2;
    try {
      record2 = JSON.parse((0, import_node_fs15.readFileSync)(abs, "utf8"));
    } catch {
      try {
        (0, import_node_fs15.rmSync)(abs, { force: true });
      } catch {
      }
      continue;
    }
    const pid = record2.supervisor_pid;
    if (typeof pid !== "number") continue;
    let alive;
    try {
      killProbe(pid, 0);
      alive = true;
    } catch (err) {
      alive = err.code !== "ESRCH";
    }
    if (alive && typeof record2.started_at === "string") {
      const recorded = Date.parse(record2.started_at);
      let observedRaw;
      try {
        observedRaw = startProbe(pid);
      } catch {
        observedRaw = null;
      }
      const observed = observedRaw != null ? Date.parse(observedRaw) : NaN;
      if (!Number.isNaN(recorded) && !Number.isNaN(observed) && Math.abs(observed - recorded) > PID_START_TOLERANCE_MS) {
        alive = false;
      }
    }
    if (alive) live += 1;
    else {
      try {
        (0, import_node_fs15.rmSync)(abs, { force: true });
      } catch {
      }
    }
  }
  return live;
}
function workspaceFingerprint(repoRoot) {
  const status = (0, import_node_child_process5.spawnSync)("git", ["-C", repoRoot, "status", "--porcelain"], { encoding: "utf8" });
  if (status.error != null || status.status !== 0) return null;
  const head = (0, import_node_child_process5.spawnSync)("git", ["-C", repoRoot, "rev-parse", "HEAD"], { encoding: "utf8" });
  if (head.error != null || head.status !== 0) return null;
  return sha256Hex(`${status.stdout ?? ""}\0${head.stdout ?? ""}`);
}
function isUnderShadowHome(repoRelPath) {
  return repoRelPath === ".fadeno/local" || repoRelPath.startsWith(".fadeno/local/");
}
function gitFailureReason(result) {
  if (result.error != null) return result.error.message;
  const stderr = String(result.stderr ?? "").trim();
  if (stderr.length > 0) return stderr;
  return `exit ${result.status ?? "unknown"}`;
}
var BASELINE_COMMIT_DATE = "2000-01-01T00:00:00Z";
function captureWorkspaceBaseline(repoRoot) {
  const diffRes = (0, import_node_child_process5.spawnSync)("git", ["-C", repoRoot, "diff", "HEAD", "--binary"], {
    encoding: "buffer",
    maxBuffer: SPAWN_MAX_BUFFER
  });
  if (diffRes.error != null || diffRes.status !== 0) {
    throw new Error(`could not capture the primary workspace's pre-spawn state: ${gitFailureReason(diffRes)}`);
  }
  const untrackedRes = (0, import_node_child_process5.spawnSync)("git", ["-C", repoRoot, "ls-files", "--others", "--exclude-standard", "-z"], {
    encoding: "utf8",
    maxBuffer: SPAWN_MAX_BUFFER
  });
  if (untrackedRes.error != null || untrackedRes.status !== 0) {
    throw new Error(`could not list the primary workspace's untracked files: ${gitFailureReason(untrackedRes)}`);
  }
  return {
    patch: diffRes.stdout ?? Buffer.alloc(0),
    untrackedFiles: String(untrackedRes.stdout ?? "").split("\0").filter((p) => p.length > 0).filter((p) => !isUnderShadowHome(p))
  };
}
function applyWorkspaceBaseline(repoRoot, worktreeAbs, captured, pairId, armLabel) {
  const patch = captured.patch;
  if (patch.length > 0) {
    const applyRes = (0, import_node_child_process5.spawnSync)("git", ["-C", worktreeAbs, "apply", "--index"], {
      input: patch,
      encoding: "utf8",
      maxBuffer: SPAWN_MAX_BUFFER
    });
    if (applyRes.error != null || applyRes.status !== 0) {
      throw new Error(`could not replay the caller's pre-spawn changes into the ${armLabel} worktree: ${gitFailureReason(applyRes)}`);
    }
  }
  let copiedAny = false;
  for (const relPath of captured.untrackedFiles) {
    try {
      const srcAbs = (0, import_node_path15.join)(repoRoot, relPath);
      const destAbs = (0, import_node_path15.join)(worktreeAbs, relPath);
      (0, import_node_fs15.mkdirSync)((0, import_node_path15.dirname)(destAbs), { recursive: true });
      (0, import_node_fs15.copyFileSync)(srcAbs, destAbs);
      (0, import_node_fs15.chmodSync)(destAbs, (0, import_node_fs15.statSync)(srcAbs).mode);
      copiedAny = true;
    } catch (err) {
      const reason = err instanceof Error ? err.message : String(err);
      throw new Error(`could not copy untracked file "${relPath}" into the ${armLabel} worktree: ${reason}`);
    }
  }
  if (patch.length === 0 && !copiedAny) {
    const headRes = (0, import_node_child_process5.spawnSync)("git", ["-C", worktreeAbs, "rev-parse", "HEAD"], { encoding: "utf8" });
    if (headRes.error != null || headRes.status !== 0) {
      throw new Error(`could not resolve the ${armLabel} worktree's HEAD: ${gitFailureReason(headRes)}`);
    }
    return String(headRes.stdout ?? "").trim();
  }
  const addRes = (0, import_node_child_process5.spawnSync)("git", ["-C", worktreeAbs, "add", "-A"], { encoding: "utf8" });
  if (addRes.error != null || addRes.status !== 0) {
    throw new Error(`could not stage the workspace baseline in the ${armLabel} worktree: ${gitFailureReason(addRes)}`);
  }
  const commitRes = (0, import_node_child_process5.spawnSync)("git", [
    "-C",
    worktreeAbs,
    "-c",
    "user.name=fadeno",
    "-c",
    "user.email=fadeno@localhost",
    "commit",
    "--no-verify",
    "--no-gpg-sign",
    "-m",
    `fadeno pair baseline ${pairId}`
  ], {
    encoding: "utf8",
    env: {
      ...process.env,
      GIT_AUTHOR_DATE: BASELINE_COMMIT_DATE,
      GIT_COMMITTER_DATE: BASELINE_COMMIT_DATE
    }
  });
  if (commitRes.error != null || commitRes.status !== 0) {
    throw new Error(`could not commit the workspace baseline in the ${armLabel} worktree: ${gitFailureReason(commitRes)}`);
  }
  const shaRes = (0, import_node_child_process5.spawnSync)("git", ["-C", worktreeAbs, "rev-parse", "HEAD"], { encoding: "utf8" });
  if (shaRes.error != null || shaRes.status !== 0) {
    throw new Error(`could not resolve the ${armLabel} worktree's baseline commit: ${gitFailureReason(shaRes)}`);
  }
  return String(shaRes.stdout ?? "").trim();
}
