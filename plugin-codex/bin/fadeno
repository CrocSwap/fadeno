var DispatchCommandError = class extends Error {
};
var DISPATCHES_FILE = (0, import_node_path15.join)(".fadeno", "dispatches.jsonl");
var DISPATCHES_FORMAT = "1.0";
var DISPATCH_TAG_RE = /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/;
function normalizeDispatchTag(tag) {
  if (tag == null) return null;
  const trimmed = tag.trim();
  if (trimmed === "") return null;
  if (!DISPATCH_TAG_RE.test(trimmed)) {
    throw new DispatchCommandError(
      `--tag "${trimmed}" is not a valid handle: use 1-64 characters of letters, digits, dot, underscore or hyphen, starting with a letter or digit.`
    );
  }
  return trimmed;
}
var DISPATCH_OUTCOMES = ["ok", "failed", "empty", "timeout"];
function deriveDispatchOutcome(row) {
  if (row.timedOut === true) return "timeout";
  if (row.error != null || row.signal != null) return "failed";
  if (row.exitCode == null) return null;
  if (row.exitCode !== 0) return "failed";
  if (row.outputBytes == null) return null;
  return row.outputBytes === 0 ? "empty" : "ok";
}
function normalizeDispatchOutcome(stated, row) {
  if (typeof stated === "string" && DISPATCH_OUTCOMES.includes(stated)) return stated;
  return deriveDispatchOutcome(row);
}
var PENDING_RELAYS_FILE = (0, import_node_path15.join)(".fadeno", "local", "pending-relays.jsonl");
var PENDING_RELAY_MAX_AGE_MS = 60 * 60 * 1e3;
function consumePendingRelay(repoRoot, prompt, now) {
  const path = (0, import_node_path15.join)(repoRoot, PENDING_RELAYS_FILE);
  if (!(0, import_node_fs15.existsSync)(path)) return null;
  let rows;
  try {
    rows = (0, import_node_fs15.readFileSync)(path, "utf8").split("\n").filter((line) => line.trim() !== "").map((line) => JSON.parse(line));
  } catch {
    return null;
  }
  const fresh = rows.filter((row) => {
    const ts = typeof row.timestamp === "string" ? Date.parse(row.timestamp) : NaN;
    return Number.isFinite(ts) && now.getTime() - ts <= PENDING_RELAY_MAX_AGE_MS && typeof row.prompt_sha256 === "string";
  });
  const digests = /* @__PURE__ */ new Set([sha256Hex(prompt), sha256Hex(prompt.replace(/\n$/, ""))]);
  const hit = fresh.findIndex((row) => digests.has(row.prompt_sha256));
  const remaining = hit === -1 ? fresh : fresh.filter((_, index) => index !== hit);
  try {
    if (remaining.length === 0) (0, import_node_fs15.rmSync)(path, { force: true });
    else (0, import_node_fs15.writeFileSync)(path, `${remaining.map((row) => JSON.stringify(row)).join("\n")}
`, "utf8");
  } catch {
  }
  if (hit !== -1) return true;
  return fresh.length > 0 ? false : null;
}
