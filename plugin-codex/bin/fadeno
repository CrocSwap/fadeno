        removeHostWorkspace({ repoRoot: opts.repoRoot, state: evidence.state });
      } else {
        removeHostWorkspaceByPath({ repoRoot: opts.repoRoot, run: opts.runId, dispatchId: opts.dispatchId, workspaceRel: evidence.workspaceRel });
      }
    } catch {
    }
  }
}
function safeRunRelative(runDir, value, label) {
  const runAbsolute = (0, import_node_path13.resolve)(runDir);
  const absolute = (0, import_node_path13.isAbsolute)(value) ? (0, import_node_path13.resolve)(value) : (0, import_node_path13.resolve)(runAbsolute, value);
  const rel = (0, import_node_path13.relative)(runAbsolute, absolute).split("\\").join("/");
  if (rel === "" || rel === "." || rel === ".." || rel.startsWith("../") || (0, import_node_path13.isAbsolute)(rel)) {
    throw new HostDispatchError(`${label} path escapes the run directory: ${value}`);
  }
  const runReal = (0, import_node_fs13.realpathSync)(runAbsolute);
  let cursor = runAbsolute;
  for (const segment of rel.split("/")) {
    cursor = (0, import_node_path13.join)(cursor, segment);
    try {
      if ((0, import_node_fs13.lstatSync)(cursor).isSymbolicLink()) {
        throw new HostDispatchError(`${label} path traverses a symlink: ${value}`);
      }
    } catch (err) {
      if (err instanceof HostDispatchError) throw err;
      if (err.code === "ENOENT") break;
      throw err;
    }
  }
  let existing = absolute;
  let existingReal;
  for (; ; ) {
    try {
      existingReal = (0, import_node_fs13.realpathSync)(existing);
      break;
    } catch (err) {
      if (err.code !== "ENOENT") throw err;
      const parent = (0, import_node_path13.dirname)(existing);
      if (parent === existing) throw new HostDispatchError(`${label} path cannot be resolved: ${value}`);
      existing = parent;
    }
  }
  const suffix = (0, import_node_path13.relative)(existing, absolute);
  const resolvedTarget = (0, import_node_path13.resolve)(existingReal, suffix);
  const realRel = (0, import_node_path13.relative)(runReal, resolvedTarget).split("\\").join("/");
  if (realRel === ".." || realRel.startsWith("../") || (0, import_node_path13.isAbsolute)(realRel)) {
    throw new HostDispatchError(`${label} path escapes the run directory through a symlink: ${value}`);
  }
  return rel;
}
function validationFor(repoRoot, runDir, request, bytes) {
  if (request.artifactType == null) return { ok: true };
  let parsed;
  try {
    parsed = JSON.parse(bytes.toString("utf8"));
  } catch (err) {
    const schemaPaths2 = runSchemaDirectories(runDir, repoRoot);
    const schemas2 = new SchemaSet(schemaPaths2.snapshot, schemaPaths2.project, schemaPaths2.builtin);
    if (request.artifactType && schemas2.has(request.artifactType)) {
      const validate2 = schemas2.get(request.artifactType);
      const result = extractSchemaEnvelope(bytes.toString("utf8"), validate2);
      if (result.ok) {
        return { ok: true, extraction: result.extraction, parsed: result.parsed };
      }
      if (result.reason === "schema_invalid" && result.errors && result.errors.length > 0) {
        const prefixed = result.errors.slice(0, 5).map((e) => `envelope candidate failed schema: ${e}`);
        return { ok: false, errors: prefixed };
      }
      return { ok: false, errors: [`output is not valid JSON: ${err.message}`] };
    }
    return { ok: false, errors: [`output is not valid JSON: ${err.message}`] };
  }
  const schemaPaths = runSchemaDirectories(runDir, repoRoot);
  const schemas = new SchemaSet(schemaPaths.snapshot, schemaPaths.project, schemaPaths.builtin);
  if (!schemas.has(request.artifactType)) return { ok: true };
  const validate = schemas.get(request.artifactType);
  return validate(parsed) ? { ok: true, parsed } : { ok: false, errors: schemaErrorMessages(validate) };
}
