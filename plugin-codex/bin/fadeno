function runModelsDriver(opts) {
  const repoRoot = repoRootOf2(opts);
  const layered = loadLayered2(repoRoot, opts.userPathOptions);
  const profile = layered.profile;
  const harness = profile.harness ?? "standalone";
  const driver = opts.driver.trim();
  const found = routeByDriver(profile, driver);
  if (found == null) {
    const declared = Object.entries(routesForHarness(profile)).map(([key, route]) => route.driver ?? key).sort();
    throw new ModelsError(`unknown driver "${driver}" \u2014 declared drivers: ${[...new Set(declared)].join(", ")}`);
  }
  const modelsCommand = found.route.models_command;
  if (modelsCommand == null || modelsCommand.length === 0) {
    throw new ModelsError(`driver "${driver}" declares no models_command \u2014 its backend cannot be listed.`);
  }
  const spawnFn = opts.spawn ?? ((command2, spawnOpts) => {
    const run = (0, import_node_child_process9.spawnSync)(command2[0], command2.slice(1), { timeout: spawnOpts.timeout, encoding: "utf8" });
    return { status: run.status, stdout: run.stdout ?? "", stderr: run.stderr ?? "", ...run.error != null ? { error: run.error } : {} };
  });
  let result;
  try {
    result = spawnFn(modelsCommand, { timeout: 1e4 });
  } catch (err) {
    throw new ModelsError(`models_command failed for ${driver}: ${err.message}`);
  }
  if (result.error != null) throw new ModelsError(`models_command failed for ${driver}: ${result.error.message}`);
  if (result.status !== 0) throw new ModelsError(`models_command for ${driver} exited ${result.status}.`);
  const stdout = typeof result.stdout === "string" ? result.stdout : result.stdout.toString("utf8");
  const tokens = stdout.split(/[\s,]+/).map((t) => t.trim()).filter((t) => t.length > 0);
  const registeredBy = /* @__PURE__ */ new Map();
  for (const [name, entry] of Object.entries(profile.models)) {
    const ids = [];
    const home = routesForHarness(profile)[entry.provider];
    if (home != null && (home.driver ?? entry.provider) === driver) ids.push(entry.id);
    if (entry.spellings[driver] != null) ids.push(entry.spellings[driver]);
    for (const id of ids) {
      const list = registeredBy.get(id) ?? [];
      if (!list.includes(name)) list.push(name);
      registeredBy.set(id, list);
    }
  }
  const seen = /* @__PURE__ */ new Set();
  const models = [];
  for (const token of tokens) {
    if (seen.has(token)) continue;
    seen.add(token);
    models.push({ id: token, registered_as: (registeredBy.get(token) ?? []).sort() });
  }
  return { driver, harness, models_command: modelsCommand, models };
}

// src/commands/new-run.ts
var import_node_fs29 = require("node:fs");
var import_node_path29 = require("node:path");
var import_yaml13 = __toESM(require_dist(), 1);
var NewRunError = class extends Error {
};
function slugify(text, maxLen = 40) {
  const words = text.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim().split(/\s+/).filter(Boolean);
  let slug = "";
  for (const word of words) {
    const next = slug ? `${slug}-${word}` : word;
    if (next.length > maxLen) break;
    slug = next;
  }
  if (!slug && words.length) slug = words[0].slice(0, maxLen);
  return slug || "run";
}
function readDeclaredInputs(playbookPath) {
  const parsed = (0, import_yaml13.parse)((0, import_node_fs29.readFileSync)(playbookPath, "utf8"));
  if (parsed?.inputs == null) return {};
  if (typeof parsed.inputs !== "object" || Array.isArray(parsed.inputs)) {
    throw new NewRunError("playbook inputs must be a mapping of logical name to media_type.");
  }
  const result = {};
  for (const [name, raw] of Object.entries(parsed.inputs)) {
    if (!/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(name)) {
      throw new NewRunError(`declared input "${name}" is not a safe logical name.`);
    }
    if (raw === null || typeof raw !== "object" || Array.isArray(raw)) {
      throw new NewRunError(`declared input "${name}" must be a mapping with media_type.`);
    }
    const mediaType = raw.media_type;
    if (typeof mediaType !== "string" || mediaType.length === 0) {
      throw new NewRunError(`declared input "${name}" needs a non-empty media_type.`);
    }
    result[name] = { mediaType };
  }
  return result;
}
function parseInputArgs(values) {
  const parsed = /* @__PURE__ */ new Map();
  for (const value of values ?? []) {
    const eq = value.indexOf("=");
    if (eq <= 0 || eq === value.length - 1) {
      throw new NewRunError(`Invalid --input "${value}"; expected Name=path.`);
    }
    const name = value.slice(0, eq).trim();
    const path = value.slice(eq + 1).trim();
    if (!name || !path) throw new NewRunError(`Invalid --input "${value}"; expected Name=path.`);
    if (parsed.has(name)) throw new NewRunError(`duplicate run input "${name}".`);
    parsed.set(name, path);
  }
  return parsed;
}
function validateInputSources(repoRoot, declared, supplied) {
  const realRepoRoot = (0, import_node_fs29.realpathSync)(repoRoot);
  for (const name of supplied.keys()) {
    if (!(name in declared)) throw new NewRunError(`run input "${name}" is not declared by the playbook.`);
  }
  const missing = Object.keys(declared).filter((name) => !supplied.has(name));
  if (missing.length > 0) throw new NewRunError(`missing required run input(s): ${missing.join(", ")}.`);
  for (const [name, sourceArg] of supplied) {
    const sourceAbs = (0, import_node_path29.isAbsolute)(sourceArg) ? (0, import_node_path29.resolve)(sourceArg) : (0, import_node_path29.resolve)(repoRoot, sourceArg);
    const sourceRel = (0, import_node_path29.relative)(repoRoot, sourceAbs).split("\\").join("/");
    if (sourceRel === ".." || sourceRel.startsWith("../") || (0, import_node_path29.isAbsolute)(sourceRel)) {
      throw new NewRunError(`input "${name}" path escapes the repository: ${sourceArg}`);
    }
    if (!(0, import_node_fs29.existsSync)(sourceAbs)) throw new NewRunError(`input "${name}" source does not exist: ${sourceArg}`);
    if (!(0, import_node_fs29.statSync)(sourceAbs).isFile()) throw new NewRunError(`input "${name}" source is not a file: ${sourceArg}`);
    const realSource = (0, import_node_fs29.realpathSync)(sourceAbs);
    const realRel = (0, import_node_path29.relative)(realRepoRoot, realSource).split("\\").join("/");
    if (realRel === ".." || realRel.startsWith("../") || (0, import_node_path29.isAbsolute)(realRel)) {
      throw new NewRunError(`input "${name}" path escapes the repository through a symlink: ${sourceArg}`);
    }
  }
}
function recordDeclaredInputs(runDir, repoRoot, declared, supplied, now) {
  const realRepoRoot = (0, import_node_fs29.realpathSync)(repoRoot);
  const writer = new LedgerWriter(runDir);
  const recorded = [];
  for (const name of Object.keys(declared)) {
    const sourceArg = supplied.get(name);
    const sourceAbs = (0, import_node_path29.isAbsolute)(sourceArg) ? (0, import_node_path29.resolve)(sourceArg) : (0, import_node_path29.resolve)(repoRoot, sourceArg);
    const sourceRel = (0, import_node_path29.relative)(repoRoot, sourceAbs).split("\\").join("/");
    if (sourceRel === ".." || sourceRel.startsWith("../") || (0, import_node_path29.isAbsolute)(sourceRel)) {
      throw new NewRunError(`input "${name}" path escapes the repository: ${sourceArg}`);
    }
    if (!(0, import_node_fs29.existsSync)(sourceAbs)) throw new NewRunError(`input "${name}" source does not exist: ${sourceArg}`);
    if (!(0, import_node_fs29.statSync)(sourceAbs).isFile()) throw new NewRunError(`input "${name}" source is not a file: ${sourceArg}`);
    const realSource = (0, import_node_fs29.realpathSync)(sourceAbs);
    const realRel = (0, import_node_path29.relative)(realRepoRoot, realSource).split("\\").join("/");
    if (realRel === ".." || realRel.startsWith("../") || (0, import_node_path29.isAbsolute)(realRel)) {
      throw new NewRunError(`input "${name}" path escapes the repository through a symlink: ${sourceArg}`);
    }
