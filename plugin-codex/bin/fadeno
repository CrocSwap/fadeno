  }, opts.now ?? /* @__PURE__ */ new Date());
  try {
    (0, import_node_fs21.rmSync)(opts.outputSnapshotAbs, { force: true });
  } catch {
  }
  try {
    (0, import_node_fs21.rmSync)(opts.stderrSnapshotAbs, { force: true });
  } catch {
