    const direct = (0, import_node_path17.isAbsolute)(ref) ? ref : (0, import_node_path17.resolve)(cwd, ref);
    if ((0, import_node_fs17.existsSync)(direct)) return direct;
  }
  const found = resolvePlaybookFile(repoRoot, ref);
  if (found) return found.path;
  throw new DiagramError(`Playbook "${ref}" not found in bundled or project definitions.`);
}
function runDiagram(opts) {
