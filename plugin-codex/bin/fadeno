// src/commands/vendor.ts
var import_node_crypto14 = require("node:crypto");
var import_node_fs43 = require("node:fs");
var import_node_path44 = require("node:path");
function makeVendoredCodexAgentsTrackable(repoRoot) {
  const path = (0, import_node_path44.join)(repoRoot, ".gitignore");
  const current = (0, import_node_fs43.existsSync)(path) ? (0, import_node_fs43.readFileSync)(path, "utf8") : "";
  const rules = ["!.codex/agents/worker.toml", "!.codex/agents/reviewer.toml", "!.codex/agents/judge.toml"];
  const missing = rules.filter((rule) => !current.split(/\r?\n/).includes(rule));
  if (missing.length === 0) return;
  const separator = current.length === 0 || current.endsWith("\n") ? "" : "\n";
  (0, import_node_fs43.writeFileSync)(path, `${current}${separator}# Fadeno: explicitly vendored Codex brokers
${missing.join("\n")}
`, "utf8");
}
function digestTree(root) {
  const files = {};
  function walk(dir) {
    for (const entry of (0, import_node_fs43.readdirSync)(dir, { withFileTypes: true })) {
      const full = (0, import_node_path44.join)(dir, entry.name);
      if (entry.isDirectory()) walk(full);
      else if (entry.isFile()) files[(0, import_node_path44.relative)(root, full).split("\\").join("/")] = (0, import_node_crypto14.createHash)("sha256").update((0, import_node_fs43.readFileSync)(full)).digest("hex");
    }
  }
  walk(root);
  return files;
}
function ownedVendoredFiles(repoRoot, init) {
  const owned = {};
  const shared = /* @__PURE__ */ new Set(["AGENTS.md", "CLAUDE.md", ".gitignore", ".claude/settings.local.json"]);
  for (const result of init.results) {
    if (result.status !== "created" && result.status !== "overwritten") continue;
    const rel = (0, import_node_path44.relative)(repoRoot, result.path).split("\\").join("/");
    if (shared.has(rel) || rel.startsWith("../") || !(0, import_node_fs43.existsSync)(result.path)) continue;
    owned[rel] = (0, import_node_crypto14.createHash)("sha256").update((0, import_node_fs43.readFileSync)(result.path)).digest("hex");
  }
  return owned;
}
function runVendor(opts) {
  const repoRoot = opts.repoRoot ?? findRepoRoot(opts.cwd ?? process.cwd());
  const init = runInit({
    target: opts.target,
    repoRoot,
    force: opts.force,
    withHooks: opts.withHooks,
    withSteering: opts.withSteering ?? opts.target !== "grok"
  });
  if (opts.target === "codex") makeVendoredCodexAgentsTrackable(repoRoot);
  const lockPath = (0, import_node_path44.join)(repoRoot, "fadeno.lock");
  const lockDoc = {
    version: 1,
    fadeno_version: packageVersion(),
    target: opts.target,
    mode: "vendored",
    definitions: digestTree((0, import_node_path44.join)(templatesDir(), "common", "fadeno")),
    capability: digestTree((0, import_node_path44.join)(templatesDir(), opts.target)),
    files: ownedVendoredFiles(repoRoot, init)
  };
  const lock = emitFile(lockPath, `${JSON.stringify(lockDoc, null, 2)}
`, opts.force ?? false);
  return { target: opts.target, repoRoot, init, lockPath, lock: { path: lockPath, status: lock } };
}

// src/commands/evidence.ts
var import_node_crypto15 = require("node:crypto");
var import_node_fs44 = require("node:fs");
var import_node_path45 = require("node:path");
var EvidenceError = class extends Error {
};
function sha256(path) {
  return (0, import_node_crypto15.createHash)("sha256").update((0, import_node_fs44.readFileSync)(path)).digest("hex");
}
function copyOne(source, destination, rel, files) {
  if ((0, import_node_fs44.existsSync)(destination)) {
    if (sha256(source) !== sha256(destination)) throw new EvidenceError(`evidence destination conflict at ${destination}; refusing to overwrite it.`);
  } else {
    (0, import_node_fs44.mkdirSync)((0, import_node_path45.join)(destination, ".."), { recursive: true });
    (0, import_node_fs44.cpSync)(source, destination);
  }
  files.push(rel);
}
function copyTree2(sourceRoot, destinationRoot, files, prefix = "artifacts") {
  if (!(0, import_node_fs44.existsSync)(sourceRoot)) return;
  for (const entry of (0, import_node_fs44.readdirSync)(sourceRoot, { withFileTypes: true })) {
    const source = (0, import_node_path45.join)(sourceRoot, entry.name);
    const destination = (0, import_node_path45.join)(destinationRoot, entry.name);
    const childPrefix = `${prefix}/${entry.name}`;
    if (entry.isDirectory()) copyTree2(source, destination, files, childPrefix);
    else if (entry.isFile()) copyOne(source, destination, childPrefix, files);
  }
}
function runEvidencePromote(opts) {
  const repoRoot = opts.repoRoot ?? findRepoRoot(opts.cwd ?? process.cwd());
  const verification = runVerify({ run: opts.run, repoRoot });
  if (!verification.ok) throw new EvidenceError(`run ${verification.run.runId} did not verify successfully; promotion refused.`);
  const run = resolveRun(repoRoot, opts.run);
  const destination = (0, import_node_path45.join)(repoRoot, ".fadeno", "evidence", run.runId);
  (0, import_node_fs44.mkdirSync)(destination, { recursive: true });
  const files = [];
  copyOne((0, import_node_path45.join)(run.dir, "run.yaml"), (0, import_node_path45.join)(destination, "run.yaml"), "run.yaml", files);
  copyOne((0, import_node_path45.join)(run.dir, "events.jsonl"), (0, import_node_path45.join)(destination, "events.jsonl"), "events.jsonl", files);
  if ((0, import_node_fs44.existsSync)((0, import_node_path45.join)(run.dir, "profile.yaml"))) copyOne((0, import_node_path45.join)(run.dir, "profile.yaml"), (0, import_node_path45.join)(destination, "profile.yaml"), "profile.yaml", files);
  copyTree2((0, import_node_path45.join)(run.dir, "artifacts"), (0, import_node_path45.join)(destination, "artifacts"), files);
  const snapshottedDefinitions = (0, import_node_path45.join)(run.dir, "definitions");
  if ((0, import_node_fs44.existsSync)(snapshottedDefinitions)) {
    copyTree2(snapshottedDefinitions, (0, import_node_path45.join)(destination, "definitions"), files, "definitions");
  } else {
    if (run.playbook != null) {
      const playbook = resolvePlaybookFile(repoRoot, run.playbook);
      if (playbook) copyOne(playbook.path, (0, import_node_path45.join)(destination, "definitions", "playbook.yaml"), "definitions/playbook.yaml", files);
    }
    const schemaNames = ["playbook.schema.json", "run.schema.json", "review-report.schema.json", "test-result.schema.json"];
    for (const name of schemaNames) {
      const schema = resolveDefinition(repoRoot, "schema", name);
      if (schema) copyOne(schema.path, (0, import_node_path45.join)(destination, "definitions", "schemas", name), `definitions/schemas/${name}`, files);
    }
  }
  files.sort();
  const manifest = {
    fadeno_version: packageVersion(),
    run_id: run.runId,
    files: Object.fromEntries(files.map((rel) => {
      const path = (0, import_node_path45.join)(destination, rel);
      return [rel, sha256(path)];
    }))
  };
  const manifestPath = (0, import_node_path45.join)(destination, "manifest.json");
  const text = `${JSON.stringify(manifest, null, 2)}
`;
  const hadManifest = (0, import_node_fs44.existsSync)(manifestPath);
  if (hadManifest && (0, import_node_fs44.readFileSync)(manifestPath, "utf8") !== text) throw new EvidenceError(`evidence destination conflict at ${manifestPath}; refusing to overwrite it.`);
  if (!(0, import_node_fs44.existsSync)(manifestPath)) (0, import_node_fs44.writeFileSync)(manifestPath, text, "utf8");
  return { run: run.runId, destination, manifest: manifestPath, idempotent: hadManifest, files };
}

// src/commands/uninstall.ts
var import_node_fs45 = require("node:fs");
var import_node_os5 = require("node:os");
var import_node_path46 = require("node:path");
var UninstallError = class extends Error {
};
function unrecordedManagedFiles(harness, opts) {
  const home = opts?.home ?? (0, import_node_os5.homedir)();
  if (harness === "claude") return listRetiredClaudeGridCells((0, import_node_path46.join)(home, ".claude", "agents"));
  if (harness !== "codex") return [];
  const agentsDir = codexUserAgentDir(opts);
  return ["worker", "reviewer", "judge"].map((role) => (0, import_node_path46.join)(agentsDir, `fadeno-${role}.toml`));
}
function carriesManagedMarker(path) {
  let text;
  try {
    text = (0, import_node_fs45.readFileSync)(path, "utf8");
  } catch {
    return false;
  }
  return text.startsWith("# fadeno:managed") || isRetiredClaudeGridCell(text);
}
function removePermissionRule(permission, removed, preserved) {
  if (!(0, import_node_fs45.existsSync)(permission.path)) return;
  let data;
  try {
    const parsed = JSON.parse((0, import_node_fs45.readFileSync)(permission.path, "utf8"));
    if (parsed == null || typeof parsed !== "object" || Array.isArray(parsed)) throw new Error("not an object");
    data = parsed;
  } catch {
    preserved.push(`${permission.path} (could not remove ${permission.rule})`);
    return;
  }
  const permissions = data.permissions;
  if (permissions == null || typeof permissions !== "object" || Array.isArray(permissions)) return;
  const allow = permissions.allow;
  if (!Array.isArray(allow) || !allow.includes(permission.rule)) return;
  permissions.allow = allow.filter((item) => item !== permission.rule);
  const emptyPermissions = Object.values(permissions).every((value) => Array.isArray(value) && value.length === 0);
  if (emptyPermissions) delete data.permissions;
  if (permission.createdFile && Object.keys(data).length === 0) (0, import_node_fs45.rmSync)(permission.path, { force: true });
  else (0, import_node_fs45.writeFileSync)(permission.path, `${JSON.stringify(data, null, 2)}
`, "utf8");
  removed.push(`${permission.path} permission ${permission.rule}`);
}
function runUninstall(opts) {
  if (opts.purgeUserData && !opts.force) {
    throw new UninstallError("`--purge-user-data` is destructive; repeat with --force after reviewing the user paths.");
  }
  const paths = userPaths(opts.userPathOptions);
  const manifest = readInstallationManifest(opts.userPathOptions);
  const selected = opts.all || opts.purgeUserData ? ["codex", "claude"] : opts.target != null ? [opts.target] : [];
  if (selected.length === 0 && !opts.purgeUserData) {
    throw new UninstallError("Choose `--codex`, `--claude`, `--all`, or `--purge-user-data --force`.");
  }
  const removed = [];
  const preserved = [];
  for (const harness of selected) {
    const installation = manifest.harnesses[harness];
    const recorded = installation?.files ?? [];
    const files = [
      ...recorded,
      ...unrecordedManagedFiles(harness, opts.userPathOptions).filter((path) => !recorded.some((file) => file.path === path)).map((path) => ({ path, sha256: "" }))
    ];
    for (const file of files) {
      if (!(0, import_node_fs45.existsSync)(file.path)) continue;
      const managedMarker = carriesManagedMarker(file.path);
      if (managedMarker || file.sha256 !== "" && fileDigest(file.path) === file.sha256) {
        (0, import_node_fs45.rmSync)(file.path, { force: true });
        removed.push(file.path);
      } else {
        preserved.push(file.path);
      }
    }
    for (const permission of installation?.permissionRules ?? []) {
      removePermissionRule(permission, removed, preserved);
    }
    delete manifest.harnesses[harness];
  }
  const currentHarness = readUserHarness(opts.userPathOptions);
  if (currentHarness != null && selected.includes(currentHarness)) {
    const remaining = ["codex", "claude"].find((name) => manifest.harnesses[name] != null);
    if (remaining == null) (0, import_node_fs45.rmSync)(paths.harnessFile, { force: true });
    else (0, import_node_fs45.writeFileSync)(paths.harnessFile, `${remaining}
`, "utf8");
  }
  if (Object.keys(manifest.harnesses).length === 0) {
    (0, import_node_fs45.rmSync)(paths.managedRuntimeDir, { recursive: true, force: true });
    (0, import_node_fs45.rmSync)((0, import_node_path46.join)(paths.dataDir, "runtime.staging"), { recursive: true, force: true });
    (0, import_node_fs45.rmSync)((0, import_node_path46.join)(paths.dataDir, "runtime.old"), { recursive: true, force: true });
    (0, import_node_fs45.rmSync)((0, import_node_path46.join)(paths.dataDir, ".runtime.lock"), { recursive: true, force: true });
    manifest.runtime = null;
  }
  writeInstallationManifest(paths, manifest);
  if (opts.purgeUserData) {
    (0, import_node_fs45.rmSync)(paths.configDir, { recursive: true, force: true });
    (0, import_node_fs45.rmSync)(paths.stateDir, { recursive: true, force: true });
    (0, import_node_fs45.rmSync)(paths.dataDir, { recursive: true, force: true });
    return { harnesses: selected, removed, preserved, purged: true };
  }
  return { harnesses: selected, removed, preserved, purged: false };
}

// src/commands/clean.ts
var import_node_child_process12 = require("node:child_process");
var import_node_fs46 = require("node:fs");
var import_node_path47 = require("node:path");
function runClean(opts = {}) {
  const repoRoot = opts.repoRoot ?? findRepoRoot(opts.cwd ?? process.cwd());
  const candidates = [
    (0, import_node_path47.join)(repoRoot, ".fadeno", "runs"),
    (0, import_node_path47.join)(repoRoot, ".fadeno", "progress"),
    (0, import_node_path47.join)(repoRoot, ".fadeno", "local"),
    (0, import_node_path47.join)(repoRoot, ".fadeno", "dispatches.jsonl")
  ].filter(import_node_fs46.existsSync);
  const retainedShadowWorktrees = listRetainedShadowWorktrees({ repoRoot }).map(
    (w) => (0, import_node_path47.join)(repoRoot, w.workspace)
  );
  const removed = [];
  const deregisteredShadowWorktrees = [];
  if (opts.force) {
    for (const worktree of retainedShadowWorktrees) {
      try {
        const result = (0, import_node_child_process12.spawnSync)("git", ["worktree", "remove", "--force", worktree], {
          cwd: repoRoot,
          encoding: "utf8"
        });
        if (result.status === 0) deregisteredShadowWorktrees.push(worktree);
      } catch {
      }
    }
    try {
      (0, import_node_child_process12.spawnSync)("git", ["worktree", "prune"], { cwd: repoRoot, encoding: "utf8" });
    } catch {
    }
    for (const path of candidates) {
      (0, import_node_fs46.rmSync)(path, { recursive: true, force: true });
      removed.push(path);
    }
  }
  return {
    repoRoot,
    candidates,
    removed,
    dryRun: !opts.force,
    retainedShadowWorktrees,
    deregisteredShadowWorktrees
  };
}

// src/commands/unvendor.ts
var import_node_crypto16 = require("node:crypto");
var import_node_fs47 = require("node:fs");
var import_node_path48 = require("node:path");
var UnvendorError = class extends Error {
};
function digest(path) {
  return (0, import_node_crypto16.createHash)("sha256").update((0, import_node_fs47.readFileSync)(path)).digest("hex");
}
function runUnvendor(opts = {}) {
  const repoRoot = opts.repoRoot ?? findRepoRoot(opts.cwd ?? process.cwd());
  const lockPath = (0, import_node_path48.join)(repoRoot, "fadeno.lock");
  if (!(0, import_node_fs47.existsSync)(lockPath)) throw new UnvendorError("fadeno.lock is missing; refusing an ownership-blind unvendor.");
  const lock = JSON.parse((0, import_node_fs47.readFileSync)(lockPath, "utf8"));
  if (lock.files == null) throw new UnvendorError("fadeno.lock predates managed file ownership; re-run `fadeno vendor --force` first.");
  const removed = [];
  const preserved = [];
  for (const [rel, expected] of Object.entries(lock.files)) {
    const path = (0, import_node_path48.resolve)(repoRoot, rel);
    const back = (0, import_node_path48.relative)(repoRoot, path).split("\\").join("/");
    if (back.startsWith("../") || (0, import_node_path48.isAbsolute)(back) || !(0, import_node_fs47.existsSync)(path)) continue;
    if (opts.force || digest(path) === expected) {
      (0, import_node_fs47.rmSync)(path, { force: true });
      removed.push(path);
    } else preserved.push(path);
  }
  const lockRemoved = preserved.length === 0 || Boolean(opts.force);
  if (lockRemoved) (0, import_node_fs47.rmSync)(lockPath, { force: true });
  return { repoRoot, removed, preserved, lockRemoved };
}

// src/commands/cancel.ts
var import_node_fs48 = require("node:fs");
var import_node_path49 = require("node:path");
var CancelError = class extends Error {
};
function defaultProbe2(pid, signal) {
  process.kill(pid, signal);
}
function parseFilenameForRun(fileName, runId) {
  for (const kind of [`engine-${runId}-`, `tool-${runId}-`]) {
    if (!fileName.startsWith(kind) || !fileName.endsWith(".json")) continue;
    if (fileName.endsWith(".status.json")) return null;
    const withoutSuffix = fileName.slice(0, -".json".length);
    const remainder = withoutSuffix.slice(kind.length);
    const dashA = remainder.lastIndexOf("-a");
    if (dashA <= 0) continue;
    const actorCallId = remainder.slice(0, dashA);
    const attemptRaw = remainder.slice(dashA + 2);
    if (!/^[1-9]\d*$/.test(attemptRaw)) continue;
    const attempt = Number.parseInt(attemptRaw, 10);
    if (!Number.isInteger(attempt) || attempt <= 0) continue;
    if (actorCallId.length === 0) continue;
    return { actorCallId, attempt, prefix: kind.slice(0, -`${runId}-`.length) };
  }
  return null;
}
function runCancel(opts) {
  const query = (opts.run ?? "").trim();
  if (query.length === 0) {
    throw new CancelError("run identifier required for cancel \u2014 provide a run id or unique prefix.");
  }
  const repoRoot = opts.repoRoot ?? findRepoRoot(opts.cwd ?? process.cwd());
  let summary;
  try {
    summary = resolveRun(repoRoot, query);
  } catch (err) {
    throw new CancelError(err.message);
  }
  const runId = summary.runId;
  const inflightDir = (0, import_node_path49.join)(repoRoot, ...INFLIGHT_DIR.split("/"));
  let fileNames = [];
  if ((0, import_node_fs48.existsSync)(inflightDir)) {
    try {
      fileNames = (0, import_node_fs48.readdirSync)(inflightDir);
    } catch {
      fileNames = [];
    }
  }
  const probe2 = opts.probe ?? defaultProbe2;
  const kill = opts.kill ?? ((pid, signal) => {
    process.kill(pid, signal);
  });
  const actorCallFilter = (opts.actorCallId ?? "").trim() || null;
  const aliveMatches = [];
  for (const fileName of fileNames) {
    const parsed = parseFilenameForRun(fileName, runId);
    if (parsed == null) continue;
    if (actorCallFilter != null && parsed.actorCallId !== actorCallFilter) continue;
    const abs = (0, import_node_path49.join)(inflightDir, fileName);
    const claim2 = readInflightClaim(abs, (p) => (0, import_node_fs48.readFileSync)(p, "utf8"));
    if (claim2 == null) continue;
    if (!inflightClaimIsAlive(claim2, probe2)) continue;
    aliveMatches.push({ fileName, claim: claim2, actorCallId: parsed.actorCallId, attempt: parsed.attempt });
  }
  if (aliveMatches.length === 0) {
    if (actorCallFilter != null) {
      throw new CancelError(
        `run "${runId}" has no live claim for actor_call_id "${actorCallFilter}" on this machine \u2014 nothing to cancel. Check the actor_call_id and that the executor is still running.`
      );
    }
    throw new CancelError(
      `run "${runId}" has no live claim on this machine \u2014 nothing to cancel. The run may have no active attempt, or the executor already terminated. Re-run drive to see if there is a dangling attempt whose claim was removed, or inspect the ledger.`
    );
  }
  if (aliveMatches.length > 1 && actorCallFilter == null) {
    const ids = aliveMatches.map((m) => `${m.actorCallId}:a${m.attempt}`).join(", ");
    throw new CancelError(
      `run "${runId}" has multiple live claims (${aliveMatches.length}): ${ids} \u2014 refusing to guess which to cancel. Cancel a single claim by its actor_call_id when this occurs, or wait for one to terminate.`
    );
  }
  const matched = aliveMatches[0];
  const claim = matched.claim;
  const supervisorPid = claim.supervisorPid ?? claim.pid;
  const processGroupId = claim.processGroupId;
  const executorPid = claim.executorPid;
  const alive = (pid) => {
    try {
      probe2(pid, 0);
      return true;
    } catch (err) {
      return err.code !== "ESRCH";
    }
  };
  let targetPid = null;
  let resolvedBy = null;
  if (alive(supervisorPid)) {
    targetPid = supervisorPid;
    resolvedBy = "supervisor";
  } else if (processGroupId != null && alive(-processGroupId)) {
    targetPid = -processGroupId;
    resolvedBy = "process_group";
  } else if (executorPid != null && alive(executorPid)) {
    targetPid = executorPid;
    resolvedBy = "executor";
  }
  if (targetPid == null || resolvedBy == null) {
    throw new CancelError(
      `run "${runId}" has a stale in-flight claim for ${matched.actorCallId}:a${matched.attempt} but no live supervisor or executor group. Nothing was signalled; the claim may need manual inspection or a dead-supervisor recovery path.`
    );
  }
  try {
    kill(targetPid, "SIGTERM");
  } catch (err) {
    throw new CancelError(
      `could not signal the executor for run "${runId}" ${matched.actorCallId}:a${matched.attempt} (pid ${targetPid}): ${err.message}`
    );
  }
  return {
    run: runId,
    actorCallId: matched.actorCallId,
    attempt: matched.attempt,
    supervisorPid,
    processGroupId,
    signalledPid: targetPid,
    resolvedBy
  };
}

