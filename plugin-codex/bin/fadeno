  const agentType = stringField("agent_type");
  const artifactType = event.extra.artifact_type;
  const validationErrors = Array.isArray(event.extra.validation_errors) ? event.extra.validation_errors.filter((error) => typeof error === "string") : void 0;
  const repairAppendix = typeof event.extra.repair_appendix === "string" ? event.extra.repair_appendix : void 0;
