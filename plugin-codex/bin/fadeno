}
function computeResolution(repoRoot, playbookPath, userPathOptions) {
  let profile;
  try {
    const loaded = loadExecutorProfile(repoRoot, userPathOptions);
    profile = loaded.profile;
  } catch (err) {
    if (err instanceof ExecutorProfileError) return null;
    throw err;
  }
  let dialLayers;
  try {
    const state = readLocalDialState(repoRoot);
    const userRaw = readUserDials(userPathOptions ?? {});
    const user = {};
    for (const [k, v] of Object.entries(userRaw)) user[k] = v;
    dialLayers = { session: state.dials, repo: { ...profile.dials }, user };
    try {
      const live = loadExecutorProfile(repoRoot, userPathOptions).profile;
      if (Object.keys(live.dials).length > 0) dialLayers.repo = { ...live.dials };
    } catch {
    }
  } catch (err) {
    if (err instanceof ExecutorProfileError) return null;
    throw err;
  }
  let playbookDoc;
  try {
    playbookDoc = (0, import_yaml13.parse)((0, import_node_fs29.readFileSync)(playbookPath, "utf8"));
  } catch {
    return null;
  }
  const rolesRaw = playbookDoc != null && typeof playbookDoc === "object" && !Array.isArray(playbookDoc) ? playbookDoc.roles : null;
  const roleNames = rolesRaw != null && typeof rolesRaw === "object" && !Array.isArray(rolesRaw) ? Object.keys(rolesRaw) : [];
  const roles = [];
  const echo = [];
  for (const role of roleNames) {
    const archetype = roleArchetype(playbookDoc, role);
    try {
      const cascade = resolveDialCascade(role, archetype, { bindings: profile.bindings, archetypes: profile.archetypes }, dialLayers);
      const refString = formatDialRef(cascade.ref);
      let model = null;
      try {
        const compiled = compileDialRef(cascade.ref, profile);
        model = compiled.model;
      } catch {
        model = null;
      }
      roles.push({ role, archetype, executor: refString, model, source: cascade.source, error: null });
      const label = roleResolutionEchoLabel(cascade.source);
      echo.push(`${role} \u2192 ${refString}${model != null ? ` (${model})` : ""} [${label}]`);
    } catch (err) {
      if (!(err instanceof ExecutorProfileError)) throw err;
      roles.push({ role, archetype, executor: null, model: null, source: null, error: err.message });
      echo.push(`${role} \u2192 (unresolved)`);
    }
  }
  return { loadout: null, roles, echo, dialLayers };
}
function runNewRun(opts) {
  const cwd = opts.cwd ?? process.cwd();
  const repoRoot = opts.repoRoot ?? findRepoRoot(cwd);
  const fadenoDir = (0, import_node_path29.join)(repoRoot, ".fadeno");
  ensureFadenoIgnore(repoRoot);
  const resolved = resolvePlaybookFile(repoRoot, opts.playbook);
  if (resolved == null) {
    throw new NewRunError(`Playbook "${opts.playbook.replace(/\.ya?ml$/i, "")}" not found in bundled or project definitions.`);
  }
  const playbook = opts.playbook.replace(/\.ya?ml$/i, "");
  const playbookPath = resolved.path;
  const declared = readDeclaredInputs(playbookPath);
  const supplied = parseInputArgs(opts.inputs ?? opts.input);
  validateInputSources(repoRoot, declared, supplied);
  const now = opts.now ?? /* @__PURE__ */ new Date();
  const iso = now.toISOString();
  const pad = (n) => String(n).padStart(2, "0");
  const datePart = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  const timePart = `${pad(now.getHours())}${pad(now.getMinutes())}`;
  const slug = slugify(opts.task);
  const runsDir = (0, import_node_path29.join)(fadenoDir, "runs");
  let runId = `${datePart}-${timePart}-${slug}`;
  let runDir = (0, import_node_path29.join)(runsDir, runId);
  for (let n = 2; (0, import_node_fs29.existsSync)(runDir); n += 1) {
    runId = `${datePart}-${timePart}-${slug}-${n}`;
    runDir = (0, import_node_path29.join)(runsDir, runId);
  }
  (0, import_node_fs29.mkdirSync)((0, import_node_path29.join)(runDir, "artifacts"), { recursive: true });
  const definitionsDir = (0, import_node_path29.join)(runDir, "definitions");
  const snapshotPlaybook = (0, import_node_path29.join)(definitionsDir, "playbook.yaml");
  (0, import_node_fs29.mkdirSync)((0, import_node_path29.join)(definitionsDir, "schemas"), { recursive: true });
  (0, import_node_fs29.copyFileSync)(playbookPath, snapshotPlaybook);
  for (const schemaName of ["playbook.schema.json", "run.schema.json", "review-report.schema.json", "test-result.schema.json"]) {
    const schema = resolveDefinition(repoRoot, "schema", schemaName);
    if (schema != null) (0, import_node_fs29.copyFileSync)(schema.path, (0, import_node_path29.join)(definitionsDir, "schemas", schemaName));
  }
  const playbookSha256 = sha256Hex((0, import_node_fs29.readFileSync)(snapshotPlaybook));
  const runDocument = {
    run_id: runId,
    schema_version: RUN_LEDGER_SCHEMA_VERSION,
    playbook,
    playbook_snapshot: "definitions/playbook.yaml",
    playbook_sha256: playbookSha256,
    status: "running",
    task: opts.task,
    started_at: iso,
    host: opts.host ?? "cli",
    artifacts_dir: "artifacts",
    current_step: null
  };
  writeRunDocument(runDir, runDocument);
  new LedgerWriter(runDir).append({ type: "run_started", step: null }, now);
  (0, import_node_fs29.writeFileSync)((0, import_node_path29.join)(runDir, "artifacts", ".gitkeep"), "", "utf8");
  const recordedInputs = recordDeclaredInputs(runDir, repoRoot, declared, supplied, now);
  const resolution = computeResolution(repoRoot, playbookPath, opts.userPathOptions);
  return { runId, runDir, playbook, inputs: recordedInputs, resolution };
}

// src/commands/next.ts
var import_node_fs30 = require("node:fs");
var import_node_path30 = require("node:path");
var import_yaml14 = __toESM(require_dist(), 1);
var NextError = class extends Error {
};
function locatePlaybook3(runDir, repoRoot, name) {
  const found = resolveRunPlaybookFile(runDir, repoRoot, name);
  if (found) return found.path;
  throw new NextError(`Playbook "${name}" not found in bundled or project definitions.`);
}
function runNext(opts) {
  const cwd = opts.cwd ?? process.cwd();
  const repoRoot = opts.repoRoot ?? findRepoRoot(cwd);
  let run;
  try {
    run = resolveRun(repoRoot, opts.run);
  } catch (err) {
    if (err instanceof RunLedgerError) throw new NextError(err.message);
    throw err;
  }
  if (run.playbook == null) {
    throw new NextError(`run "${run.runId}" has no playbook recorded in run.yaml.`);
  }
  let mode;
  try {
    mode = ledgerMode(run, opts.legacy === true);
  } catch (err) {
    if (err instanceof RunLedgerError) throw new NextError(err.message);
    throw err;
  }
  if (run.status != null && run.status !== "running") {
    return {
      run: run.runId,
      playbook: run.playbook,
      status: "terminal",
      step: null,
      gate: null,
      human_gate: null,
      terminal: { status: run.status, step: null },
      advice: `run is terminal (${run.status}); return the final summary.`
    };
  }
  let events;
  try {
    events = readEventsStrict(run.dir);
  } catch (err) {
    if (err instanceof RunLedgerError) throw new NextError(err.message);
    throw err;
  }
  if (mode !== "current") events = normalizeLegacyEvents(events);
  const playbookPath = locatePlaybook3(run.dir, repoRoot, run.playbook);
  let playbook;
  try {
    const parsed = (0, import_yaml14.parse)((0, import_node_fs30.readFileSync)(playbookPath, "utf8"));
    if (parsed == null || typeof parsed !== "object" || Array.isArray(parsed)) {
      throw new Error("playbook is not a mapping");
    }
    playbook = parsed;
  } catch (err) {
    throw new NextError(`could not parse playbook ${run.playbook}: ${err.message}`);
  }
  const schemaPaths = runSchemaDirectories(run.dir, repoRoot);
  const schemas = new SchemaSet(schemaPaths.snapshot, schemaPaths.project, schemaPaths.builtin);
  const validation = validateFile(playbookPath, schemas, "playbook");
  const errorIssues = validation.issues.filter((issue) => issue.severity === "error");
  if (errorIssues.length > 0) {
    const detail2 = errorIssues.map((issue) => `${issue.path || "/"}: ${issue.message}`).join("; ");
    throw new NextError(`playbook ${run.playbook} is invalid; fix it before asking for the next step: ${detail2}`);
  }
  let computation;
  try {
    computation = computeNext(playbook, events);
  } catch (err) {
    if (err instanceof FlowCursorError) throw new NextError(err.message);
    throw err;
  }
  if (computation.status === "ready" && computation.step?.kind === "tool_call") {
    const step = computation.step;
    const toolName = step.tool;
    const artifactType = step.artifact_type;
    const outputPath = step.outputs?.[0] ?? null;
    if (toolName && artifactType === "test-result" && outputPath) {
      let isRegistered = false;
      try {
        const snapshotPath = (0, import_node_path30.join)(run.dir, "profile.yaml");
        if ((0, import_node_fs30.existsSync)(snapshotPath)) {
          const snapText = (0, import_node_fs30.readFileSync)(snapshotPath, "utf8");
          const snap = parseSnapshotDocument(snapText, "profile.yaml");
          isRegistered = Object.hasOwn(snap.tools, toolName);
        } else {
          try {
            const live = loadExecutorProfile(repoRoot).profile;
            isRegistered = Object.hasOwn(live.tools, toolName);
          } catch {
          }
        }
      } catch {
      }
      if (isRegistered) {
        computation.advice = `tool "${toolName}" is registered \u2014 run \`fadeno tool-run ${run.runId} --tool ${toolName}\` to execute (writes ${outputPath}, validates test-result, synthesizes status); or manually \`fadeno tool-complete ${run.runId} --output ${outputPath}\` (Diff/PostResult remain manual).`;
      } else {
        computation.advice = `tool "${toolName}" is not registered (produces ${artifactType}, planned artifact ${outputPath}) \u2014 automated tool-run is only for registered test-result tools; use manual \`fadeno tool-complete ${run.runId} --output ${outputPath}\` (no execution).`;
      }
    } else if (step.tool) {
      const outputPath2 = step.outputs?.[0] ?? "the planned artifact";
      computation.advice = `tool "${step.tool}" produces ${artifactType ?? "unknown"} \u2014 automated execution only supports test-result; save structured result at ${outputPath2} then \`fadeno tool-complete ${run.runId} --output ${outputPath2}\`.`;
    }
  }
  return {
    run: run.runId,
    playbook: typeof playbook.name === "string" ? playbook.name : run.playbook,
    ...computation
  };
}

