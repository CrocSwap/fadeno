        const relayModel = relayModelForClaude((0, import_node_path27.join)(repoRoot, ".fadeno", "executors.yaml"));
        for (const file of (0, import_node_fs27.readdirSync)(agentsSrc).sort()) {
          const dest = (0, import_node_path27.join)(repoRoot, ".claude", "agents", file);
          const body = stampRelayModel((0, import_node_fs27.readFileSync)((0, import_node_path27.join)(agentsSrc, file), "utf8"), relayModel);
          results.push({ path: dest, status: emitFile(dest, body, force) });
        }
        break;
      }
      case "grok":
        copyTree((0, import_node_path27.join)(tpl, "grok", "grok-agents"), (0, import_node_path27.join)(repoRoot, ".grok", "agents"), force, results);
