  }
  return owners;
}
function findStep(flow, id) {
  return flow.find((step) => step.id === id);
}
function expandOutputPath(spec, member, iteration) {
  let template;
  if (typeof spec === "string") {
    template = spec;
  } else {
    if (member == null || typeof spec[member] !== "string") {
      throw new PromptResolveError(`output_path map has no entry for member "${member ?? "(none)"}".`);
    }
    template = spec[member];
  }
  let out = template;
  if (member != null) out = out.split("{actor}").join(member);
  if (iteration != null) out = out.split("{iteration}").join(String(iteration + 1));
  return out;
}
function withGeneration(path, iteration) {
  const generation = iteration + 1;
  const dot = path.lastIndexOf(".");
  const slash = path.lastIndexOf("/");
  if (dot > slash) return `${path.slice(0, dot)}.v${generation}${path.slice(dot)}`;
  return `${path}.v${generation}`;
}
function parseGeneration(path) {
  const slash = path.lastIndexOf("/");
  const dir = path.slice(0, slash + 1);
  const base = path.slice(slash + 1);
  const match = base.match(/^(.*)\.v(\d+)((?:\.[^.]*)*)$/);
  if (!match) return { logicalPath: path, generation: 1 };
  return { logicalPath: `${dir}${match[1]}${match[3] ?? ""}`, generation: Number(match[2]) };
}
function templateMatches(template, member, path) {
  const pattern = template.split(/(\{actor\}|\{iteration\})/).map((part) => part === "{actor}" ? escapeRegExp(member) : part === "{iteration}" ? "\\d+" : escapeRegExp(part)).join("");
  return new RegExp(`^${pattern}$`).test(path);
}
function attributeToMember(producer, path) {
  const spec = producer.output_path;
  if (spec == null) return null;
  if (typeof spec === "object" && !Array.isArray(spec)) {
    for (const [member, template] of Object.entries(spec)) {
      if (typeof template === "string" && templateMatches(template, member, path)) return member;
    }
    return null;
  }
  if (typeof spec === "string") {
    for (const member of asStringArray(producer.over)) {
      if (templateMatches(spec, member, path)) return member;
    }
  }
  return null;
}
function schemaKindFor(base) {
  if (base === "ReviewReport") return "review-report";
  if (base === "TestResult") return "test-result";
  return null;
}
function baseArtifactName(name) {
  return name.replace(/\[\]$/, "");
}
function resolveInput(inputType, flow, events, cutoff, actor) {
  const base = baseArtifact2(inputType);
  const producerIds = new Set(
    flow.filter((step) => typeof step.output === "string" && baseArtifact2(step.output) === base).map((step) => step.id)
  );
  const candidates = [];
  for (let i = 0; i < cutoff; i += 1) {
    const event = events[i];
    if (!ARTIFACT_EVENT_TYPES.has(event.type)) continue;
    const declaredInput = event.step == null && (event.extra.input_name === inputType || event.extra.input === inputType || event.extra.logical_name === inputType);
    if (!declaredInput && (event.step == null || !producerIds.has(event.step))) continue;
    const path = event.extra.artifact;
    if (typeof path !== "string") continue;
    const memberField = typeof event.extra.member === "string" ? event.extra.member : null;
    const producer = event.step == null ? void 0 : findStep(flow, event.step);
    const member = memberField ?? (producer ? attributeToMember(producer, path) : null);
    candidates.push({ index: i, path, producer: event.step ?? "(declared input)", member });
  }
  const byMember = /* @__PURE__ */ new Map();
  const unattributed = [];
  let aggregate = null;
  for (const candidate of candidates) {
    if (candidate.member != null) {
      const prior = byMember.get(candidate.member);
      if (!prior || candidate.index > prior.index) byMember.set(candidate.member, candidate);
      continue;
    }
    const producer = candidate.producer === "(declared input)" ? void 0 : findStep(flow, candidate.producer);
    const attributesByMember = producer != null && producer.output_path != null && asStringArray(producer.over).length > 0;
    if (attributesByMember) {
      if (!aggregate || candidate.index > aggregate.index) aggregate = candidate;
    } else {
      unattributed.push(candidate);
    }
  }
  const memberEntries = [...byMember.entries()];
  const overOrder = memberEntries.length > 0 ? asStringArray(findStep(flow, memberEntries[0][1].producer)?.over) : [];
  memberEntries.sort((a, b) => {
    const ai = overOrder.indexOf(a[0]);
    const bi = overOrder.indexOf(b[0]);
    if (ai !== -1 && bi !== -1) return ai - bi;
    return a[1].index - b[1].index;
  });
  const files = [];
  for (const [member, event] of memberEntries) {
    files.push({ path: event.path, byActor: member, isSelf: member === actor });
  }
  for (const event of unattributed.sort((a, b) => a.index - b.index)) {
    files.push({ path: event.path, byActor: null, isSelf: false });
  }
  const all = [...byMember.values(), ...unattributed, ...aggregate ? [aggregate] : []];
  let producedBy = null;
  let invocation = null;
  if (all.length > 0) {
    const last = all.reduce((a, b) => a.index >= b.index ? a : b);
    producedBy = last.producer === "(declared input)" ? null : last.producer;
    let count = 0;
    for (let i = 0; i < cutoff; i += 1) {
      if (producedBy != null && events[i].type === "step_started" && events[i].step === producedBy) count += 1;
    }
    invocation = count > 0 ? count : null;
  }
  return {
    artifact: inputType,
    producedBy,
    invocation,
    files,
    isAssembledAggregate: aggregate != null,
    aggregatePath: aggregate ? aggregate.path : null
  };
}
function boundInputNames(step, actor) {
  if (actor == null || !step.input_bindings || typeof step.input_bindings !== "object" || Array.isArray(step.input_bindings)) {
    return null;
  }
  const binding = step.input_bindings[actor];
  if (binding == null || typeof binding !== "object" || Array.isArray(binding)) return null;
  const result = /* @__PURE__ */ new Set();
  for (const bucket of ["primary", "context"]) {
    const values = binding[bucket];
    if (Array.isArray(values)) {
      for (const value of values) if (typeof value === "string") result.add(value);
    }
  }
  return result;
}
function resolveStepPlan(playbook, events, sel) {
  const flow = asFlow(playbook.flow);
  const step = findStep(flow, sel.step);
  if (!step) {
    const ids = flow.map((s) => typeof s.id === "string" ? s.id : "?").join(", ");
    throw new PromptResolveError(`step "${sel.step}" not found. Steps: ${ids}`);
  }
  const kind = typeof step.kind === "string" ? step.kind : "unknown";
  guardKind(step, kind, sel.step);
  const isMap = kind === "map";
  let overMembers = [];
  if (isMap) {
    if (typeof step.over === "string") {
      throw new PromptResolveError(`step "${sel.step}" maps over an artifact field ("${step.over}"); artifact-field maps are not promptable in v1.`);
    }
    overMembers = asStringArray(step.over);
    if (overMembers.length === 0) {
      throw new PromptResolveError(`step "${sel.step}" has no literal \`over\` role list; not promptable in v1.`);
    }
  }
  const { actor, otherMembers } = resolveActor(step, sel, isMap, overMembers);
  const owners = loopBodyOwners(flow);
  const loopOwner = typeof step.id === "string" ? owners.get(step.id) ?? null : null;
  const isBody = loopOwner != null;
  if (!isBody && sel.iteration != null) {
    throw new PromptResolveError(`--iteration is only valid on loop-body steps; "${sel.step}" is not one.`);
  }
  let iteration = null;
  let maxIterations = null;
  let iterationStarts = [];
  if (isBody) {
    const loopStep = findStep(flow, loopOwner);
    maxIterations = loopStep && typeof loopStep.max_iterations === "number" ? loopStep.max_iterations : null;
    iterationStarts = events.reduce((acc, event, index) => {
      if (event.type === "loop_iteration_started" && event.step === loopOwner) acc.push(index);
      return acc;
    }, []);
    if (iterationStarts.length === 0) {
      throw new PromptResolveError(`loop "${loopOwner}" has no recorded loop_iteration_started; cannot resolve an iteration for "${sel.step}".`);
    }
    iterationStarts.forEach((index, ordinal) => {
      const declared = events[index].extra.iteration;
      if (typeof declared === "number" && declared !== ordinal + 1) {
        throw new PromptResolveError(`loop_iteration_started #${ordinal + 1} for "${loopOwner}" records iteration ${declared}, which does not match its ordinal ${ordinal + 1}.`);
      }
    });
    const wanted = sel.iteration ?? iterationStarts.length;
    if (wanted < 1 || wanted > iterationStarts.length) {
      throw new PromptResolveError(`--iteration ${wanted} is out of range for "${sel.step}"; loop "${loopOwner}" has ${iterationStarts.length} recorded iteration(s).`);
    }
    iteration = wanted;
  }
  let spanStart = 0;
  let spanEnd = events.length;
  if (isBody && iteration != null) {
    spanStart = iterationStarts[iteration - 1];
    spanEnd = iteration < iterationStarts.length ? iterationStarts[iteration] : events.length;
  }
  const stepStarts = [];
  for (let i = spanStart; i < spanEnd; i += 1) {
    if (events[i].type === "step_started" && events[i].step === sel.step) stepStarts.push(i);
  }
  let invocation;
  let cutoffIndex;
  if (stepStarts.length === 0) {
    invocation = 1;
    cutoffIndex = null;
  } else {
    invocation = stepStarts.length;
    cutoffIndex = stepStarts[stepStarts.length - 1];
  }
  const inputCutoff = cutoffIndex ?? spanEnd;
  const allowed = boundInputNames(step, actor);
  const inputs = asStringArray(step.input).filter((type) => allowed == null || allowed.has(type)).map((type) => resolveInput(type, flow, events, inputCutoff, actor));
  const output = planOutput(playbook, step, sel.step, kind, isMap, actor, iteration, isBody);
  const downstream = resolveDownstream(flow, output.collectiveType);
  const purpose = resolvePurpose(playbook, actor);
  const rejection = resolveRejectionContext(flow, events, sel.step, inputCutoff);
  return {
    kind,
    actor,
    iteration,
    maxIterations,
    invocation,
    cutoffLine: cutoffIndex == null ? null : cutoffIndex + 1,
    inputs,
    output,
    downstream,
    otherMembers,
    loopOwner,
    purpose,
    rejection
  };
}
function asFlow(flow) {
  return Array.isArray(flow) ? flow : [];
}
function guardKind(step, kind, stepId) {
  if (kind === "gate") {
    throw new PromptResolveError(`step "${stepId}" is a gate; evaluate it with \`fadeno gate <run> <condition> --artifact <path>\`, not \`fadeno prompt\`.`);
  }
  if (kind === "human_gate") {
    const question = typeof step.prompt === "string" ? step.prompt.trim().replace(/\s+/g, " ") : "(no prompt declared)";
    throw new PromptResolveError(`step "${stepId}" is a human_gate; ask the user directly: ${question}`);
  }
  if (kind === "loop") {
    const body = asStringArray(step.body).join(", ");
    throw new PromptResolveError(`step "${stepId}" is a loop; prompt one of its body steps: ${body}`);
  }
  if (NOT_PROMPTABLE.has(kind)) {
    throw new PromptResolveError(`step "${stepId}" (kind ${kind}) is not promptable in v1.`);
  }
}
function resolveActor(step, sel, isMap, overMembers) {
  if (isMap) {
    if (sel.actor == null) {
      throw new PromptResolveError(`step "${sel.step}" maps over roles; pass --actor ${overMembers.join("|")}.`);
    }
    if (!overMembers.includes(sel.actor)) {
      throw new PromptResolveError(`unknown --actor "${sel.actor}" for step "${sel.step}"; valid members: ${overMembers.join(", ")}.`);
    }
    return { actor: sel.actor, otherMembers: overMembers.filter((member) => member !== sel.actor) };
  }
  const declared = typeof step.actor === "string" ? step.actor : null;
  if (sel.actor != null && sel.actor !== declared) {
    throw new PromptResolveError(`unknown --actor "${sel.actor}" for step "${sel.step}"; valid actor: ${declared ?? "(none)"}.`);
  }
  return { actor: declared, otherMembers: [] };
}
function planOutput(playbook, step, stepId, kind, isMap, actor, iteration, isBody) {
  const collectiveType = typeof step.output === "string" ? step.output : "";
  const base = baseArtifact2(collectiveType);
  const schemaKind = schemaKindFor(base);
  const memberType = isMap ? base : collectiveType;
  let path;
  const spec = step.output_path;
  if (spec != null && (typeof spec === "string" || typeof spec === "object" && !Array.isArray(spec))) {
    path = expandOutputPath(spec, actor, iteration);
  } else if (isMap) {
    if (schemaKind) {
      path = `artifacts/parts/${stepId}/${actor ?? "member"}.json`;
      if (isBody && iteration != null) path = withGeneration(path, iteration);
    } else {
      throw new PromptResolveError(`step "${stepId}" maps an untyped output ("${collectiveType || "unnamed"}") with no output_path; declare output_path so each member's file is unambiguous.`);
    }
  } else {
    if (schemaKind === "review-report") path = "artifacts/review-report.json";
    else if (schemaKind === "test-result") path = "artifacts/test-result.json";
    else path = `artifacts/${kebab(base) || kebab(kind)}.md`;
    if (isBody && iteration != null) path = withGeneration(path, iteration);
  }
  const contract = resolveContract(playbook, base);
  const mediaType = schemaKind ? "application/json" : contract && typeof contract.media_type === "string" ? contract.media_type : "text/markdown";
  const instructions = contract && typeof contract.instructions === "string" ? contract.instructions : null;
  return { path, mediaType, schemaKind, instructions, collectiveType, memberType, isMap };
}
function tryPlanOutput(playbook, step, stepId, kind, isMap, actor, iteration, isBody) {
  try {
    return planOutput(playbook, step, stepId, kind, isMap, actor, iteration, isBody);
  } catch (err) {
    if (err instanceof PromptResolveError) return null;
    throw err;
  }
}
function planMapMemberOutputs(playbook, step, members, iteration, isBody) {
  const stepId = typeof step.id === "string" ? step.id : "";
  const kind = typeof step.kind === "string" ? step.kind : "map";
  const planned = [];
  for (const member of members) {
    const one = tryPlanOutput(playbook, step, stepId, kind, true, member, iteration, isBody);
    if (one == null) return null;
    planned.push(one);
  }
  return planned;
}
function resolveContract(playbook, base) {
  const contracts = playbook.artifact_contracts;
  if (!contracts || typeof contracts !== "object" || Array.isArray(contracts)) return null;
  const contract = contracts[base];
  return contract && typeof contract === "object" && !Array.isArray(contract) ? contract : null;
}
function resolveDownstream(flow, collectiveType) {
  const base = baseArtifact2(collectiveType);
  if (!base) return null;
  const consumes = (step) => asStringArray(step.input).some((type) => baseArtifact2(type) === base);
  for (const step of flow) {
    if (step.kind === "gate" && typeof step.condition === "string" && consumes(step)) {
      return { gateStep: step.id, condition: step.condition };
    }
  }
  for (const step of flow) {
    if (step.kind === "loop" && typeof step.until === "string" && consumes(step)) {
      return { gateStep: step.id, condition: step.until };
    }
  }
  return null;
}
function planCollectivePath(flow, step, memberPaths, members, iteration, isBody) {
  const collectiveType = typeof step.output === "string" ? step.output : "";
  if (!collectiveType.endsWith("[]")) return null;
  if (resolveDownstream(flow, collectiveType) == null) return null;
  if (memberPaths.length > 0 && members.length > 0) {
    const first = memberPaths[0];
    const member = members[0];
    for (const sep4 of [`.${member}`, `/${member}`, `-${member}`]) {
      if (first.includes(sep4)) {
        let stem = first.split(sep4).join("");
        if (isBody && iteration != null && !/\.v\d+(\.|$)/.test(stem)) {
          stem = withGeneration(stem, iteration);
        }
        return stem;
      }
    }
  }
  const base = baseArtifact2(collectiveType);
  const schema = schemaKindFor(base);
  let path;
  if (schema === "review-report") path = "artifacts/review-report.json";
  else if (schema === "test-result") path = "artifacts/test-result.json";
  else path = `artifacts/${typeof step.id === "string" ? step.id : "collective"}.json`;
  if (isBody && iteration != null) path = withGeneration(path, iteration);
  return path;
}
function resolvePurpose(playbook, actor) {
  if (actor == null) return null;
  const roles = playbook.roles;
  if (!roles || typeof roles !== "object" || Array.isArray(roles)) return null;
  const role = roles[actor];
  if (!role || typeof role !== "object") return null;
  const purpose = role.purpose;
  return typeof purpose === "string" ? purpose : null;
}
function resolveRejectionContext(flow, events, stepId, inputCutoff) {
  const rejectingGates = flow.filter(
    (step) => step.kind === "human_gate" && typeof step.id === "string" && step.on_reject === stepId
  );
  if (rejectingGates.length === 0) return null;
  const gateIds = new Set(rejectingGates.map((s) => s.id));
  for (let i = inputCutoff - 1; i >= 0; i -= 1) {
    const event = events[i];
    if (event.type === "decision_resolved" && typeof event.step === "string" && gateIds.has(event.step)) {
      const option = typeof event.extra.option === "string" ? event.extra.option : null;
      if (option !== "reject") continue;
      return {
        gateStep: event.step,
        decisionId: typeof event.extra.decision_id === "string" ? event.extra.decision_id : null,
        resolvedBy: typeof event.extra.resolved_by === "string" ? event.extra.resolved_by : null,
        feedback: typeof event.extra.feedback === "string" ? event.extra.feedback : null
      };
    }
    if (event.type === "human_decision" && typeof event.step === "string" && gateIds.has(event.step)) {
      const decision = event.extra.decision;
      const branch = typeof event.extra.branch === "string" ? event.extra.branch : null;
      const isReject = decision === "reject" || branch === "reject" || branch === "on_reject";
      if (!isReject) continue;
      return {
        gateStep: event.step,
        decisionId: typeof event.extra.decision_id === "string" ? event.extra.decision_id : null,
        resolvedBy: typeof event.extra.resolved_by === "string" ? event.extra.resolved_by : null,
        feedback: typeof event.extra.feedback === "string" ? event.extra.feedback : null
      };
    }
  }
  return null;
}

// src/lib/artifact-manifest.ts
var ManifestError = class extends Error {
};
function sha256Hex(data) {
  return (0, import_node_crypto2.createHash)("sha256").update(data).digest("hex");
}
var MEDIA_TYPES = {
  ".json": "application/json",
  ".jsonl": "application/jsonl",
  ".md": "text/markdown",
  ".txt": "text/plain",
  ".yaml": "application/yaml",
  ".yml": "application/yaml"
};
function mediaTypeFor(path) {
  return MEDIA_TYPES[(0, import_node_path6.extname)(path).toLowerCase()] ?? "application/octet-stream";
}
function buildArtifactManifest(runDir, artifactRel, artifactId, schemas) {
  const abs = (0, import_node_path6.join)(runDir, artifactRel);
  if (!(0, import_node_fs6.existsSync)(abs)) {
    throw new ManifestError(
      `no file at ${artifactRel} under the run directory; write the artifact before recording it.`
    );
  }
  const bytes = (0, import_node_fs6.readFileSync)(abs);
  const { logicalPath, generation } = parseGeneration(artifactRel);
  const mediaType = mediaTypeFor(artifactRel);
  let validation = { schema: null };
  if (mediaType === "application/json" && schemas != null) {
    let parsed;
    let parseOk = true;
    try {
      parsed = JSON.parse(bytes.toString("utf8"));
    } catch {
      parseOk = false;
    }
    if (parseOk) {
      const kind = detectKind(abs, parsed);
      if ((kind === "review-report" || kind === "test-result") && schemas.has(kind)) {
        const validate = schemas.get(kind);
        validation = validate(parsed) ? { schema: kind, ok: true } : { schema: kind, ok: false, errors: schemaErrorMessages(validate) };
      }
    }
  }
  return {
    artifact_id: artifactId,
    artifact: artifactRel,
    logical_name: logicalPath,
    generation,
    bytes: bytes.length,
    sha256: sha256Hex(bytes),
    media_type: mediaType,
    validation
  };
}
function resolveActiveArtifacts(events) {
  const superseded = /* @__PURE__ */ new Set();
  for (const event of events) {
    if (event.type === "artifact_superseded" && typeof event.extra.artifact === "string") {
      superseded.add(event.extra.artifact);
    }
  }
  const records = [];
  events.forEach((event, index) => {
    if (event.type !== "artifact_created") return;
    const path = typeof event.extra.artifact === "string" ? event.extra.artifact : null;
    if (path == null) return;
    const parsed = parseGeneration(path);
    const validation = event.extra.validation;
    const valid = !superseded.has(path) && !(validation !== null && typeof validation === "object" && validation.ok === false);
    records.push({
      artifactId: typeof event.extra.artifact_id === "string" ? event.extra.artifact_id : null,
      path,
      logicalName: typeof event.extra.logical_name === "string" ? event.extra.logical_name : parsed.logicalPath,
      member: typeof event.extra.member === "string" ? event.extra.member : null,
      generation: typeof event.extra.generation === "number" ? event.extra.generation : parsed.generation,
      seq: event.seq,
      sha256: typeof event.extra.sha256 === "string" ? event.extra.sha256 : null,
      bytes: typeof event.extra.bytes === "number" ? event.extra.bytes : null,
      valid,
      index
    });
  });
  const shaByPath = /* @__PURE__ */ new Map();
  for (const record2 of records) {
    if (record2.sha256 == null) continue;
    const set = shaByPath.get(record2.path) ?? /* @__PURE__ */ new Set();
    set.add(record2.sha256);
    shaByPath.set(record2.path, set);
  }
  const immutabilityViolations = [...shaByPath.entries()].filter(([, shas]) => shas.size > 1).map(([path, shas]) => `${path} recorded with ${shas.size} different sha256 values`);
  const groups = /* @__PURE__ */ new Map();
  for (const record2 of records) {
    const key = `${record2.logicalName}\0${record2.member ?? ""}`;
    const group = groups.get(key);
    if (group) group.push(record2);
    else groups.set(key, [record2]);
  }
  const active = [];
  const conflicts = [];
  for (const group of groups.values()) {
    const valid = group.filter((record2) => record2.valid);
    if (valid.length === 0) continue;
    const maxGeneration = Math.max(...valid.map((record2) => record2.generation));
    const top = valid.filter((record2) => record2.generation === maxGeneration);
    const distinctPaths = [...new Set(top.map((record2) => record2.path))];
    if (distinctPaths.length > 1) {
      const sample = top[0];
      const scope = sample.member != null ? `${sample.logicalName} (member ${sample.member})` : sample.logicalName;
      conflicts.push(
        `${scope} has ${distinctPaths.length} paths at generation ${maxGeneration}: ${distinctPaths.join(", ")}`
      );
    }
    const winner = top.reduce((a, b) => b.index >= a.index ? b : a);
    active.push({
      artifactId: winner.artifactId,
      path: winner.path,
      logicalName: winner.logicalName,
      member: winner.member,
      generation: winner.generation,
      seq: winner.seq,
      sha256: winner.sha256,
      bytes: winner.bytes
    });
  }
  active.sort(
    (a, b) => a.logicalName < b.logicalName ? -1 : a.logicalName > b.logicalName ? 1 : (a.member ?? "") < (b.member ?? "") ? -1 : 1
  );
  return { active, conflicts, immutabilityViolations };
}

// src/lib/constraints.ts
var import_node_child_process = require("node:child_process");
var ConstraintError = class extends Error {
};
var REFUSED_NO_STDERR = "constraint command refused the dispatch (no reason on stderr)";
function commandLabel(command2) {
  return JSON.stringify(command2);
}
function evaluateConstraint(profile, context, opts) {
  if (profile.constraints == null) return { verdict: "allowed" };
  const command2 = profile.constraints.command;
  const bin = command2[0];
  if (typeof bin !== "string" || bin.length === 0) {
    throw new ConstraintError(`constraint command ${commandLabel(command2)} is missing or empty`);
  }
  const spawn4 = opts.spawn ?? import_node_child_process.spawnSync;
  let result;
  try {
    result = spawn4(bin, command2.slice(1), {
      cwd: opts.cwd,
      env: atCwd(process.env, opts.cwd),
      input: JSON.stringify(context),
      encoding: "utf8"
    });
  } catch (err) {
    throw new ConstraintError(
      `constraint command ${commandLabel(command2)} failed to spawn: ${err.message}`
    );
  }
  if (result.error != null) {
    throw new ConstraintError(
      `constraint command ${commandLabel(command2)} failed to spawn: ${result.error.message}`
    );
  }
  if (result.signal != null) {
    throw new ConstraintError(
      `constraint command ${commandLabel(command2)} terminated by signal ${result.signal}`
    );
  }
  if (result.status === 0) return { verdict: "allowed" };
  if (result.status === 2) {
    const stderr = result.stderr == null ? "" : String(result.stderr).trim();
    return { verdict: "refused", reason: stderr.length > 0 ? stderr : REFUSED_NO_STDERR };
  }
  throw new ConstraintError(
    `constraint command ${commandLabel(command2)} exited ${result.status ?? "?"}`
  );
}

