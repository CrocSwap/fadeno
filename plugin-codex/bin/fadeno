        const policyPath = (0, import_node_path27.join)(skillDest, "agents", "openai.yaml");
        results.push({ path: policyPath, status: emitFile(policyPath, policy, force) });
      }
    }
    switch (opts.target) {
      case "codex":
        if (withSteering) {
          results.push(...emitCodexSteeringBrokers({ repoRoot, force }));
        } else {
          copyTree((0, import_node_path27.join)(tpl, "codex", "codex-agents"), (0, import_node_path27.join)(repoRoot, ".codex", "agents"), force, results);
        }
        break;
      case "claude": {
