  if (doc == null || typeof doc !== "object" || Array.isArray(doc)) return {};
  const out = {};
  for (const [k, v] of Object.entries(doc)) {
    if (typeof v === "string") {
      const trimmed = v.trim();
      if (trimmed.length === 0) continue;
      let via;
      let core = trimmed;
      const viaIdx = trimmed.indexOf(" via ");
      if (viaIdx >= 0) {
        core = trimmed.slice(0, viaIdx).trim();
        via = trimmed.slice(viaIdx + 5).trim();
      }
      const atIdx = core.indexOf("@");
      if (atIdx >= 0) {
        const model = core.slice(0, atIdx).trim();
        const effort = core.slice(atIdx + 1).trim();
        out[k] = via ? { model, effort, via } : { model, effort };
      } else {
        out[k] = via ? { model: core, via } : { model: core };
      }
    } else if (v != null && typeof v === "object" && !Array.isArray(v)) {
      const map = v;
      const model = typeof map.model === "string" ? map.model.trim() : "";
      if (model.length === 0) continue;
      const entry = { model };
      if (typeof map.effort === "string" && map.effort.trim().length > 0) entry.effort = map.effort.trim();
      if (typeof map.via === "string" && map.via.trim().length > 0) entry.via = map.via.trim();
      if (map.force_write_posture === true) entry.force_write_posture = true;
      out[k] = entry;
    }
  }
  return out;
}
function writeUserDials(options, dials) {
  const path = userPaths(options).dialsFile;
  const keys = Object.keys(dials).sort();
  if (keys.length === 0) {
    if ((0, import_node_fs2.existsSync)(path)) (0, import_node_fs2.unlinkSync)(path);
    return path;
  }
  (0, import_node_fs2.mkdirSync)((0, import_node_path2.join)(path, ".."), { recursive: true });
  const sorted = {};
  for (const k of keys) {
    const ref = dials[k];
    if (ref.force_write_posture === true) {
      sorted[k] = {
        model: ref.model,
        ...ref.effort ? { effort: ref.effort } : {},
        ...ref.via ? { via: ref.via } : {},
        force_write_posture: true
      };
    } else {
      let str3 = ref.model;
      if (ref.effort) str3 += `@${ref.effort}`;
      if (ref.via) str3 += ` via ${ref.via}`;
      sorted[k] = str3;
    }
  }
  const ordered = {};
  for (const k of Object.keys(sorted).sort()) ordered[k] = sorted[k];
  (0, import_node_fs2.writeFileSync)(path, `${JSON.stringify(ordered)}
`, "utf8");
  return path;
}
function readVerifiedModels(options = {}) {
  const path = userPaths(options).modelVerificationsFile;
  if (!(0, import_node_fs2.existsSync)(path)) return [];
  const text = (0, import_node_fs2.readFileSync)(path, "utf8").trim();
  if (text.length === 0) return [];
  try {
    const parsed = JSON.parse(text);
    if (!Array.isArray(parsed)) return [];
    const out = [];
    for (const entry of parsed) {
      if (entry == null || typeof entry !== "object" || Array.isArray(entry)) continue;
      const map = entry;
      if (typeof map.driver !== "string" || typeof map.model !== "string" || typeof map.verified_at !== "string") continue;
      out.push({ driver: map.driver, model: map.model, verified_at: map.verified_at });
    }
    out.sort((a, b) => {
      if (a.driver !== b.driver) return a.driver.localeCompare(b.driver);
      return a.model.localeCompare(b.model);
    });
    return out;
  } catch {
    return [];
  }
}
function isModelVerified(options, driver, model) {
  const list = readVerifiedModels(options);
  return list.some((e) => e.driver === driver && e.model === model);
}
function recordVerifiedModel(options, entry) {
  const path = userPaths(options).modelVerificationsFile;
  const existing = readVerifiedModels(options);
  if (existing.some((e) => e.driver === entry.driver && e.model === entry.model)) return;
  const next = [...existing, entry];
  next.sort((a, b) => {
    if (a.driver !== b.driver) return a.driver.localeCompare(b.driver);
    return a.model.localeCompare(b.model);
  });
  (0, import_node_fs2.mkdirSync)((0, import_node_path2.join)(path, ".."), { recursive: true });
  (0, import_node_fs2.writeFileSync)(path, `${JSON.stringify(next)}
`, "utf8");
}
function codexUserAgentDir(options = {}) {
  const env = options.env ?? process.env;
  const home = options.home ?? (0, import_node_os.homedir)();
  return (0, import_node_path2.join)(env.CODEX_HOME?.trim() || (0, import_node_path2.join)(home, ".codex"), "agents");
}

// src/lib/config-layers.ts
function mapping(value) {
  return value !== null && typeof value === "object" && !Array.isArray(value) ? value : null;
}
function parseLayer(path) {
  let parsed;
  try {
    parsed = (0, import_yaml.parse)((0, import_node_fs3.readFileSync)(path, "utf8"));
  } catch (err) {
    throw new ExecutorProfileError(`${path} did not parse: ${err.message}`);
  }
  const doc = mapping(parsed);
  if (!doc) throw new ExecutorProfileError(`${path} is not a mapping.`);
  return doc;
}
var ENTRY_MERGED_KEYS = /* @__PURE__ */ new Set([
  "routes",
  "archetypes",
  "bindings",
  "models",
  "dials",
  "tools",
  // Per-harness, so entry-merged: overriding the Codex relay in a project
  // catalog must not silently drop the builtin's Claude relay beside it.
  "relay"
]);
function validateLayerKeys(doc, path) {
  const unknown = Object.keys(doc).filter((key) => !CATALOG_TOP_LEVEL_KEYS.includes(key));
  if (unknown.length === 0) return;
  if (unknown.some((key) => PRE_DIALS_CATALOG_KEYS.includes(key))) {
    throw preDialsCatalogError(path);
  }
  const described = unknown.map((key) => {
    const near = suggestCatalogKey(key);
    return near != null ? `\`${key}\` (did you mean \`${near}\`?)` : `\`${key}\``;
  });
  throw new ExecutorProfileError(
    `${path}: unknown top-level key${unknown.length === 1 ? "" : "s"} ${described.join(", ")}. Known keys: ${CATALOG_TOP_LEVEL_KEYS.join(", ")}.`
  );
}
function mergeLayer(target, source, layer, path, provenance) {
  if (layer !== "project" && mapping(source.dials) != null && Object.keys(mapping(source.dials)).length > 0) {
    throw new ExecutorProfileError("repo pins live in the project catalog; user dials are state \u2014 use `fadeno dial <archetype> <model> --user`");
  }
  if (layer !== "project" && Array.isArray(source.worktree_carry) && source.worktree_carry.length > 0) {
    throw new ExecutorProfileError("worktree_carry describes this repo's build state; it is project-only \u2014 declare it in .fadeno/executors.yaml, not the user or builtin catalog.");
  }
  validateLayerKeys(source, path);
  for (const key of CATALOG_TOP_LEVEL_KEYS) {
    if (!ENTRY_MERGED_KEYS.has(key)) {
      if (source[key] !== void 0) target[key] = source[key];
      continue;
    }
    if (source[key] !== void 0 && source[key] !== null && mapping(source[key]) == null) {
      throw new ExecutorProfileError(
        `${path}: \`${key}\` must be a mapping; found ${Array.isArray(source[key]) ? "an array" : typeof source[key]}.`
      );
    }
    const entries = mapping(source[key]);
    if (entries == null) continue;
    const current = mapping(target[key]) ?? {};
    for (const [name, value] of Object.entries(entries)) {
      if ((key === "routes" || key === "models") && mapping(value) != null && mapping(current[name]) != null) {
        current[name] = { ...current[name], ...value };
      } else {
        current[name] = value;
      }
      if (key === "bindings") provenance.bindings[name] = layer;
    }
    target[key] = current;
  }
}
function projectIsComplete(doc) {
  const models = mapping(doc.models);
  const routes = mapping(doc.routes);
  if (models == null || Object.keys(models).length === 0) return false;
  if (routes == null || Object.keys(routes).length === 0) return false;
  return true;
}
function missingCanonArchetypes(builtinDoc, projectDoc) {
  const builtin = builtinDoc != null ? mapping(builtinDoc.archetypes) : null;
  if (builtin == null || projectDoc == null) return [];
  const declared = mapping(projectDoc.archetypes) ?? {};
  return Object.keys(builtin).filter((name) => !Object.hasOwn(declared, name)).sort();
}
function loadLayeredProfile(repoRoot, options = {}, harness) {
  const paths = userPaths(options);
  const layers = [
    { layer: "builtin", path: `${templatesDir()}/common/fadeno/executors.yaml` },
    { layer: "user", path: paths.executorsFile },
    { layer: "project", path: (0, import_node_path3.join)(repoRoot, ".fadeno", "executors.yaml") }
  ];
  const present = layers.filter((entry) => (0, import_node_fs3.existsSync)(entry.path));
  if (present.length === 0) throw new ExecutorProfileError("No executor catalog is available.");
  const parsedLayers = new Map(present.map((entry) => [entry.layer, parseLayer(entry.path)]));
  const project = present.find((entry) => entry.layer === "project");
  const projectDoc = project ? parsedLayers.get("project") ?? null : null;
  const suppressLayering = Boolean(projectDoc && projectIsComplete(projectDoc));
  const effective = suppressLayering ? [{ layer: "project", path: project.path }] : present;
  const document = {};
  const provenance = { bindings: {} };
  for (const entry of effective) mergeLayer(document, parsedLayers.get(entry.layer), entry.layer, entry.path, provenance);
  const text = stringifyObject(document);
  return {
    profile: parseExecutorProfile(text, effective.map((entry) => entry.layer).join(" + "), harness),
    path: project?.path ?? present.find((entry) => entry.layer === "user")?.path ?? present[0].path,
    layers: effective.map((entry) => entry.layer),
    provenance,
    paths,
    selfContained: suppressLayering,
    suppressedCanonArchetypes: suppressLayering ? missingCanonArchetypes(parsedLayers.get("builtin") ?? null, projectDoc) : []
  };
}
function missingBuiltinDeclarations(builtinDoc, projectDoc) {
  if (builtinDoc == null || projectDoc == null) return [];
  const missing = [];
  const walk = (builtin, project, path) => {
    for (const [key, builtinValue] of Object.entries(builtin)) {
      const here = path === "" ? key : `${path}.${key}`;
      if (!Object.hasOwn(project, key)) {
        if (mapping(builtinValue) == null) missing.push(here);
        continue;
      }
      const builtinChild = mapping(builtinValue);
      const projectChild = mapping(project[key]);
      if (builtinChild != null && projectChild != null) walk(builtinChild, projectChild, here);
    }
  };
  walk(builtinDoc, projectDoc, "");
  return missing;
}
function explainSuppressedBuiltin(repoRoot, options = {}) {
  void options;
  const projectPath = (0, import_node_path3.join)(repoRoot, ".fadeno", "executors.yaml");
  const builtinPath = `${templatesDir()}/common/fadeno/executors.yaml`;
  if (!(0, import_node_fs3.existsSync)(projectPath) || !(0, import_node_fs3.existsSync)(builtinPath)) return null;
  let projectDoc;
  let builtinDoc;
  try {
    projectDoc = parseLayer(projectPath);
    builtinDoc = parseLayer(builtinPath);
  } catch {
    return null;
  }
  if (!projectIsComplete(projectDoc)) return null;
  return { missing: missingBuiltinDeclarations(builtinDoc, projectDoc) };
}
function stringifyObject(value) {
  return (0, import_yaml.stringify)(value);
}

