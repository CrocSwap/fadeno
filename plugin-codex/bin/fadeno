  if (rel === "" || rel === ".." || rel.startsWith("../") || (0, import_node_path15.isAbsolute)(rel)) {
    throw new DispatchCommandError(`locked request ${label} escapes its run directory: ${value}.`);
  }
  if (!(0, import_node_fs15.existsSync)(path)) throw new DispatchCommandError(`locked request ${label} is missing: ${value}.`);
  const realRel = (0, import_node_path15.relative)((0, import_node_fs15.realpathSync)(runAbsolute), (0, import_node_fs15.realpathSync)(path)).split("\\").join("/");
