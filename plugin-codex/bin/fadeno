  const tmp = `${abs}.tmp-${process.pid}-${(0, import_node_crypto5.randomUUID)()}`;
  (0, import_node_fs12.writeFileSync)(tmp, `${JSON.stringify(state, null, 2)}
`, "utf8");
  try {
    (0, import_node_fs12.renameSync)(tmp, abs);
  } catch (err) {
