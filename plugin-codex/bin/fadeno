var SKILLS2 = ["fadeno-runner", "fadeno-builder", "fadeno-driver"];
function runInit(opts) {
  const tpl = templatesDir();
  const repoRoot = opts.repoRoot ?? findRepoRoot(opts.cwd ?? process.cwd());
  const force = opts.force ?? false;
  const withSteering = opts.noSteering === true ? false : opts.withSteering ?? opts.target !== "grok";
