// src/lib/workspace-lease.ts
var import_node_fs8 = require("node:fs");
var import_node_crypto3 = require("node:crypto");
var import_node_path8 = require("node:path");
var import_node_child_process2 = require("node:child_process");
var WORKSPACE_LEASE_FILE = (0, import_node_path8.join)(".fadeno", "local", "workspace-lease.json");
var WORKSPACE_LEASE_LOCK = (0, import_node_path8.join)(".fadeno", "local", ".workspace-lease.lock");
var LOCK_WAIT_MS = 10;
var LOCK_TIMEOUT_MS = 3e4;
var WORKSPACE_LEASE_LOCK_STALE_MS = 12e4;
var WorkspaceLeaseError = class extends Error {
};
function waitSync(ms) {
  const sig = new Int32Array(new SharedArrayBuffer(4));
  Atomics.wait(sig, 0, 0, ms);
}
function withLeaseLock(repoRoot, action) {
  const lockPath = (0, import_node_path8.join)(repoRoot, WORKSPACE_LEASE_LOCK);
  (0, import_node_fs8.mkdirSync)((0, import_node_path8.dirname)(lockPath), { recursive: true });
  const started = Date.now();
  for (; ; ) {
    try {
      (0, import_node_fs8.mkdirSync)(lockPath);
      break;
    } catch (err) {
      if (err.code !== "EEXIST") throw err;
      let stale = false;
      try {
        stale = Date.now() - (0, import_node_fs8.statSync)(lockPath).mtimeMs > WORKSPACE_LEASE_LOCK_STALE_MS;
      } catch {
      }
      if (stale) {
        (0, import_node_fs8.rmSync)(lockPath, { recursive: true, force: true });
        continue;
      }
      if (Date.now() - started >= LOCK_TIMEOUT_MS) {
        throw new WorkspaceLeaseError(`timed out waiting for the workspace lease lock at ${lockPath}.`);
      }
      waitSync(LOCK_WAIT_MS);
    }
  }
  try {
    return action();
  } finally {
    (0, import_node_fs8.rmSync)(lockPath, { recursive: true, force: true });
  }
}
function isValidMode(value) {
  return value === "shared" || value === "isolated";
}
function probeIsAlive(pid, probe2) {
  if (pid == null) return false;
  try {
    probe2(pid, 0);
    return true;
  } catch (err) {
    return err.code !== "ESRCH";
  }
}
function defaultProbe(pid, signal) {
  process.kill(pid, signal);
}
function parseHolder(value) {
  if (value == null || typeof value !== "object" || Array.isArray(value)) return null;
  const holder = value;
  if (typeof holder.id !== "string" || holder.id.length === 0) return null;
  if (holder.kind !== "ad-hoc" && holder.kind !== "engine" && holder.kind !== "host-dispatch") return null;
  if (holder.runId != null && typeof holder.runId !== "string") return null;
  if (holder.dispatchId != null && typeof holder.dispatchId !== "string") return null;
  return {
    id: holder.id,
    kind: holder.kind,
    ...typeof holder.runId === "string" ? { runId: holder.runId } : {},
    ...typeof holder.dispatchId === "string" ? { dispatchId: holder.dispatchId } : {}
  };
}
function readRecord(repoRoot) {
  const abs = (0, import_node_path8.join)(repoRoot, WORKSPACE_LEASE_FILE);
  if (!(0, import_node_fs8.existsSync)(abs)) return null;
  let parsed;
  try {
    parsed = JSON.parse((0, import_node_fs8.readFileSync)(abs, "utf8"));
  } catch {
    return null;
  }
  if (parsed == null || typeof parsed !== "object" || Array.isArray(parsed)) return null;
  const doc = parsed;
  if (!isValidMode(doc.workspace_mode)) return null;
  if (doc.workspace_mode === "isolated") return null;
  const holder = parseHolder(doc.holder);
  if (holder == null) return null;
  let holders;
  if (doc.holders != null) {
    if (!Array.isArray(doc.holders) || doc.holders.length === 0) return null;
    holders = doc.holders.map(parseHolder).filter((item) => item != null);
    if (holders.length !== doc.holders.length) return null;
  }
  const sup = doc.supervisor_pid;
  const exec = doc.executor_pid;
  const pgid = doc.process_group_id;
  if (sup != null && (typeof sup !== "number" || !Number.isInteger(sup) || sup <= 0)) return null;
  if (exec != null && (typeof exec !== "number" || !Number.isInteger(exec) || exec <= 0)) return null;
  if (pgid != null && (typeof pgid !== "number" || !Number.isInteger(pgid) || pgid <= 0)) return null;
  if (typeof doc.started_at !== "string" || Number.isNaN(Date.parse(doc.started_at))) return null;
  if (typeof doc.heartbeat_at !== "string" || Number.isNaN(Date.parse(doc.heartbeat_at))) return null;
  if (doc.last_output_at != null && (typeof doc.last_output_at !== "string" || Number.isNaN(Date.parse(doc.last_output_at)))) return null;
  if (typeof doc.stdout_bytes !== "number" || typeof doc.stderr_bytes !== "number") return null;
  if (doc.liveness_claim != null && typeof doc.liveness_claim !== "string") return null;
  return { ...doc, holder, ...holders == null ? {} : { holders } };
}
function writeRecordAtomic(repoRoot, record2) {
  const abs = (0, import_node_path8.join)(repoRoot, WORKSPACE_LEASE_FILE);
  (0, import_node_fs8.mkdirSync)((0, import_node_path8.dirname)(abs), { recursive: true });
  const tmp = `${abs}.tmp-${process.pid}-${(0, import_node_crypto3.randomUUID)()}`;
  (0, import_node_fs8.writeFileSync)(tmp, `${JSON.stringify(record2, null, 2)}
`, "utf8");
  try {
    (0, import_node_fs8.renameSync)(tmp, abs);
  } catch (error) {
    (0, import_node_fs8.rmSync)(tmp, { force: true });
    throw error;
  }
}
function sameHolder(left, right) {
  return left.id === right.id && left.kind === right.kind && left.runId === right.runId && left.dispatchId === right.dispatchId;
}
function workspaceLeaseHolderKey(holder) {
  return JSON.stringify([holder.kind, holder.id, holder.runId ?? null, holder.dispatchId ?? null]);
}
function activeHolders(record2) {
  return record2.holders == null || record2.holders.length === 0 ? [record2.holder] : record2.holders;
}
function includesHolder(record2, holder) {
  return activeHolders(record2).some((candidate) => sameHolder(candidate, holder));
}
function readWorkspaceLease(repoRoot) {
  return readRecord(repoRoot);
}
function isWorkspaceLeaseAlive(record2, probe2 = defaultProbe) {
  if (record2 == null) return false;
  if (record2.workspace_mode !== "shared") return false;
  if (record2.supervisor_pid == null) return true;
  if (probeIsAlive(record2.supervisor_pid, probe2)) return true;
  if (record2.process_group_id != null && probeIsAlive(-record2.process_group_id, probe2)) return true;
  if (record2.executor_pid != null && probeIsAlive(record2.executor_pid, probe2)) return true;
  return false;
}
function readEffectiveLease(repoRoot, probe2 = defaultProbe) {
  const rec = readRecord(repoRoot);
  if (rec == null) return null;
  return isWorkspaceLeaseAlive(rec, probe2) ? rec : null;
}
function acquireWorkspaceLease(opts) {
  if (!isValidMode(opts.workspaceMode)) {
    throw new WorkspaceLeaseError(`workspace_mode must be "shared" or "isolated"; got ${JSON.stringify(opts.workspaceMode)}`);
  }
  if (opts.workspaceMode === "isolated") {
    return null;
  }
  if (opts.holder == null || typeof opts.holder.id !== "string" || opts.holder.id.length === 0) {
    throw new WorkspaceLeaseError("holder.id must be a non-empty string.");
  }
  const probe2 = opts.probe ?? defaultProbe;
  const now = opts.now ?? /* @__PURE__ */ new Date();
  const started = opts.startedAt ?? now;
  const heartbeat = opts.heartbeatAt ?? now;
  return withLeaseLock(opts.repoRoot, () => {
    const existing = readRecord(opts.repoRoot);
    if (existing != null) {
      const alive = isWorkspaceLeaseAlive(existing, probe2);
      if (alive) {
        if (includesHolder(existing, opts.holder)) {
          const refreshed = {
            ...existing,
            holder: existing.holder,
            holders: activeHolders(existing),
            holder_started_at: {
              ...existing.holder_started_at ?? {},
              [workspaceLeaseHolderKey(opts.holder)]: existing.holder_started_at?.[workspaceLeaseHolderKey(opts.holder)] ?? existing.started_at
            },
            holder_heartbeat_at: {
              ...existing.holder_heartbeat_at ?? {},
              [workspaceLeaseHolderKey(opts.holder)]: heartbeat.toISOString()
            },
            liveness_claim: opts.livenessClaim !== void 0 ? opts.livenessClaim : existing.liveness_claim ?? null,
            supervisor_pid: opts.supervisorPid ?? existing.supervisor_pid,
            executor_pid: opts.executorPid ?? existing.executor_pid,
            process_group_id: opts.processGroupId ?? existing.process_group_id,
            heartbeat_at: heartbeat.toISOString(),
            last_output_at: opts.lastOutputAt !== void 0 ? opts.lastOutputAt?.toISOString() ?? null : existing.last_output_at,
            stdout_bytes: opts.stdoutBytes ?? existing.stdout_bytes,
            stderr_bytes: opts.stderrBytes ?? existing.stderr_bytes
          };
          writeRecordAtomic(opts.repoRoot, refreshed);
          return refreshed;
        }
        const holdersSuffix = (() => {
          const holders = activeHolders(existing);
          if (holders.length <= 1) return "";
          return ` holders: ${holders.map((holder) => `"${holder.id}"`).join(", ")}`;
        })();
        throw new WorkspaceLeaseError(
          `shared workspace is already held by ${existing.holder.kind} "${existing.holder.id}"${holdersSuffix} (supervisor_pid ${existing.supervisor_pid ?? "unknown"}, started ${existing.started_at}); holder "${opts.holder.id}" must wait or retry. Inspect it with \`fadeno show <run>\`; recover an abandoned host dispatch with dispatch-fail/dispatch-complete. Only after verifying no writer remains, remove ${WORKSPACE_LEASE_FILE} as a last resort.`
        );
      }
    }
    const record2 = {
      workspace_mode: "shared",
      holder: opts.holder,
      holders: [opts.holder],
      holder_started_at: { [workspaceLeaseHolderKey(opts.holder)]: started.toISOString() },
      holder_heartbeat_at: { [workspaceLeaseHolderKey(opts.holder)]: heartbeat.toISOString() },
      liveness_claim: opts.livenessClaim ?? null,
      supervisor_pid: opts.supervisorPid ?? null,
      executor_pid: opts.executorPid ?? null,
      process_group_id: opts.processGroupId ?? null,
      started_at: started.toISOString(),
      heartbeat_at: heartbeat.toISOString(),
      last_output_at: opts.lastOutputAt !== void 0 ? opts.lastOutputAt?.toISOString() ?? null : null,
      stdout_bytes: opts.stdoutBytes ?? 0,
      stderr_bytes: opts.stderrBytes ?? 0
    };
    writeRecordAtomic(opts.repoRoot, record2);
    return record2;
  });
}
function releaseWorkspaceLease(opts) {
  const abs = (0, import_node_path8.join)(opts.repoRoot, WORKSPACE_LEASE_FILE);
  return withLeaseLock(opts.repoRoot, () => {
    const existing = readRecord(opts.repoRoot);
    if (existing == null) return false;
    const holders = activeHolders(existing);
    if (opts.holder == null && opts.holderId == null) {
      throw new WorkspaceLeaseError("workspace lease release requires an exact holder for release.");
    }
    const index = opts.holder != null ? holders.findIndex((candidate) => sameHolder(candidate, opts.holder)) : opts.holderId != null ? holders.findIndex((candidate) => candidate.id === opts.holderId) : -1;
    if ((opts.holder != null || opts.holderId != null) && index < 0) return false;
    if (index >= 0 && holders.length > 1) {
      const remaining = holders.filter((_, candidateIndex) => candidateIndex !== index);
      const removedKey = workspaceLeaseHolderKey(holders[index]);
      const holderStartedAt = { ...existing.holder_started_at ?? {} };
      const holderHeartbeatAt = { ...existing.holder_heartbeat_at ?? {} };
      delete holderStartedAt[removedKey];
      delete holderHeartbeatAt[removedKey];
      writeRecordAtomic(opts.repoRoot, {
        ...existing,
        holder: remaining[0],
        holders: remaining,
        holder_started_at: holderStartedAt,
        holder_heartbeat_at: holderHeartbeatAt
      });
      return true;
    }
    (0, import_node_fs8.rmSync)(abs, { force: true });
    return true;
  });
}
function heartbeatWorkspaceLease(opts) {
  const probe2 = opts.probe ?? defaultProbe;
  const now = opts.now ?? heartbeatNow(opts);
  const heartbeatAt = opts.heartbeatAt ?? now;
  return withLeaseLock(opts.repoRoot, () => {
    const existing = readRecord(opts.repoRoot);
    if (existing == null) {
      throw new WorkspaceLeaseError(`no active shared workspace lease to heartbeat for holder "${opts.holderId}".`);
    }
    if (!isWorkspaceLeaseAlive(existing, probe2)) {
      throw new WorkspaceLeaseError(`shared lease for "${existing.holder.id}" is stale; holder "${opts.holderId}" cannot heartbeat it.`);
    }
    const matches = opts.holder != null ? includesHolder(existing, opts.holder) : activeHolders(existing).some((holder) => holder.id === opts.holderId);
    if (!matches) {
      throw new WorkspaceLeaseError(
        `heartbeat holder "${opts.holderId}" does not match active lease holder "${existing.holder.id}".`
      );
    }
    const updated = {
      ...existing,
      heartbeat_at: heartbeatAt.toISOString(),
      last_output_at: opts.lastOutputAt !== void 0 ? opts.lastOutputAt?.toISOString() ?? null : existing.last_output_at,
      stdout_bytes: opts.stdoutBytes ?? existing.stdout_bytes,
      stderr_bytes: opts.stderrBytes ?? existing.stderr_bytes,
      ...opts.holder == null ? {} : {
        holder_heartbeat_at: {
          ...existing.holder_heartbeat_at ?? {},
          [workspaceLeaseHolderKey(opts.holder)]: heartbeatAt.toISOString()
        }
      }
    };
    writeRecordAtomic(opts.repoRoot, updated);
    return updated;
  });
}
function heartbeatNow(opts) {
  if (opts.now != null) return opts.now;
  return /* @__PURE__ */ new Date();
}
var ISOLATED_DIFF_MAX_NOTE = 4e3;
function carryPathIntoWorktree(repoRoot, worktreeAbs, relPath) {
  const srcAbs = (0, import_node_path8.join)(repoRoot, relPath);
  if (!(0, import_node_fs8.existsSync)(srcAbs)) return { status: "absent" };
  const destAbs = (0, import_node_path8.join)(worktreeAbs, relPath);
  try {
    (0, import_node_fs8.mkdirSync)((0, import_node_path8.dirname)(destAbs), { recursive: true });
  } catch (err) {
    return { status: "failed", reason: `could not prepare "${relPath}"'s parent directory in the worktree: ${err instanceof Error ? err.message : String(err)}` };
  }
  const attempt = (args) => (0, import_node_child_process2.spawnSync)("cp", args, { encoding: "utf8" });
  const cleanupPartial = () => {
    try {
      (0, import_node_fs8.rmSync)(destAbs, { recursive: true, force: true });
    } catch {
    }
  };
  const reflinkArgs = process.platform === "darwin" ? ["-R", "-c", srcAbs, destAbs] : ["-R", "--reflink=always", srcAbs, destAbs];
  const reflinkRes = attempt(reflinkArgs);
  if (reflinkRes.error == null && reflinkRes.status === 0) return { status: "carried", mechanism: "reflink" };
  cleanupPartial();
  const hardlinkRes = attempt(["-a", "-l", srcAbs, destAbs]);
  if (hardlinkRes.error == null && hardlinkRes.status === 0) return { status: "carried", mechanism: "hardlink" };
  cleanupPartial();
  const copyRes = attempt(["-a", srcAbs, destAbs]);
  if (copyRes.error == null && copyRes.status === 0) return { status: "carried", mechanism: "copy" };
  cleanupPartial();
  const reason = copyRes.error != null ? copyRes.error.message : String(copyRes.stderr ?? "").trim() || `exit ${copyRes.status ?? "unknown"}`;
  return { status: "failed", reason };
}
function carryDeclaredPaths(repoRoot, worktreeAbs, declared, opts = {}) {
  const records = [];
  for (const relPath of declared) {
    const outcome = carryPathIntoWorktree(repoRoot, worktreeAbs, relPath);
    if (outcome.status === "absent") continue;
    if (outcome.status === "failed") {
      return { records, failure: { path: relPath, reason: outcome.reason }, fingerprint: emptyCarryFingerprint() };
    }
    records.push({ path: relPath, mechanism: outcome.mechanism });
  }
  const fingerprint = opts.fingerprint === false ? emptyCarryFingerprint() : fingerprintCarriedPaths(repoRoot, records);
  return { records, failure: null, fingerprint };
}
var CARRY_FINGERPRINT_MAX_ENTRIES = 25e4;
var CARRY_DRIFT_MAX_EXAMPLES = 10;
var HAZARD_KINDS = ["in_place_write", "metadata_only"];
function emptyCarryFingerprint() {
  return { capturedAt: (/* @__PURE__ */ new Date()).toISOString(), paths: [] };
}
function stampOf(abs) {
  try {
    const st = (0, import_node_fs8.lstatSync)(abs, { bigint: true });
    if (st.isDirectory()) return "d";
    if (st.isSymbolicLink()) return `l|${st.ino}`;
    if (st.isFile()) {
      return `f|${st.ino}|${st.size}|${st.mtimeNs}|${st.ctimeNs}|${st.mode}|${st.uid}|${st.gid}|${st.nlink}`;
    }
    return `o|${st.ino}|${st.mode}`;
  } catch (err) {
    const code = err?.code ?? "EUNKNOWN";
    return `!|${code}`;
  }
}
function walkCarryPath(repoRoot, relPath, maxEntries) {
  const stamps = /* @__PURE__ */ new Map();
  let truncated = false;
  let unreadable = 0;
  const rootAbs = (0, import_node_path8.join)(repoRoot, relPath);
  const rootRel = relPath.split("\\").join("/");
  const stack = [{ abs: rootAbs, rel: rootRel }];
  while (stack.length > 0) {
    const cur = stack.pop();
    if (stamps.size >= maxEntries) {
      truncated = true;
      break;
    }
    const stamp = stampOf(cur.abs);
    if (stamp.startsWith("!|") && stamp !== "!|ENOENT") unreadable += 1;
    stamps.set(cur.rel, stamp);
    if (stamp !== "d") continue;
    let entries;
    try {
      entries = (0, import_node_fs8.readdirSync)(cur.abs, { withFileTypes: true });
    } catch {
      stamps.set(cur.rel, "d|unlistable");
      unreadable += 1;
      continue;
    }
    for (const entry of entries.map((e) => e.name).sort().reverse()) {
      stack.push({ abs: (0, import_node_path8.join)(cur.abs, entry), rel: `${cur.rel}/${entry}` });
    }
  }
  return { stamps, truncated, unreadable };
}
function fingerprintCarriedPaths(repoRoot, records, opts = {}) {
  const maxEntries = opts.maxEntries ?? CARRY_FINGERPRINT_MAX_ENTRIES;
  const paths = [];
  for (const record2 of records) {
    if (record2.mechanism !== "hardlink") continue;
    const walked = walkCarryPath(repoRoot, record2.path, maxEntries);
    paths.push({
      path: record2.path,
      mechanism: "hardlink",
      entries: walked.stamps.size,
      truncated: walked.truncated,
      unreadable: walked.unreadable,
      maxEntries,
      stamps: walked.stamps
    });
  }
  return { capturedAt: (/* @__PURE__ */ new Date()).toISOString(), paths };
}
function fileFields(stamp) {
  return stamp.split("|");
}
function classify(before, after) {
  if (before === after) return null;
  if (!before.startsWith("f|") || !after.startsWith("f|")) {
    return "replaced";
  }
  const b = fileFields(before);
  const a = fileFields(after);
  if (b[1] !== a[1]) return "replaced";
  if (b[2] !== a[2] || b[3] !== a[3]) return "in_place_write";
  if (b[5] !== a[5] || b[6] !== a[6] || b[7] !== a[7]) return "metadata_only";
  if (b[4] !== a[4]) {
    if (b[8] !== a[8]) return null;
    return "metadata_only";
  }
  return null;
}
function verifyCarriedPaths(repoRoot, fingerprint) {
  const verdicts = [];
  for (const captured of fingerprint.paths) {
    const now = walkCarryPath(repoRoot, captured.path, captured.maxEntries);
    const drift = [];
    const kinds = {};
    const bump = (kind, path) => {
      kinds[kind] = (kinds[kind] ?? 0) + 1;
      drift.push({ path, kind });
    };
    for (const [path, before] of captured.stamps) {
      const after = now.stamps.get(path);
      if (after === void 0) {
        if (!now.truncated) bump("removed", path);
        continue;
      }
      const kind = classify(before, after);
      if (kind != null) bump(kind, path);
    }
    if (!captured.truncated) {
      for (const path of now.stamps.keys()) {
        if (!captured.stamps.has(path)) bump("added", path);
      }
    }
    const hazards = HAZARD_KINDS.reduce((sum, kind) => sum + (kinds[kind] ?? 0), 0);
    const degraded = captured.truncated || now.truncated || captured.unreadable > 0 || now.unreadable > 0;
    let status;
    let note = null;
    if (hazards > 0) {
      status = "mutated";
      note = `${hazards} ${hazards === 1 ? "entry" : "entries"} changed on an inode this carry shares with the worktree; the primary's copy changed with it. Attestation, not attribution \u2014 the primary's own tooling writing in place produces the same evidence.`;
    } else if (degraded) {
      status = "unknown";
      note = captured.truncated || now.truncated ? `the carried tree exceeds the ${captured.maxEntries}-entry fingerprint budget, so part of it was never compared \u2014 not a clean result.` : "part of the carried tree could not be read at capture or verify time, so part of it was never compared \u2014 not a clean result.";
    } else if (drift.length > 0) {
      status = "drifted";
      note = "the carried tree changed, but only in ways a hardlinked worktree cannot cause (entries added, removed, or repointed in the primary's own directories).";
    } else {
      status = "clean";
    }
    const ordered = drift.slice().sort((x, y) => {
      const hx = HAZARD_KINDS.includes(x.kind) ? 0 : 1;
      const hy = HAZARD_KINDS.includes(y.kind) ? 0 : 1;
      if (hx !== hy) return hx - hy;
      return x.path < y.path ? -1 : x.path > y.path ? 1 : 0;
    });
    verdicts.push({
      path: captured.path,
      mechanism: "hardlink",
      status,
      entriesChanged: drift.length,
      kinds,
      examples: ordered.slice(0, CARRY_DRIFT_MAX_EXAMPLES),
      note
    });
  }
  return verdicts;
}
function carryMutationStamp(verdicts) {
  const stamps = [];
  for (const verdict of verdicts) {
    if (verdict.status === "clean") continue;
    stamps.push({
      path: verdict.path,
      mechanism: verdict.mechanism,
      status: verdict.status,
      entries_changed: verdict.entriesChanged,
      kinds: verdict.kinds,
      examples: verdict.examples,
      ...verdict.note != null ? { note: verdict.note } : {}
    });
  }
  return stamps.length > 0 ? stamps : null;
}
var IGNORED_OUTPUT_MAX_ENTRIES = 1e4;
var IGNORED_OUTPUT_MAX_BUFFER = 32 * 1024 * 1024;
function normalizeScanPath(raw) {
  let out = raw.split("\\").join("/");
  while (out.startsWith("./")) out = out.slice(2);
  while (out.length > 1 && out.endsWith("/")) out = out.slice(0, -1);
  return out;
}
function isAtOrUnder(rel, prefix) {
  return rel === prefix || rel.startsWith(`${prefix}/`);
}
function isFadenoWorktreeState(rel) {
  return isAtOrUnder(rel, ".fadeno");
}
function scanIgnoredOutput(worktreeAbs, carriedPaths, opts = {}) {
  const maxEntries = opts.maxEntries ?? IGNORED_OUTPUT_MAX_ENTRIES;
  if (typeof worktreeAbs !== "string" || worktreeAbs.length === 0) {
    return { paths: [], truncated: true, note: "no worktree path was given, so nothing could be scanned." };
  }
  let result;
  try {
    result = (0, import_node_child_process2.spawnSync)(
      "git",
      ["-C", worktreeAbs, "ls-files", "--others", "--ignored", "--exclude-standard", "--directory", "-z"],
      { encoding: "utf8", maxBuffer: IGNORED_OUTPUT_MAX_BUFFER }
    );
  } catch (err) {
    return { paths: [], truncated: true, note: `the ignored-output listing could not be run: ${err instanceof Error ? err.message : String(err)}` };
  }
  const failed = result.error != null || result.status !== 0;
  const raw = String(result.stdout ?? "");
  const fields = raw.split("\0");
  if (failed && raw.length > 0 && !raw.endsWith("\0")) fields.pop();
  const carries = [];
  for (const declared of carriedPaths) {
    if (typeof declared !== "string") continue;
    const norm = normalizeScanPath(declared);
    if (norm.length === 0 || norm === ".") continue;
    carries.push(norm);
  }
  const paths = [];
  let cappedOut = false;
  for (const field of fields) {
    if (field.length === 0) continue;
    const rel = normalizeScanPath(field);
    if (rel.length === 0 || rel === ".") continue;
    if (isFadenoWorktreeState(rel)) continue;
    if (carries.some((carry) => isAtOrUnder(rel, carry))) continue;
    if (paths.length >= maxEntries) {
      cappedOut = true;
      break;
    }
    paths.push(field);
  }
  if (failed) {
    const reason = result.error != null ? result.error.message : String(result.stderr ?? "").trim() || `exit ${result.status ?? "unknown"}`;
    return {
      paths,
      truncated: true,
      note: `the ignored-output listing failed (${reason.slice(0, ISOLATED_DIFF_MAX_NOTE)}), so these ${paths.length} ${paths.length === 1 ? "path is" : "paths are"} a floor, not the set.`
    };
  }
  if (cappedOut) {
    return {
      paths,
      truncated: true,
      note: `more than ${maxEntries} ignored entries are present; the listing stopped there, so these paths are a floor, not the set.`
    };
  }
  return { paths, truncated: false };
}
function createIsolatedWorktree(opts) {
  const worktreeAbs = opts.worktreePath;
  const worktreeRel = (0, import_node_path8.relative)(opts.repoRoot, worktreeAbs).split("\\").join("/");
  if (worktreeRel === "" || worktreeRel.startsWith("../") || worktreeRel.split("/").includes("..")) {
    throw new WorkspaceLeaseError(`isolated worktree path escapes repo: ${worktreeAbs}`);
  }
  (0, import_node_fs8.mkdirSync)((0, import_node_path8.dirname)(worktreeAbs), { recursive: true });
  try {
    (0, import_node_child_process2.spawnSync)("git", ["worktree", "prune"], { cwd: opts.repoRoot, encoding: "utf8" });
  } catch {
  }
  const add = (0, import_node_child_process2.spawnSync)("git", ["worktree", "add", "--detach", worktreeAbs, "HEAD"], { cwd: opts.repoRoot, encoding: "utf8" });
  if (add.error != null || add.status !== 0) {
    const reason = add.error?.message ?? (add.stderr != null ? String(add.stderr).trim() : "") ?? "worktree add failed";
    throw new WorkspaceLeaseError(reason.length > 0 ? `isolated worktree could not be created: ${reason.slice(0, ISOLATED_DIFF_MAX_NOTE)}` : "isolated worktree could not be created");
  }
  opts.onEcho?.(`isolated worktree: ${worktreeRel} (from HEAD)`);
  return { worktreeAbs, worktreeRel };
}
function collectIsolatedDiff(opts) {
  (0, import_node_fs8.mkdirSync)((0, import_node_path8.dirname)(opts.diffAbs), { recursive: true });
  const add = (0, import_node_child_process2.spawnSync)("git", ["-C", opts.worktreeAbs, "add", "-A"], { encoding: "utf8" });
  if (add.error != null || add.status !== 0) {
    const reason = add.error?.message ?? (String(add.stderr ?? "").trim() || `exit ${add.status ?? "unknown"}`);
    throw new WorkspaceLeaseError(`could not stage isolated worktree changes: ${reason.slice(0, ISOLATED_DIFF_MAX_NOTE)}`);
  }
  const diffRes = (0, import_node_child_process2.spawnSync)("git", ["-C", opts.worktreeAbs, "diff", "--binary", "--cached"], {
    encoding: "buffer",
    maxBuffer: 32 * 1024 * 1024
  });
  if (diffRes.error != null || diffRes.status !== 0) {
    const reason = diffRes.error?.message ?? (Buffer.from(diffRes.stderr ?? []).toString("utf8").trim() || `exit ${diffRes.status ?? "unknown"}`);
    throw new WorkspaceLeaseError(`could not collect isolated worktree diff: ${reason.slice(0, ISOLATED_DIFF_MAX_NOTE)}`);
  }
  const diffContent = Buffer.from(diffRes.stdout ?? []);
  const tmp = `${opts.diffAbs}.tmp-${process.pid}-${(0, import_node_crypto3.randomUUID)()}`;
  (0, import_node_fs8.writeFileSync)(tmp, diffContent);
  try {
    (0, import_node_fs8.renameSync)(tmp, opts.diffAbs);
  } catch (error) {
    (0, import_node_fs8.rmSync)(tmp, { force: true });
    throw error;
  }
  const diffBytes = diffContent.byteLength;
  return { diffRel: opts.diffRel, diffAbs: opts.diffAbs, diffBytes };
}
function isRegisteredWorktree(repoRoot, candidateAbs) {
  const env = { ...process.env, GIT_CONFIG_GLOBAL: "/dev/null", GIT_CONFIG_SYSTEM: "/dev/null", GIT_CONFIG_NOSYSTEM: "1" };
  let candidateReal;
  try {
    candidateReal = (0, import_node_fs8.realpathSync)((0, import_node_path8.resolve)(candidateAbs));
  } catch {
    return false;
  }
  try {
    const list = (0, import_node_child_process2.spawnSync)("git", ["-C", repoRoot, "worktree", "list", "--porcelain"], { encoding: "utf8", env });
    if (list.error != null || list.status !== 0) return false;
    const out = String(list.stdout ?? "");
    let found = false;
    for (const entry of out.split("\n\n")) {
      const wtLine = entry.split("\n").find((l) => l.startsWith("worktree "));
      if (wtLine == null) continue;
      const wtPath = wtLine.slice("worktree ".length).trim();
      let wtReal;
      try {
        wtReal = (0, import_node_fs8.realpathSync)((0, import_node_path8.resolve)(wtPath));
      } catch {
        continue;
      }
      if (wtReal !== candidateReal) continue;
      found = true;
      if (entry.split("\n").some((l) => l.startsWith("prunable"))) return false;
      break;
    }
    if (!found) return false;
    const top = (0, import_node_child_process2.spawnSync)("git", ["-C", candidateAbs, "rev-parse", "--show-toplevel"], { encoding: "utf8", env });
    if (top.error != null || top.status !== 0) return false;
    let topReal;
    try {
      topReal = (0, import_node_fs8.realpathSync)((0, import_node_path8.resolve)(String(top.stdout).trim()));
    } catch {
      return false;
    }
    if (topReal !== candidateReal) return false;
    const commonDirInside = (0, import_node_child_process2.spawnSync)("git", ["-C", candidateAbs, "rev-parse", "--git-common-dir"], { encoding: "utf8", env });
    const commonDirRepo = (0, import_node_child_process2.spawnSync)("git", ["-C", repoRoot, "rev-parse", "--git-common-dir"], { encoding: "utf8", env });
    if (commonDirInside.error != null || commonDirInside.status !== 0) return false;
    if (commonDirRepo.error != null || commonDirRepo.status !== 0) return false;
    const insideCommon = String(commonDirInside.stdout).trim();
    const repoCommon = String(commonDirRepo.stdout).trim();
    const insideCommonAbs = (0, import_node_path8.resolve)(candidateAbs, insideCommon);
    const repoCommonAbs = (0, import_node_path8.resolve)(repoRoot, repoCommon);
    let insideCommonReal;
    let repoCommonReal;
    try {
      insideCommonReal = (0, import_node_fs8.realpathSync)((0, import_node_path8.resolve)(insideCommonAbs));
      repoCommonReal = (0, import_node_fs8.realpathSync)((0, import_node_path8.resolve)(repoCommonAbs));
    } catch {
      return false;
    }
    if (insideCommonReal !== repoCommonReal) return false;
    return true;
  } catch {
    return false;
  }
}
function removeIsolatedWorktree(repoRoot, worktreeAbs) {
  try {
    (0, import_node_child_process2.spawnSync)("git", ["worktree", "remove", "--force", worktreeAbs], { cwd: repoRoot, encoding: "utf8" });
  } catch {
  }
  try {
    (0, import_node_fs8.rmSync)(worktreeAbs, { recursive: true, force: true });
  } catch {
  }
}
function withIsolatedWorktree(opts, action) {
  const created = createIsolatedWorktree(opts);
  let result;
  let actionError;
  try {
    result = action(created.worktreeAbs);
  } catch (error) {
    actionError = error;
  }
  let diff;
  try {
    diff = collectIsolatedDiff({
      repoRoot: opts.repoRoot,
      worktreeAbs: created.worktreeAbs,
      diffAbs: opts.diffAbs,
      diffRel: opts.diffRel
    });
  } catch (diffError) {
    if (actionError != null) throw new AggregateError([actionError, diffError], "isolated action and diff collection both failed");
    throw diffError;
  }
  removeIsolatedWorktree(opts.repoRoot, created.worktreeAbs);
  if (actionError != null) throw actionError;
  return { result, diff, worktreeRel: created.worktreeRel };
}

