    } finally {
      (0, import_node_fs37.rmSync)(tmp, { force: true });
    }
  }
  const fresh = readEventsStrict(runDirForClaim);
  const already = plannedGenerationAttributed(fresh, next.step.id, plannedOutput, generation) || fresh.some((e) => e.type === "artifact_created" && e.step === next.step.id && e.extra.artifact === opts.output);
