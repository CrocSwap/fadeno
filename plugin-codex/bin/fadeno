          } catch {
          }
          try {
            (0, import_node_fs39.mkdirSync)(lockPath);
          } catch {
            return { outcome: "locked", from: null, to: srcVer };
          }
        } else {
          return { outcome: "locked", from: null, to: srcVer };
        }
      } else {
        throw err;
      }
    }
    let staged2 = false;
    try {
      try {
        rmFn(stagingPath, { recursive: true, force: true });
