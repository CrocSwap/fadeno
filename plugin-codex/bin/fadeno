  const builtin = name == null ? (0, import_node_path7.join)(builtinBase, `${kind}.md`) : kind === "playbook" ? (0, import_node_path7.join)(builtinBase, "playbooks", name) : (0, import_node_path7.join)(builtinBase, "schemas", name);
  if ((0, import_node_fs7.existsSync)(project)) return { kind: "project", path: project };
