var InstallationError = class extends Error {
};
function emptyInstallationManifest() {
  return { schema_version: 1, runtime: null, harnesses: {} };
}
function readInstallationManifest(options = {}) {
  const path = userPaths(options).installationsFile;
  if (!(0, import_node_fs39.existsSync)(path)) return emptyInstallationManifest();
  try {
    const parsed = JSON.parse((0, import_node_fs39.readFileSync)(path, "utf8"));
    if (parsed.schema_version !== 1 || parsed.harnesses == null || typeof parsed.harnesses !== "object") {
      throw new InstallationError(`unsupported or malformed installation manifest at ${path}`);
    }
    return parsed;
  } catch (err) {
    if (err instanceof InstallationError) throw err;
    throw new InstallationError(`could not parse installation manifest ${path}: ${err.message}`);
  }
}
function maintainedHarnesses(options = {}) {
  const manifest = readInstallationManifest(options);
  const names = new Set(Object.keys(manifest.harnesses));
  const memo = readUserHarness(options);
  if (memo != null) names.add(memo);
  return [...names].sort();
}
function writeInstallationManifest(paths, manifest) {
  (0, import_node_fs39.mkdirSync)((0, import_node_path40.dirname)(paths.installationsFile), { recursive: true });
  const tmp = `${paths.installationsFile}.tmp-${process.pid}-${Date.now()}`;
  (0, import_node_fs39.writeFileSync)(tmp, `${JSON.stringify(manifest, null, 2)}
`, "utf8");
  (0, import_node_fs39.renameSync)(tmp, paths.installationsFile);
}
function fileDigest(path) {
  return (0, import_node_crypto13.createHash)("sha256").update((0, import_node_fs39.readFileSync)(path)).digest("hex");
}
var VERSION_RE = /^(\d+)\.(\d+)\.(\d+)(?:-rc\.(\d+))?$/;
function compareFadenoVersions(a, b) {
  const ma = VERSION_RE.exec(a.trim());
  const mb = VERSION_RE.exec(b.trim());
  if (!ma || !mb) return null;
  const aMajor = Number(ma[1]), aMinor = Number(ma[2]), aPatch = Number(ma[3]);
  const bMajor = Number(mb[1]), bMinor = Number(mb[2]), bPatch = Number(mb[3]);
  if (aMajor !== bMajor) return aMajor > bMajor ? 1 : -1;
  if (aMinor !== bMinor) return aMinor > bMinor ? 1 : -1;
  if (aPatch !== bPatch) return aPatch > bPatch ? 1 : -1;
  const aRc = ma[4] !== void 0 ? Number(ma[4]) : null;
  const bRc = mb[4] !== void 0 ? Number(mb[4]) : null;
  if (aRc === null && bRc === null) return 0;
  if (aRc === null && bRc !== null) return 1;
  if (aRc !== null && bRc === null) return -1;
  if (aRc !== bRc) return aRc > bRc ? 1 : -1;
  return 0;
}
function sourceBundleVersion(sourceDir) {
  const candidates = [
    (0, import_node_path40.join)((0, import_node_path40.dirname)(sourceDir), ".claude-plugin", "plugin.json"),
    (0, import_node_path40.join)((0, import_node_path40.dirname)(sourceDir), ".codex-plugin", "plugin.json")
  ];
  for (const candidate of candidates) {
    try {
      if (!(0, import_node_fs39.existsSync)(candidate)) continue;
      const parsed = JSON.parse((0, import_node_fs39.readFileSync)(candidate, "utf8"));
      if (parsed.name !== "fadeno") continue;
      if (typeof parsed.version === "string" && parsed.version.trim().length > 0) {
        return parsed.version.trim();
      }
    } catch {
    }
  }
  try {
    const pkg = (0, import_node_path40.join)(sourceDir, "package.json");
    if ((0, import_node_fs39.existsSync)(pkg)) {
      const parsed = JSON.parse((0, import_node_fs39.readFileSync)(pkg, "utf8"));
      if (typeof parsed.version === "string" && parsed.version.trim().length > 0) {
        if (parsed.name === "fadeno-runtime" || parsed.name === "fadeno") {
          return parsed.version.trim();
        }
      }
    }
  } catch {
  }
  return null;
}
function readRuntimeVersionAt(binDir) {
  try {
    const pkgPath = (0, import_node_path40.join)(binDir, "package.json");
    if ((0, import_node_fs39.existsSync)(pkgPath)) {
      const parsed = JSON.parse((0, import_node_fs39.readFileSync)(pkgPath, "utf8"));
      if (typeof parsed.version === "string" && parsed.version.trim().length > 0) {
        if (parsed.name === "fadeno-runtime" || parsed.name === "fadeno") {
          return { version: parsed.version.trim(), source: "observed" };
        }
      }
    }
  } catch {
  }
  return { version: null, source: "assumed" };
}
var LOCK_STALE_MS2 = 12e4;
function isStaleLock(lockPath) {
  try {
    const st = (0, import_node_fs39.statSync)(lockPath);
    return Date.now() - st.mtimeMs > LOCK_STALE_MS2;
  } catch {
    try {
      const lst = (0, import_node_fs39.lstatSync)(lockPath);
      return Date.now() - lst.mtimeMs > LOCK_STALE_MS2;
    } catch {
      return false;
    }
  }
}
function syncManagedRuntime(paths, sourceDir, manifest, opts = {}) {
  const allowInstall = opts.allowInstall ?? false;
  const trustSource = opts.trustSource ?? false;
  const force = opts.force ?? false;
  const copyFn = opts.copyFn ?? import_node_fs39.cpSync;
  const digestFn = opts.digestFn ?? fileDigest;
  const renameFn = opts.renameFn ?? import_node_fs39.renameSync;
