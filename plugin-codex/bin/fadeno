function supervisorCanStillReport(pid) {
  try {
    process.kill(pid, 0);
  } catch {
    return false;
  }
  if (process.platform === "win32") return true;
  try {
    const stat = (0, import_node_child_process3.spawnSync)("ps", ["-o", "stat=", "-p", String(pid)], { encoding: "utf8" });
    if (stat.error != null) return true;
    if (stat.status !== 0) return false;
    return !(stat.stdout ?? "").trim().startsWith("Z");
  } catch {
    return true;
  }
}
function readInflightClaim(path, read) {
  let parsed;
  try {
    const raw = JSON.parse(read(path));
    if (raw == null || typeof raw !== "object" || Array.isArray(raw)) return null;
    parsed = raw;
  } catch {
    return null;
  }
  const pidRaw = parsed.pid ?? parsed.supervisor_pid;
  if (typeof pidRaw !== "number" || !Number.isInteger(pidRaw) || pidRaw <= 0) return null;
  const pid = pidRaw;
  const supervisorPid = typeof parsed.supervisor_pid === "number" && Number.isInteger(parsed.supervisor_pid) && parsed.supervisor_pid > 0 ? parsed.supervisor_pid : pid;
  const executorPid = typeof parsed.executor_pid === "number" && Number.isInteger(parsed.executor_pid) && parsed.executor_pid > 0 ? parsed.executor_pid : null;
  const processGroupId = typeof parsed.process_group_id === "number" && Number.isInteger(parsed.process_group_id) && parsed.process_group_id > 0 ? parsed.process_group_id : null;
  const ownerPid = typeof parsed.owner_pid === "number" && Number.isInteger(parsed.owner_pid) && parsed.owner_pid > 0 ? parsed.owner_pid : null;
  const startedAt = typeof parsed.started_at === "string" ? parsed.started_at : null;
  const heartbeatAt = typeof parsed.heartbeat_at === "string" ? parsed.heartbeat_at : startedAt;
  const lastOutputAt = typeof parsed.last_output_at === "string" ? parsed.last_output_at : null;
  const stdoutBytes = typeof parsed.stdout_bytes === "number" && Number.isFinite(parsed.stdout_bytes) && parsed.stdout_bytes >= 0 ? parsed.stdout_bytes : typeof parsed.stdout_bytes === "number" ? 0 : null;
  const stderrBytes = typeof parsed.stderr_bytes === "number" && Number.isFinite(parsed.stderr_bytes) && parsed.stderr_bytes >= 0 ? parsed.stderr_bytes : typeof parsed.stderr_bytes === "number" ? 0 : null;
  const stdout = stdoutBytes ?? (parsed.stdout_bytes != null ? 0 : null);
  const stderr = stderrBytes ?? (parsed.stderr_bytes != null ? 0 : null);
  return {
    pid,
    startedAt,
    supervisorPid,
    executorPid,
    processGroupId,
    ownerPid,
    heartbeatAt,
    lastOutputAt,
    stdoutBytes: stdout,
    stderrBytes: stderr
  };
}
function describeWorkspaceLeaseLiveness(record2, repoRoot, opts = {}) {
  if (record2 == null) return null;
  const now = opts.now ?? /* @__PURE__ */ new Date();
  const started = Date.parse(record2.started_at);
  const heldMs = Number.isNaN(started) ? 0 : Math.max(0, now.getTime() - started);
  const rel = record2.liveness_claim;
  if (rel == null || rel === "") return { state: "unobservable", claim: null, heldMs };
  const read = opts.read ?? ((path) => (0, import_node_fs11.readFileSync)(path, "utf8"));
  const claim = readInflightClaim((0, import_node_path11.join)(repoRoot, ...rel.split("/")), read);
  if (claim == null) return { state: "ended", claim: rel, heldMs };
  const alive = opts.probe != null ? inflightClaimIsAlive(claim, opts.probe) : inflightClaimIsAlive(claim);
  return { state: alive ? "running" : "ended", claim: rel, heldMs };
}

