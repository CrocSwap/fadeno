function shadowSampleRoll(promptSha256, archetype, challenger) {
  const digest2 = (0, import_node_crypto.createHash)("sha256").update(`${promptSha256}:${archetype}:${challenger}`).digest("hex");
  return Number.parseInt(digest2.slice(0, 8), 16) / 4294967296;
}
