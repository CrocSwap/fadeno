        }
        if (rawRoute.write_access !== void 0) {
          if (typeof rawRoute.write_access !== "boolean") {
            throw new ExecutorProfileError(`${source}: route \`routes.${harnessKey}.${routeKey}.write_access\` must be boolean.`);
          }
