// src/lib/run-scope.ts
function bodyOwnerOf(playbook, stepId) {
  const flow = Array.isArray(playbook.flow) ? playbook.flow : [];
  for (const step of flow) {
    if (step.kind !== "loop" || !Array.isArray(step.body)) continue;
    if (step.body.includes(stepId) && typeof step.id === "string") return step.id;
  }
  return null;
}
function countIterationStarts(events, loopId) {
  return events.filter((e) => e.type === "loop_iteration_started" && e.step === loopId).length;
}
function scopeStartIndex(events, loopId, generation) {
  if (loopId == null) return 0;
  let seen = 0;
  for (let i = 0; i < events.length; i += 1) {
    if (events[i].type === "loop_iteration_started" && events[i].step === loopId) {
      seen += 1;
      if (seen === generation) return i;
    }
  }
  return 0;
}
function stepStartedInScope(events, stepId, from) {
  for (let i = from; i < events.length; i += 1) {
    if (events[i].type === "step_started" && events[i].step === stepId) return true;
  }
  return false;
}

