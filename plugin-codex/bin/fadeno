        break;
      case "claude":
        skillsBase = (0, import_node_path27.join)(repoRoot, ".claude", "skills");
        break;
      case "grok":
        skillsBase = (0, import_node_path27.join)(repoRoot, ".grok", "skills");
        break;
    }
    for (const skill of SKILLS2) {
      const skillSrc = (0, import_node_path27.join)(tpl, "common", "skills", skill);
