        problems.push(`${id}: terminal fallback_command does not match start`);
      }
    }
    for (const field of ["step", "actor", "step_execution_id", "actor_call_id", "attempt", "executor", "adapter", "model", "reasoning_effort", "agent_type", "prompt_path", "prompt_sha256", "output_path"]) {
