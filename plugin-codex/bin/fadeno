function lockedRunFile(runDir, value, label) {
  const runAbsolute = (0, import_node_path15.resolve)(runDir);
  const path = (0, import_node_path15.isAbsolute)(value) ? (0, import_node_path15.resolve)(value) : (0, import_node_path15.resolve)(runAbsolute, value);
