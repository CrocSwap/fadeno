function shouldRunPreflight(command2) {
  if (!command2) return false;
  const excluded = /* @__PURE__ */ new Set(["status", "doctor", "setup", "uninstall"]);
  if (excluded.has(command2)) return false;
  if (!KNOWN_CLI_COMMANDS.has(command2)) return false;
  return true;
}
function resolveRuntimeSyncCandidate(env, argv1, paths, manifest) {
  if (env.FADENO_BUNDLED_RUNTIME && (0, import_node_fs49.existsSync)((0, import_node_path50.join)(env.FADENO_BUNDLED_RUNTIME, "fadeno"))) {
    return { sourceDir: env.FADENO_BUNDLED_RUNTIME, trustSource: true };
  }
  if (argv1) {
    try {
      const dir = (0, import_node_path50.dirname)((0, import_node_path50.resolve)(argv1));
      const parent = (0, import_node_path50.dirname)(dir);
      const candidates = [(0, import_node_path50.join)(parent, ".claude-plugin", "plugin.json"), (0, import_node_path50.join)(parent, ".codex-plugin", "plugin.json")];
      let isFadeno = false;
      for (const cand of candidates) {
        try {
          if ((0, import_node_fs49.existsSync)(cand)) {
            const p = JSON.parse((0, import_node_fs49.readFileSync)(cand, "utf8"));
            if (p.name === "fadeno") {
              isFadeno = true;
              break;
            }
          }
        } catch {
        }
      }
      if (isFadeno && (0, import_node_fs49.existsSync)((0, import_node_path50.join)(dir, "fadeno"))) {
        return { sourceDir: dir, trustSource: true };
      }
    } catch {
    }
  }
  if (argv1) {
    try {
      const resolvedArgv = (0, import_node_path50.resolve)(argv1);
      const managedDir = (0, import_node_path50.resolve)(paths.managedRuntimeDir);
      const isManaged = resolvedArgv === (0, import_node_path50.resolve)(paths.managedCli) || (0, import_node_path50.dirname)(resolvedArgv) === managedDir || resolvedArgv.startsWith(managedDir + import_node_path50.sep);
      if (isManaged) {
        const src = manifest.runtime?.source;
        if (src && (0, import_node_fs49.existsSync)(src) && (0, import_node_fs49.existsSync)((0, import_node_path50.join)(src, "fadeno"))) {
          return { sourceDir: src, trustSource: false };
        }
        return null;
      }
    } catch {
    }
  }
  return null;
}
function maybeRunRuntimePreflight(_argv, command2, deps = {}) {
  if (!shouldRunPreflight(command2)) return;
  try {
    const env = deps.env ?? process.env;
    const argv1 = deps.argv1 ?? process.argv[1];
    const paths = deps.paths ?? userPaths();
    const manifest = deps.manifest ?? readInstallationManifest();
    const candidate = resolveRuntimeSyncCandidate(env, argv1, paths, manifest);
    if (!candidate) return;
    if (manifest.runtime == null) return;
    const sync = deps.syncFn ?? syncManagedRuntime;
    const res = sync(paths, candidate.sourceDir, manifest, {
      allowInstall: false,
      trustSource: candidate.trustSource,
      force: false
    });
    if (res.outcome === "refreshed") {
      console.error(`fadeno: managed runtime ${res.from} -> ${res.to} refreshed at ${paths.managedRuntimeDir}`);
    }
  } catch (err) {
    try {
      console.error(`fadeno: managed runtime sync warning: ${err.message}`);
    } catch {
    }
  }
}
