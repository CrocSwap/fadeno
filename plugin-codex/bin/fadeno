    emitBootstrap((0, import_node_path27.join)(repoRoot, bootstrapName), bootstrapBody, force, results);
  }
  if (opts.dataOnly && withSteering && opts.target === "codex") {
    results.push(...emitCodexSteeringBrokers({ repoRoot, force }));
  }
  if (opts.withHooks) emitHooks(tpl, repoRoot, opts.target, force, results);
  if (withSteering && opts.target === "claude") {
    const steeringPath = (0, import_node_path27.join)(repoRoot, CLAUDE_STEERING_SCRIPT);
    const steeringBody = stampHookVersion(
      (0, import_node_fs27.readFileSync)((0, import_node_path27.join)(tpl, "claude", "hooks", "dispatch-steering.mjs"), "utf8")
    );
