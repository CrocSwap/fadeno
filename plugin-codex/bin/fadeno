function settleIsolatedTerminalWorkspace(opts) {
  const evidence = inspectIsolatedEvidence(opts);
  const priorIsDegraded = opts.terminal != null && opts.terminal.type === "actor_failed" && opts.terminal.extra.diff_snapshot == null;
