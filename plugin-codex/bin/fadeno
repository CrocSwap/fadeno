function waitSync3(ms) {
  const sig = new Int32Array(new SharedArrayBuffer(4));
  Atomics.wait(sig, 0, 0, ms);
}
var LOCK_WAIT_MS3 = 10;
var LOCK_TIMEOUT_MS3 = 3e4;
function withHostWorkspaceLock(repoRoot, action) {
  const lockPath = (0, import_node_path12.join)(repoRoot, HOST_WORKSPACE_LOCK);
  (0, import_node_fs12.mkdirSync)((0, import_node_path12.dirname)(lockPath), { recursive: true });
  const started = Date.now();
  for (; ; ) {
    try {
      (0, import_node_fs12.mkdirSync)(lockPath);
      break;
    } catch (err) {
      if (err.code !== "EEXIST") throw err;
      let stale = false;
      try {
        stale = Date.now() - (0, import_node_fs12.statSync)(lockPath).mtimeMs > WORKSPACE_LEASE_LOCK_STALE_MS;
      } catch {
      }
      if (stale) {
        (0, import_node_fs12.rmSync)(lockPath, { recursive: true, force: true });
        continue;
      }
      if (Date.now() - started >= LOCK_TIMEOUT_MS3) {
        throw new HostWorkspaceError(`timed out waiting for the host workspace lock at ${lockPath}.`);
      }
      waitSync3(LOCK_WAIT_MS3);
    }
  }
  try {
    return action();
  } finally {
    (0, import_node_fs12.rmSync)(lockPath, { recursive: true, force: true });
  }
}
function validateSegment(value, label) {
  if (value === "." || value === "..") {
    throw new HostWorkspaceError(`invalid ${label}: must not be "." or ".."; got ${JSON.stringify(value)}`);
  }
  if (!HOST_WORKSPACE_SEGMENT_RE.test(value)) {
    throw new HostWorkspaceError(`invalid ${label}: must match ${HOST_WORKSPACE_SEGMENT_RE}; got ${JSON.stringify(value)}`);
  }
}
