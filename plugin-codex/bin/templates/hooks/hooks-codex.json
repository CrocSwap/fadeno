{
  "description": "Fadeno on Codex: in host mode, refuse generic subagents and mis-dialed spawns at PreToolUse, then open the dispatch and deliver its contract at SubagentStart, where the agent id makes the binding exact; guard dispatched agents' shell calls; record every subagent's stop; keep host mode on for one session.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*spawn_agent|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/spawn-codex.mjs",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|bash|shell|local_shell|exec_command|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/bash-guard.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/spawn-codex.mjs",
            "timeout": 60,
            "additionalContextLimit": 200000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/agent-stop.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/host-mode.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/host-mode.mjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/host-mode.mjs",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
