{
  "description": "Fadeno on Codex: in host mode, refuse generic subagents and hand archetype spawns to the command lane (a Codex hook can refuse a spawn but not rewrite one); guard dispatched agents' shell calls; record every subagent's stop; keep host mode on for one session.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/spawn-codex.mjs",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|bash|shell|local_shell|exec_command|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/bash-guard.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/agent-stop.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/host-mode.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/host-mode.mjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/host-mode.mjs",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
