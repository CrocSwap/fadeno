      try {
        (0, import_node_child_process6.spawnSync)("git", ["worktree", "remove", "--force", shadowWorktreeAbs], { cwd: repoRoot, encoding: "utf8" });
      } catch {
      }
      try {
        (0, import_node_child_process6.spawnSync)("git", ["worktree", "prune"], { cwd: repoRoot, encoding: "utf8" });
      } catch {
      }
    };
    let promptFd = null;
    let sfd = null;
    let reservationExpected = null;
    let requestRecorded = false;
    let childSpawned = false;
    const closePreparedDescriptors = () => {
      if (promptFd != null) {
        try {
          (0, import_node_fs10.closeSync)(promptFd);
        } catch {
        }
        promptFd = null;
      }
      if (sfd != null) {
        try {
          (0, import_node_fs10.closeSync)(sfd);
        } catch {
        }
        sfd = null;
      }
    };
    try {
      try {
        promptFd = (0, import_node_fs10.openSync)(promptFileAbs, "r");
      } catch {
        const fallbackAbs = (0, import_node_path10.join)(repoRoot, ".fadeno", "local", "prompts", `shadow-${shadowId8}.md`);
        (0, import_node_fs10.mkdirSync)((0, import_node_path10.join)(repoRoot, ".fadeno", "local", "prompts"), { recursive: true });
