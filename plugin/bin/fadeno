}
function runningCli(env) {
  const bundled = env.FADENO_BUNDLED_RUNTIME?.trim();
  if (bundled && (0, import_node_fs15.existsSync)((0, import_node_path14.join)(bundled, "fadeno"))) return (0, import_node_path14.join)(bundled, "fadeno");
  const argv1 = process.argv[1];
  if (argv1 == null) return null;
  try {
    return (0, import_node_fs15.realpathSync)((0, import_node_path14.resolve)(argv1));
  } catch {
    return (0, import_node_path14.resolve)(argv1);
  }
}
function onPath(dir, env) {
  const entries = (env.PATH ?? "").split(import_node_path14.delimiter).filter((part) => part.length > 0);
  return entries.some((entry) => {
    try {
      return (0, import_node_fs15.realpathSync)(entry) === (0, import_node_fs15.realpathSync)(dir);
    } catch {
      return (0, import_node_path14.resolve)(entry) === (0, import_node_path14.resolve)(dir);
    }
  });
}
function windowsShim(target) {
  return ["@echo off", `"${process.execPath}" "${target}" %*`, ""].join("\r\n");
}
function linkCli(paths, target, options, force) {
  const windows = (options?.platform ?? process.platform) === "win32";
  const path = paths.linkPath;
  (0, import_node_fs15.mkdirSync)(paths.binDir, { recursive: true });
  const env = options?.env ?? process.env;
  const FOREIGN = " foreign";
  const current = (() => {
    try {
      const stat = (0, import_node_fs15.lstatSync)(path);
      if (windows) return stat.isFile() ? (0, import_node_fs15.readFileSync)(path, "utf8") : FOREIGN;
      return stat.isSymbolicLink() ? (0, import_node_fs15.readlinkSync)(path) : FOREIGN;
    } catch {
      return null;
    }
  })();
  const want = windows ? windowsShim(target) : target;
  if (current === want) return { path, target, action: "unchanged", onPath: onPath(paths.binDir, env) };
  if (current === FOREIGN && !force) {
    throw new SetupError(
      `${path} exists and is not something Fadeno wrote. Remove it, choose another directory with FADENO_BIN_DIR, or rerun with --force to replace it.`
    );
  }
  if (current != null) (0, import_node_fs15.rmSync)(path, { force: true });
  if (windows) (0, import_node_fs15.writeFileSync)(path, want, "utf8");
  else (0, import_node_fs15.symlinkSync)(target, path);
  return { path, target, action: current == null ? "created" : "retargeted", onPath: onPath(paths.binDir, env) };
}
function ensureClaudePermission(options, notices) {
  const env = options?.env ?? process.env;
  const settingsPath = (0, import_node_path14.join)(env.CLAUDE_CONFIG_DIR?.trim() || (0, import_node_path14.join)(options?.home ?? (0, import_node_os2.homedir)(), ".claude"), "settings.json");
  let data = {};
  if ((0, import_node_fs15.existsSync)(settingsPath)) {
    try {
      const parsed = JSON.parse((0, import_node_fs15.readFileSync)(settingsPath, "utf8"));
      if (parsed == null || typeof parsed !== "object" || Array.isArray(parsed)) {
        notices.push(`Claude user settings ${settingsPath} are not an object; permission setup left them untouched.`);
        return null;
      }
      data = parsed;
    } catch {
      notices.push(`Claude user settings ${settingsPath} are malformed; permission setup left them untouched.`);
      return null;
    }
  }
  const permissions = data.permissions == null ? {} : typeof data.permissions === "object" && !Array.isArray(data.permissions) ? data.permissions : null;
  if (permissions == null || permissions.allow != null && !Array.isArray(permissions.allow)) {
    notices.push(`Claude permission settings in ${settingsPath} have an unexpected shape; they were left untouched.`);
    return null;
  }
  const allow = [...permissions.allow ?? []];
  const rule = "Bash(fadeno:*)";
  if (allow.includes(rule)) return { path: settingsPath, rule };
  allow.push(rule);
  permissions.allow = allow;
  data.permissions = permissions;
  (0, import_node_fs15.mkdirSync)((0, import_node_path14.dirname)(settingsPath), { recursive: true });
  (0, import_node_fs15.writeFileSync)(settingsPath, `${JSON.stringify(data, null, 2)}
`, "utf8");
  notices.push(`Claude user permission added so agents can run the CLI without a prompt each time: ${rule} in ${settingsPath}`);
  return { path: settingsPath, rule };
}
function runSetup(opts = {}) {
  const repoRoot = opts.repoRoot ?? findRepoRoot(opts.cwd ?? process.cwd());
  const paths = userPaths(opts.userPathOptions);
  const env = opts.userPathOptions?.env ?? process.env;
  const probeCommand = opts.probeCommand ?? probe;
  const probes = PROBES.map((item) => probeCommand(item.command));
  const notices = [];
  try {
    loadExecutorProfile(repoRoot, opts.userPathOptions).profile;
  } catch (err) {
    throw new SetupError(err.message);
  }
  const source = opts.source !== void 0 ? opts.source : runningCli(env);
  if (source == null || !(0, import_node_fs15.existsSync)(source)) {
    throw new SetupError(
      `cannot find the CLI to link${source == null ? "" : ` at ${source}`} \u2014 run \`fadeno setup\` from the plugin's own CLI, or pass --from <bin-dir>.`
    );
  }
  const link = linkCli(paths, source, opts.userPathOptions, opts.force ?? false);
  const removed = [...sweepRetiredState(paths), ...sweepManagedAgents(repoRoot, opts.userPathOptions)];
  const permission = opts.target === "claude" ? ensureClaudePermission(opts.userPathOptions, notices) : null;
  notices.unshift(
    `Fadeno ${packageVersion()} linked at ${link.path} -> ${link.target}. It is a link, not a copy: \`fadeno\` runs whatever is at that path, so there is no second CLI to keep in step. Run setup from the plugin's own launcher to point it at the plugin instead.`
  );
  if (!link.onPath) {
    notices.push(`${paths.binDir} is not on this shell's PATH \u2014 add it, or the \`fadeno\` command will not be found.`);
  }
  notices.push(`User configuration and state live under ${paths.configDir} and ${paths.stateDir}; project files were not changed.`);
  for (const path of removed) {
    notices.push(
      path.endsWith(".toml") ? `Removed the agent file ${path}, which an earlier Fadeno materialized. Nothing writes one now, and on Codex a stale one overrides the dial.` : `Removed retired state ${path} (nothing reads it).`
    );
  }
  notices.push("Skills and subagents are loaded at host session start; a fresh session is required to pick up a new plugin version.");
  return { target: opts.target ?? null, repoRoot, paths, probes, link, removed, permission, notices };
}

// src/commands/status.ts
var import_node_fs16 = require("node:fs");
var import_node_os3 = require("node:os");
var import_node_path15 = require("node:path");
var StatusError = class extends Error {
};
function linkState(path) {
  try {
    const stat = (0, import_node_fs16.lstatSync)(path);
    if (!stat.isSymbolicLink()) return { path, target: null, state: "foreign" };
    const target = (0, import_node_fs16.readlinkSync)(path);
    return { path, target, state: (0, import_node_fs16.existsSync)(target) ? "linked" : "foreign" };
  } catch {
    return { path, target: null, state: "missing" };
  }
}
function declaredAgentName(path, ext) {
  const fallback = (0, import_node_path15.basename)(path, ext);
  let text;
  try {
    text = (0, import_node_fs16.readFileSync)(path, "utf8").slice(0, 4096);
  } catch {
    return fallback;
  }
  const declared = ext === ".toml" ? /^\s*name\s*=\s*["']([^"'\n]+)["']/m.exec(text) : /^name:\s*([^\n]+)$/m.exec(text);
  return declared?.[1]?.trim() || fallback;
}
function shadowingAgentFiles(repoRoot, archetypes, options) {
  const home = options?.home ?? (0, import_node_os3.homedir)();
  const env = options?.env ?? process.env;
  const claudeHome = env.CLAUDE_CONFIG_DIR?.trim() || (0, import_node_path15.join)(home, ".claude");
  const roots = [
    { dir: (0, import_node_path15.join)(claudeHome, "agents"), harness: "claude", scope: "user", ext: ".md" },
    { dir: (0, import_node_path15.join)(repoRoot, ".claude", "agents"), harness: "claude", scope: "project", ext: ".md" },
    { dir: codexUserAgentDir(options), harness: "codex", scope: "user", ext: ".toml" },
    { dir: (0, import_node_path15.join)(repoRoot, ".codex", "agents"), harness: "codex", scope: "project", ext: ".toml" }
  ];
  const routed = /* @__PURE__ */ new Set([...archetypes, "dispatch"]);
  const found = [];
  for (const root of roots) {
    let entries;
    try {
      entries = (0, import_node_fs16.readdirSync)(root.dir).sort();
    } catch {
      continue;
    }
    for (const entry of entries) {
      if (!entry.endsWith(root.ext)) continue;
      const path = (0, import_node_path15.join)(root.dir, entry);
      const archetype = declaredAgentName(path, root.ext);
      if (!routed.has(archetype)) continue;
      found.push({ path, archetype, harness: root.harness, scope: root.scope });
    }
  }
  return found;
}
function holdsWork(tree) {
  if (tree.dirty === "unavailable" || tree.unmerged === "unavailable") return true;
  return tree.dirty.paths.length > 0 || tree.unmerged > 0;
}
function runStatus(opts = {}) {
  const repoRoot = opts.repoRoot ?? findRepoRoot(opts.cwd ?? process.cwd());
  const harness = activeHarness(opts.target ?? void 0, opts.userPathOptions);
  let shown;
  try {
    shown = runDialShow({ repoRoot, userPathOptions: opts.userPathOptions });
  } catch (err) {
    throw new StatusError(err.message);
  }
  const link = linkState(userPaths(opts.userPathOptions).linkPath);
  const agentFiles = shadowingAgentFiles(repoRoot, shown.rows.map((row) => row.archetype), opts.userPathOptions);
  const worktrees = runWorktrees({ repoRoot }).filter(holdsWork);
  const unclosed = unclosedDispatches(repoRoot).length;
  const attention = [];
  for (const stale of shown.staleDials) {
    attention.push(`${stale.archetype} does not resolve \u2014 ${stale.reason}`);
  }
  for (const row of shown.rows) {
    if (row.deliverable) continue;
    attention.push(
      `${row.archetype} has no lane from here: it routes to ${row.model}, which this session can neither deliver in-session nor run as a process.`
    );
  }
  if (link.state === "missing") {
    attention.push(`no \`fadeno\` linked at ${link.path} \u2014 run \`fadeno setup\` to link it onto PATH.`);
  } else if (link.state === "foreign") {
    attention.push(`${link.path} is not a link Fadeno wrote, or points at a CLI that is gone \u2014 rerun \`fadeno setup\`.`);
  }
  for (const file of agentFiles) {
    attention.push(
      `${file.path} defines the agent "${file.archetype}" (${file.scope} scope, ${file.harness}). ` + (file.harness === "codex" ? "A Codex agent file wins over the model a spawn passes, so it overrides the dial." : "It supplies the prompt and tools for that spawn, whatever the dial says.")
    );
  }
  if (worktrees.length > 0) {
    attention.push(`${worktrees.length} worktree(s) hold work that is not on HEAD \u2014 \`fadeno worktrees\` lists them.`);
  }
  if (unclosed > 0) {
    attention.push(`${unclosed} dispatch(es) are still open \u2014 \`fadeno dispatches\` lists them.`);
  }
  return {
    repoRoot,
    version: packageVersion(),
    harness,
    routing: shown.rows,
    unresolved: shown.staleDials,
    link,
    agentFiles,
    worktrees,
    unclosed,
    projectCustomized: (0, import_node_fs16.existsSync)((0, import_node_path15.join)(repoRoot, ".fadeno")),
    verbose: Boolean(opts.verbose),
    attention
  };
}

