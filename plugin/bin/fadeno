// src/lib/fsutil.ts
var import_node_fs12 = require("node:fs");
var import_node_path11 = require("node:path");
function emitFile(absPath, content, force) {
  const exists = (0, import_node_fs12.existsSync)(absPath);
  if (exists && !force) return "skipped";
  (0, import_node_fs12.mkdirSync)((0, import_node_path11.dirname)(absPath), { recursive: true });
  (0, import_node_fs12.writeFileSync)(absPath, content, "utf8");
  return exists ? "overwritten" : "created";
}
function copyTree(srcDir, destDir, force, results) {
  for (const entry of (0, import_node_fs12.readdirSync)(srcDir, { withFileTypes: true })) {
    const srcPath = (0, import_node_path11.join)(srcDir, entry.name);
    const destName = entry.name === "gitkeep" ? ".gitkeep" : entry.name;
    const destPath = (0, import_node_path11.join)(destDir, destName);
    if (entry.isDirectory()) {
      copyTree(srcPath, destPath, force, results);
    } else {
      const content = (0, import_node_fs12.readFileSync)(srcPath, "utf8");
      results.push({ path: destPath, status: emitFile(destPath, content, force) });
    }
  }
}

