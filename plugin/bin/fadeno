].join("\n");
function scanDispatchResultClaim(stdout) {
  const lines = stdout.split("\n");
  for (let i = lines.length - 1; i >= 0; i -= 1) {
    const match = /^FADENO-DISPATCH-RESULT: (ok|failed)(?: — .*)?$/.exec(lines[i]);
    if (match != null) return match[1];
  }
  return null;
}
function deriveDispatchOutcome(row, claimed) {
  if (row.timedOut === true) return "timeout";
  if (row.error != null || row.signal != null) return "failed";
  if (row.exitCode == null) return null;
  if (row.exitCode !== 0) return "failed";
  if (claimed === "ok" || claimed === "failed") return claimed;
  if (row.outputBytes == null) return null;
  return row.outputBytes === 0 ? "empty" : "ok";
}
function normalizeDispatchOutcome(stated, row) {
  if (typeof stated === "string" && DISPATCH_OUTCOMES.includes(stated)) return stated;
  return deriveDispatchOutcome(row);
}
var PENDING_RELAYS_FILE = (0, import_node_path10.join)(".fadeno", "local", "pending-relays.jsonl");
function uncommittedTrackedChanges(repoRoot) {
  try {
    const headRes = (0, import_node_child_process6.spawnSync)("git", ["-C", repoRoot, "rev-parse", "HEAD"], { encoding: "utf8" });
    const statusRes = (0, import_node_child_process6.spawnSync)("git", ["-C", repoRoot, "status", "--porcelain"], { encoding: "utf8" });
    if (headRes.error != null || headRes.status !== 0 || statusRes.error != null || statusRes.status !== 0) {
      return { head: null, count: 0 };
    }
    const count = String(statusRes.stdout ?? "").split("\n").filter((line) => line.length > 0 && !line.startsWith("?")).length;
    return { head: String(headRes.stdout ?? "").trim() || null, count };
  } catch {
    return { head: null, count: 0 };
  }
}
var PROXY_DISPATCHES_FILE = (0, import_node_path10.join)(".fadeno", "local", "proxy-dispatches.jsonl");
var PENDING_RELAY_MAX_AGE_MS = 60 * 60 * 1e3;
function attestationDigests(prompt) {
  return /* @__PURE__ */ new Set([callerPromptDigest(prompt), sha256Hex(prompt)]);
}
function matchMarkerFile(repoRoot, file, prompt, now) {
  const path = (0, import_node_path10.join)(repoRoot, file);
  if (!(0, import_node_fs10.existsSync)(path)) return null;
  let rows;
  try {
    rows = spawnMarkerLines((0, import_node_fs10.readFileSync)(path, "utf8"));
  } catch {
    return null;
  }
  const fresh = rows.filter((row) => spawnMarkerIsFresh(row, now, PENDING_RELAY_MAX_AGE_MS));
  const digests = attestationDigests(prompt);
  const index = fresh.findIndex((row) => digests.has(spawnMarkerRow(row).prompt_sha256));
  return {
    hit: index !== -1,
    fresh: fresh.length,
    settle: (dropHit) => {
      const remaining = dropHit && index !== -1 ? fresh.filter((_, i) => i !== index) : fresh;
      try {
        if (remaining.length === 0) (0, import_node_fs10.rmSync)(path, { force: true });
        else (0, import_node_fs10.writeFileSync)(path, `${remaining.map((row) => JSON.stringify(row)).join("\n")}
`, "utf8");
      } catch {
      }
    }
  };
}
function readRelayAttestation(repoRoot, prompt, now) {
  const proxy = matchMarkerFile(repoRoot, PROXY_DISPATCHES_FILE, prompt, now);
  if (proxy == null) return { verdict: null, settle: () => {
  } };
  if (!proxy.hit) {
    proxy.settle(false);
    return { verdict: null, settle: () => {
    } };
  }
  const spawnSide = matchMarkerFile(repoRoot, PENDING_RELAYS_FILE, prompt, now);
  if (spawnSide == null) {
    return { verdict: null, settle: () => proxy.settle(true) };
  }
  const verdict = spawnSide.hit ? true : spawnSide.fresh > 0 ? false : null;
  return {
    verdict,
    settle: () => {
      proxy.settle(true);
      spawnSide.settle(true);
    }
  };
}
var SPAWN_MAX_BUFFER3 = 32 * 1024 * 1024;
function retainExecutorStderr(opts) {
  const bytes = Buffer.byteLength(opts.stderr, "utf8");
  if (bytes === 0) return NO_EXECUTOR_TRANSCRIPT;
  const body = truncateTranscript(opts.stderr);
  const truncated = body !== opts.stderr;
  const abs = (0, import_node_path10.join)(opts.repoRoot, ...opts.rel.split("/"));
  try {
    (0, import_node_fs10.mkdirSync)((0, import_node_path10.dirname)(abs), { recursive: true });
    const tmp = `${abs}.tmp-${process.pid}-${(0, import_node_crypto5.randomUUID)()}`;
    (0, import_node_fs10.writeFileSync)(tmp, body, "utf8");
    try {
      (0, import_node_fs10.renameSync)(tmp, abs);
    } catch (err) {
      try {
        (0, import_node_fs10.rmSync)(tmp, { force: true });
      } catch {
      }
      throw err;
    }
  } catch (err) {
    return { path: null, bytes, truncated: false, note: err.message };
  }
  return { path: opts.rel, bytes, truncated, note: null };
}
var RELAY_FIDELITY_DIAGNOSIS = "RELAY FIDELITY FAILED: a dispatch proxy sent bytes that do not match what it was handed. An executor run on these bytes is answering a different question than the one that was asked.";
