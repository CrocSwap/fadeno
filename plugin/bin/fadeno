var import_node_child_process4 = require("node:child_process");
var DISPATCH_WINDOWS_FILE = (0, import_node_path7.join)(".fadeno", "local", "dispatch-windows.jsonl");
var WINDOW_MAX_PATHS = 2e3;
var OVERLAP_MAX_EXAMPLES = 20;
