// src/lib/model-listing.ts
function listingPrefixOf(entry) {
  const prefix = entry?.models_prefix ?? entry?.modelsPrefix;
  return prefix != null && prefix.length > 0 ? prefix : null;
}
function parseListedIds(stdout) {
  const seen = /* @__PURE__ */ new Set();
  const ids = [];
  for (const id of stdout.split(/\r?\n/).map((line) => line.split("	")[0].trim()).filter((candidate) => candidate.length > 0 && !/\s/.test(candidate))) {
    if (!seen.has(id)) {
      seen.add(id);
      ids.push(id);
    }
  }
  return ids;
}
function listingContains(listing, modelId) {
  return listing.ids.includes(qualifyListedModelId({ ...listing.prefix != null ? { modelsPrefix: listing.prefix } : {} }, modelId));
}

