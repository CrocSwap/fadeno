function carriesManagedMarker(path) {
  let text2;
  try {
    text2 = (0, import_node_fs28.readFileSync)(path, "utf8");
  } catch {
    return false;
  }
  return text2.startsWith("# fadeno:managed") || isRetiredClaudeGridCell(text2);
