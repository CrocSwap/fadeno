var DIALS_SCHEMA_VERSION = 1;
var UserDialsError = class extends Error {
};
function unwrapUserDials(doc, path) {
  const stamp = doc.schema_version;
  if (typeof stamp !== "number") return { map: doc, problem: null };
  if (stamp > DIALS_SCHEMA_VERSION) {
    throw new UserDialsError(
      `user dials at ${path} are schema_version ${stamp}; this fadeno reads ${DIALS_SCHEMA_VERSION}. Upgrade fadeno, or move the file aside and re-set your dials with \`fadeno dial\`.`
    );
  }
  const nested = doc.dials;
  if (nested == null || typeof nested !== "object" || Array.isArray(nested)) {
    return {
      map: {},
      problem: `carries schema_version ${stamp} but no \`dials\` mapping, so it yields no dials at all`
    };
  }
  return { map: nested, problem: null };
}
function interpretUserDials(doc, path) {
  const unwrapped = unwrapUserDials(doc, path);
  const problems = unwrapped.problem != null ? [unwrapped.problem] : [];
  let fatal = null;
  const out = {};
  for (const [k, v] of Object.entries(unwrapped.map)) {
    if (typeof v === "string") {
      const trimmed = v.trim();
      if (trimmed.length === 0) {
        problems.push(`dial "${k}" is an empty string`);
        continue;
      }
      let ref;
      try {
        ref = parseDialRef(trimmed, `user dial "${k}"`);
      } catch (err) {
        problems.push(`dial "${k}" is not a dial ref (${err.message})`);
        continue;
      }
      out[k] = ref;
    } else if (v != null && typeof v === "object" && !Array.isArray(v)) {
      const map = v;
      const model = typeof map.model === "string" ? map.model.trim() : "";
      if (model.length === 0) {
        problems.push(`dial "${k}" is a mapping with no \`model\``);
        continue;
      }
      if (map.force_write_posture !== void 0) {
        const message = `user dial "${k}" in ${path} carries "force_write_posture", which is no longer supported \u2014 there is no write-posture guard left to override. Remove the key (the dial's model/effort/harness are still valid) or re-set the dial with \`fadeno dial\`. See docs/experimental/permissions-and-isolation.md.`;
        problems.push(message);
        fatal ??= message;
        continue;
      }
      const entry = { model };
      if (typeof map.effort === "string" && map.effort.trim().length > 0) entry.effort = map.effort.trim();
      if (typeof map.harness === "string" && map.harness.trim().length > 0) entry.harness = map.harness.trim();
      else if (typeof map.via === "string" && map.via.trim().length > 0) entry.harness = legacyDriverHarness(map.via.trim());
      out[k] = entry;
    } else {
      problems.push(`dial "${k}" is ${v === null ? "null" : Array.isArray(v) ? "an array" : `a ${typeof v}`}, not a dial ref`);
    }
  }
  return { dials: out, problems, fatal };
}
function readUserDials(options = {}) {
  const path = userPaths(options).dialsFile;
  if (!(0, import_node_fs2.existsSync)(path)) return {};
  const text2 = (0, import_node_fs2.readFileSync)(path, "utf8").trim();
  if (text2.length === 0) return {};
  let doc;
  try {
    doc = JSON.parse(text2);
  } catch {
    return {};
  }
  if (doc == null || typeof doc !== "object" || Array.isArray(doc)) return {};
  const reading = interpretUserDials(doc, path);
  if (reading.fatal != null) throw new UserDialsError(reading.fatal);
  return reading.dials;
}
function writeUserDials(options, dials) {
  const path = userPaths(options).dialsFile;
  const keys = Object.keys(dials).sort();
  if (keys.length === 0) {
    if ((0, import_node_fs2.existsSync)(path)) (0, import_node_fs2.unlinkSync)(path);
    return path;
  }
  const sorted = {};
  for (const k of keys) {
    sorted[k] = formatDialRef(dials[k]);
  }
  const ordered = {};
  for (const k of Object.keys(sorted).sort()) ordered[k] = sorted[k];
  writeUserFileAtomic(path, `${JSON.stringify({ schema_version: DIALS_SCHEMA_VERSION, dials: ordered })}
`);
  return path;
}
var MODEL_VERIFICATIONS_SCHEMA_VERSION = 1;
function interpretVerificationDocument(parsed) {
  if (Array.isArray(parsed)) return { rows: parsed, understood: true, problem: null };
  if (parsed == null || typeof parsed !== "object") {
    return { rows: [], understood: false, problem: "is not a JSON array or object" };
  }
  const doc = parsed;
  const stamp = doc.schema_version;
  if (typeof stamp !== "number") {
    return { rows: [], understood: false, problem: `is an object with schema_version ${JSON.stringify(stamp)}, which is not a number` };
  }
  if (stamp > MODEL_VERIFICATIONS_SCHEMA_VERSION) {
    return { rows: [], understood: false, problem: `has schema_version ${stamp}; this fadeno reads ${MODEL_VERIFICATIONS_SCHEMA_VERSION}` };
  }
  const rows = doc.verifications;
  if (!Array.isArray(rows)) {
    return { rows: [], understood: false, problem: `carries schema_version ${stamp} but no \`verifications\` array, so it yields no cached rows at all` };
  }
  return { rows, understood: true, problem: null };
}
function verificationRow(entry) {
  if (entry == null || typeof entry !== "object" || Array.isArray(entry)) return null;
  const map = entry;
  const harness = typeof map.harness === "string" ? map.harness : typeof map.driver === "string" ? legacyDriverHarness(map.driver) : null;
  if (harness == null || typeof map.model !== "string" || typeof map.verified_at !== "string") return null;
  return { harness, model: map.model, verified_at: map.verified_at };
}
function readVerificationDocument(path) {
  if (!(0, import_node_fs2.existsSync)(path)) return { rows: [], understood: true };
  const text2 = (0, import_node_fs2.readFileSync)(path, "utf8").trim();
  if (text2.length === 0) return { rows: [], understood: true };
  let parsed;
  try {
    parsed = JSON.parse(text2);
  } catch {
    return { rows: [], understood: false };
  }
  const read = interpretVerificationDocument(parsed);
  return { rows: read.rows, understood: read.understood };
}
function readVerifiedModels(options = {}) {
  const path = userPaths(options).modelVerificationsFile;
  const out = [];
  for (const entry of readVerificationDocument(path).rows) {
    const row = verificationRow(entry);
    if (row == null) continue;
    out.push(row);
  }
  out.sort((a, b) => {
    if (a.harness !== b.harness) return a.harness.localeCompare(b.harness);
    return a.model.localeCompare(b.model);
  });
  return out;
}
function isModelVerified(options, harness, model) {
  const list = readVerifiedModels(options);
  return list.some((e) => e.harness === harness && e.model === model);
}
function recordVerifiedModel(options, entry) {
  const path = userPaths(options).modelVerificationsFile;
  if (!readVerificationDocument(path).understood) return;
  const existing = readVerifiedModels(options);
  if (existing.some((e) => e.harness === entry.harness && e.model === entry.model)) return;
  const next = [...existing, entry];
  next.sort((a, b) => {
    if (a.harness !== b.harness) return a.harness.localeCompare(b.harness);
    return a.model.localeCompare(b.model);
  });
  writeUserFileAtomic(
    path,
    `${JSON.stringify({ schema_version: MODEL_VERIFICATIONS_SCHEMA_VERSION, verifications: next })}
`
  );
}
function removeVerifiedModels(options, predicate) {
  const path = userPaths(options).modelVerificationsFile;
  const existing = readVerifiedModels(options);
  const kept = existing.filter((entry) => !predicate(entry));
  const removed = existing.length - kept.length;
  if (removed === 0) return 0;
  writeUserFileAtomic(
    path,
    `${JSON.stringify({ schema_version: MODEL_VERIFICATIONS_SCHEMA_VERSION, verifications: kept })}
`
  );
  return removed;
}
function codexUserAgentDir(options = {}) {
  const env = options.env ?? process.env;
  const home = options.home ?? (0, import_node_os.homedir)();
  return (0, import_node_path2.join)(env.CODEX_HOME?.trim() || (0, import_node_path2.join)(home, ".codex"), "agents");
}

