  if (existed) {
    const existing = (0, import_node_fs18.readFileSync)(path, "utf8");
    if (!existing.includes(OMP_MANAGED_MARK)) return "skipped";
    if (!force && existing === body) return "skipped";
  }
  (0, import_node_fs18.mkdirSync)((0, import_node_path18.join)(path, ".."), { recursive: true });
  (0, import_node_fs18.writeFileSync)(path, body, "utf8");
  return existed ? "overwritten" : "created";
}
