function emitFile(absPath, content, force) {
  const exists = (0, import_node_fs5.existsSync)(absPath);
  if (exists && !force) return "skipped";
  (0, import_node_fs5.mkdirSync)((0, import_node_path5.dirname)(absPath), { recursive: true });
  (0, import_node_fs5.writeFileSync)(absPath, content, "utf8");
  return exists ? "overwritten" : "created";
}
function copyTree(srcDir, destDir, force, results) {
  for (const entry of (0, import_node_fs5.readdirSync)(srcDir, { withFileTypes: true })) {
    const srcPath = (0, import_node_path5.join)(srcDir, entry.name);
    const destName = entry.name === "gitkeep" ? ".gitkeep" : entry.name;
    const destPath = (0, import_node_path5.join)(destDir, destName);
    if (entry.isDirectory()) {
      copyTree(srcPath, destPath, force, results);
    } else {
      const content = (0, import_node_fs5.readFileSync)(srcPath, "utf8");
      results.push({ path: destPath, status: emitFile(destPath, content, force) });
    }
  }
}
var FADENO_BEGIN = "<!-- fadeno:begin (managed by fadeno init \u2014 edit above/below, not inside) -->";
var FADENO_END = "<!-- fadeno:end -->";
function escapeRegExp(value) {
  return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}
function emitBootstrap(absPath, section, force, results) {
  const block = `${FADENO_BEGIN}

${section.trim()}

${FADENO_END}
`;
  if (!(0, import_node_fs5.existsSync)(absPath)) {
    (0, import_node_fs5.mkdirSync)((0, import_node_path5.dirname)(absPath), { recursive: true });
    (0, import_node_fs5.writeFileSync)(absPath, block, "utf8");
    results.push({ path: absPath, status: "created" });
    return;
  }
  const existing = (0, import_node_fs5.readFileSync)(absPath, "utf8");
  const hasBlock = existing.includes(FADENO_BEGIN);
  if (hasBlock) {
    if (!force) {
      results.push({ path: absPath, status: "skipped" });
      return;
    }
    const blockRe = new RegExp(
      `${escapeRegExp(FADENO_BEGIN)}[\\s\\S]*?${escapeRegExp(FADENO_END)}\\n?`
    );
    (0, import_node_fs5.writeFileSync)(absPath, existing.replace(blockRe, block), "utf8");
    results.push({ path: absPath, status: "overwritten" });
    return;
  }
  const separator = existing.endsWith("\n") ? "\n" : "\n\n";
  (0, import_node_fs5.writeFileSync)(absPath, existing + separator + block, "utf8");
  results.push({ path: absPath, status: "appended" });
}
function sha256Hex(data) {
  return (0, import_node_crypto2.createHash)("sha256").update(data).digest("hex");
}

