// src/lib/diagnostics.ts
var DIAGNOSTICS_MAX_BYTES = 32 * 1024;
var DIAGNOSTICS_MAX_LINES = 500;
function diagnosticsTruncationMarker(stream) {
  return `
\u2026[fadeno diagnostics truncated: ${stream} exceeded 32 KiB / 500 lines]\u2026
`;
}
function truncateDiagnostics(text2, stream) {
  return sampleHeadTail(text2, {
    maxBytes: DIAGNOSTICS_MAX_BYTES,
    maxLines: DIAGNOSTICS_MAX_LINES,
    marker: diagnosticsTruncationMarker(stream)
  });
}
function sampleHeadTail(text2, opts) {
  const { maxBytes, maxLines, marker } = opts;
  const byteLen = Buffer.byteLength(text2, "utf8");
  const lines = text2.split("\n");
  const lineCount = text2 === "" ? 0 : lines.length;
  if (byteLen <= maxBytes && lineCount <= maxLines) return text2;
  const contentLineBudget = Math.min(lineCount, maxLines - 1);
  const headLineCount = lineCount === 1 ? 0 : Math.floor(contentLineBudget / 2);
  const tailLineCount = lineCount === 1 ? 0 : contentLineBudget - headLineCount;
  const headSource = lineCount === 1 ? text2 : lines.slice(0, headLineCount).join("\n");
  const tailSource = lineCount === 1 ? text2 : lines.slice(lineCount - tailLineCount).join("\n");
  const contentByteBudget = Math.max(0, maxBytes - Buffer.byteLength(marker, "utf8"));
  const headBudget = Math.floor(contentByteBudget / 2);
  const tailBudget = contentByteBudget - headBudget;
  const head = utf8Prefix(headSource, headBudget);
  const tail = utf8Suffix(tailSource, tailBudget);
  return head + marker + tail;
}
function utf8Prefix(text2, maxBytes) {
  const buf = Buffer.from(text2, "utf8");
  if (buf.length <= maxBytes) return text2;
  let end = maxBytes;
  while (end > 0 && (buf[end] & 192) === 128) end--;
  return buf.subarray(0, end).toString("utf8");
}
function utf8Suffix(text2, maxBytes) {
  const buf = Buffer.from(text2, "utf8");
  if (buf.length <= maxBytes) return text2;
  let start = buf.length - maxBytes;
  while (start < buf.length && (buf[start] & 192) === 128) start++;
  return buf.subarray(start).toString("utf8");
}
function isDiagnosticsEnabled(opts) {
  if (opts.diagnostics === true) return true;
  return process.env.FADENO_DIAGNOSTICS === "1";
}
var TRANSCRIPT_MAX_BYTES = 4 * 1024 * 1024;
var TRANSCRIPT_MAX_LINES = 1e5;
var INLINE_STDERR_MAX_BYTES = 4 * 1024;
var INLINE_STDERR_MAX_LINES = 40;
var NO_EXECUTOR_TRANSCRIPT = {
  path: null,
  bytes: 0,
  truncated: false,
  note: null
};
function transcriptTruncationMarker() {
  return `
\u2026[fadeno transcript truncated: the executor's stderr exceeded ${TRANSCRIPT_MAX_BYTES / (1024 * 1024)} MiB / ${TRANSCRIPT_MAX_LINES} lines; what follows the marker is the tail. This file is a head+tail sample \u2014 a floor, not the set]\u2026
`;
}
function truncateTranscript(text2) {
  return sampleHeadTail(text2, {
    maxBytes: TRANSCRIPT_MAX_BYTES,
    maxLines: TRANSCRIPT_MAX_LINES,
    marker: transcriptTruncationMarker()
  });
}
function executorTranscriptNotice(transcript) {
  if (transcript.bytes === 0) return null;
  if (transcript.path == null) {
    return `executor stderr: ${transcript.bytes} bytes could NOT be retained (${transcript.note ?? "reason unrecorded"}); a bounded excerpt is all that survives this process.`;
  }
  return `executor stderr: ${transcript.bytes} bytes \u2192 ${transcript.path}` + (transcript.truncated ? " (a head+tail sample; a floor, not the set)" : "");
}
function renderExecutorStderr(opts) {
  const { stderr, transcript } = opts;
  if (stderr.length === 0) {
    return opts.actionable ? "executor stderr: none \u2014 the executor wrote nothing to stderr.\n" : null;
  }
  if (!opts.actionable && transcript.path != null) return null;
  const rest = transcript.path == null ? `retention FAILED (${transcript.note ?? "reason unrecorded"}), so the rest of it is gone` : transcript.truncated ? `the transcript at ${transcript.path} holds a head+tail sample of all ${transcript.bytes} bytes \u2014 itself a floor, not the set` : `all ${transcript.bytes} bytes are at ${transcript.path}`;
  const marker = `
\u2026[fadeno excerpt: a head+tail sample of the executor's stderr, not the set \u2014 ${rest}]\u2026
`;
  const body = sampleHeadTail(stderr, {
    maxBytes: INLINE_STDERR_MAX_BYTES,
    maxLines: INLINE_STDERR_MAX_LINES,
    marker
  });
  const trailer = body.includes(marker) ? "" : `
\u2026[fadeno: ${rest}]\u2026
`;
  return `${body.endsWith("\n") ? body : `${body}
`}${trailer}`;
}

