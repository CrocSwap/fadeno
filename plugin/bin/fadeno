var UnvendorError = class extends Error {
};
function digest3(path) {
  return (0, import_node_crypto13.createHash)("sha256").update((0, import_node_fs30.readFileSync)(path)).digest("hex");
}
function runUnvendor(opts = {}) {
  const repoRoot = opts.repoRoot ?? findRepoRoot(opts.cwd ?? process.cwd());
  const lockPath = (0, import_node_path30.join)(repoRoot, "fadeno.lock");
  if (!(0, import_node_fs30.existsSync)(lockPath)) throw new UnvendorError("fadeno.lock is missing; refusing an ownership-blind unvendor.");
  const lock = JSON.parse((0, import_node_fs30.readFileSync)(lockPath, "utf8"));
  if (lock.files == null) throw new UnvendorError("fadeno.lock predates managed file ownership; re-run `fadeno vendor --force` first.");
  const removed = [];
  const preserved = [];
  for (const [rel, expected] of Object.entries(lock.files)) {
    const path = (0, import_node_path30.resolve)(repoRoot, rel);
    const back = (0, import_node_path30.relative)(repoRoot, path).split("\\").join("/");
    if (back.startsWith("../") || (0, import_node_path30.isAbsolute)(back) || !(0, import_node_fs30.existsSync)(path)) continue;
    if (opts.force || digest3(path) === expected) {
      (0, import_node_fs30.rmSync)(path, { force: true });
      removed.push(path);
    } else preserved.push(path);
  }
  const lockRemoved = preserved.length === 0 || Boolean(opts.force);
  if (lockRemoved) (0, import_node_fs30.rmSync)(lockPath, { force: true });
  return { repoRoot, removed, preserved, lockRemoved };
}

