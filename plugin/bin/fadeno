  const tpl = templatesDir();
  const ref = opts.outDir ?? "plugin";
  const outDir = (0, import_node_path12.isAbsolute)(ref) ? ref : (0, import_node_path12.resolve)(cwd, ref);
  const force = opts.force ?? false;
  const results = [];
  const manifest = JSON.stringify(
    {
      name: "fadeno",
      description: DESCRIPTION,
      version: packageVersion(),
      author: { name: "Fadeno" },
      keywords: ["ai", "agents", "subagents", "workflow", "skills"]
    },
    null,
    2
  ) + "\n";
  emit(results, (0, import_node_path12.join)(outDir, ".claude-plugin", "plugin.json"), manifest, force);
  for (const { src, dst } of SKILLS) {
    let md = (0, import_node_fs13.readFileSync)((0, import_node_path12.join)(tpl, "common", "skills", src, "SKILL.md"), "utf8");
    if (!md.includes(`name: ${src}`)) {
      throw new Error(
        `templates/common/skills/${src}/SKILL.md must declare \`name: ${src}\` in its frontmatter \u2014 the emitted skill name is derived from it, so a mismatch renames nothing and ships silently.`
      );
    }
    md = stampSurfaceVersion(md.replace(`name: ${src}`, `name: ${dst}`));
    emit(results, (0, import_node_path12.join)(outDir, "skills", dst, "SKILL.md"), md, force);
    const references = (0, import_node_path12.join)(tpl, "common", "skills", src, "references");
    if ((0, import_node_fs13.existsSync)(references)) copyTree(references, (0, import_node_path12.join)(outDir, "skills", dst, "references"), force, results);
    emitLauncher(results, (0, import_node_path12.join)(outDir, "skills", dst), tpl, "claude", force);
  }
  copyTree((0, import_node_path12.join)(tpl, "common", "commands"), (0, import_node_path12.join)(outDir, "commands"), force, results);
  for (const archetype of ARCHETYPE_DISPLAY_ORDER) {
    emit(results, (0, import_node_path12.join)(outDir, "agents", `${archetype}.md`), stampSurfaceVersion(roleAgentDefinition(archetype, "claude")), force);
  }
  const relayModel = relayModelForClaude((0, import_node_path12.join)(tpl, "common", "fadeno", "executors.yaml"));
  emit(
    results,
    (0, import_node_path12.join)(outDir, "agents", "dispatch.md"),
    stampRelayModel(stampSurfaceVersion((0, import_node_fs13.readFileSync)((0, import_node_path12.join)(tpl, "claude", "claude-agents", "dispatch.md"), "utf8")), relayModel),
    force
  );
  emitHooks(results, outDir, tpl, "spawn-claude.mjs", "hooks-claude.json", force);
  return { outDir, results };
}
