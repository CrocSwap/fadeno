  }
  emit(results, (0, import_node_path12.join)(outDir, "hooks", "hooks.json"), (0, import_node_fs13.readFileSync)((0, import_node_path12.join)(tpl, "hooks", manifest), "utf8"), force);
}
function emitBundledBin(results, outDir, tpl, committedDirName, force) {
  const repoBundle = (0, import_node_path12.join)(tpl, "..", committedDirName, "bin");
  const adjacentBundle = (0, import_node_path12.dirname)(tpl);
  const bundledBin = (0, import_node_fs13.existsSync)((0, import_node_path12.join)(repoBundle, "fadeno")) ? repoBundle : (0, import_node_fs13.existsSync)((0, import_node_path12.join)(adjacentBundle, "fadeno")) ? adjacentBundle : null;
  const destinationBin = (0, import_node_path12.join)(outDir, "bin");
  if (bundledBin != null && (0, import_node_path12.resolve)(bundledBin) !== (0, import_node_path12.resolve)(destinationBin)) {
    copyTree(bundledBin, destinationBin, force, results);
  }
  const destinationCli = (0, import_node_path12.join)(destinationBin, "fadeno");
  if ((0, import_node_fs13.existsSync)(destinationCli)) (0, import_node_fs13.chmodSync)(destinationCli, 493);
}
