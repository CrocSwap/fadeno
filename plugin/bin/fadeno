function mapping(value) {
  return value !== null && typeof value === "object" && !Array.isArray(value) ? value : null;
}
function parseLayer(path) {
  let parsed;
  try {
    parsed = (0, import_yaml.parse)((0, import_node_fs3.readFileSync)(path, "utf8"));
  } catch (err) {
    throw new ExecutorProfileError(`${path} did not parse: ${err.message}`);
  }
  const doc = mapping(parsed);
  if (!doc) throw new ExecutorProfileError(`${path} is not a mapping.`);
  return doc;
}
var V4_MODEL_KEYS = /* @__PURE__ */ new Set(["provider", "id", "effort", "spellings", "eligibility", "harness"]);
var ELIGIBILITY_STATES = /* @__PURE__ */ new Set(["eligible", "shadow_only", "forbidden"]);
function repairLegacyRef(raw) {
  if (typeof raw === "string") {
    try {
      return formatDialRef(parseDialRef(raw, "ref"));
    } catch {
      return raw;
    }
  }
  const map = mapping(raw);
  if (map == null || map.via === void 0) return raw;
  const { via, ...rest } = map;
  if (typeof via !== "string" || via.trim().length === 0) return rest;
  return { ...rest, ...rest.harness === void 0 ? { harness: legacyDriverHarness(via.trim()) } : {} };
}
