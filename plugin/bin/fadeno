function ompSlotPath(agentDir, archetype, kind) {
  const filename = kind === "host" ? `${archetype}.md` : kind === "command" ? `fadeno-dispatch-${archetype}.md` : `fadeno-steering-refused-${archetype}.md`;
  const preferred = (0, import_node_path18.join)(agentDir, filename);
  try {
    if (!(0, import_node_fs18.existsSync)(preferred) || (0, import_node_fs18.readFileSync)(preferred, "utf8").includes(OMP_MANAGED_MARK)) return preferred;
  } catch {
  }
  return (0, import_node_path18.join)(agentDir, `fadeno-steering-${kind}-${archetype}.md`);
}
function ompRoleContract(archetype) {
  const behavior = ROLE_BEHAVIOR[archetype] ?? `Perform the ${archetype} role exactly as requested.`;
  return `
You are Fadeno's hybrid ${archetype}. Do not spawn further task agents.

Before every task, inspect whether the delivery begins with # Fadeno engine step assignment.
For an engine assignment, the coordinator must provide both run: <run-id> and dispatch_id: <dispatch-id>.
Run FADENO_HARNESS=omp "\${FADENO_CLI:-fadeno}" steering resolve --archetype ${archetype} --host-executor current-host --run <run-id> --dispatch-id <dispatch-id>.
If either identity is absent or validation fails, stop and report the resolver error.
For that engine assignment only:
- mode=host: ${behavior}
- mode=command: run FADENO_HARNESS=omp "\${FADENO_CLI:-fadeno}" dispatch-fallback <run-id> <dispatch-id> and relay stdout verbatim.
- mode=restart_required or mode=write_conflict: stop and relay the resolver refusal.

For an ordinary task beginning with # Fadeno step assignment, first write the entire prompt verbatim to a unique file under .fadeno/local/prompts/, then run FADENO_HARNESS=omp "\${FADENO_CLI:-fadeno}" steering resolve --archetype ${archetype} --host-executor current-host --prompt-file <path>.
- mode=host: ${behavior}
- mode=command: run FADENO_HARNESS=omp "\${FADENO_CLI:-fadeno}" dispatch --archetype ${archetype} --prompt-file <path> with that same file and relay stdout verbatim. On failure, report it and do not perform the task yourself.
- mode=restart_required or mode=write_conflict: stop and relay the resolver refusal.

Never silently substitute a different model or executor.`;
}
function renderOmpHostAgent(archetype, modelId, agentName = archetype) {
  const piece = readOmpRoleTemplate(archetype);
  const identity = modelId == null || modelId === NEUTRAL_HOST_EXECUTOR ? "" : `model: ${modelId}
`;
  return `---
name: ${agentName}
description: ${piece.description} [Fadeno steering]
${identity}---

${piece.body}
${ompRoleContract(archetype)}
`;
}
function renderOmpCommandAgent(archetype, agentName = `fadeno-dispatch-${archetype}`) {
  const piece = readOmpRoleTemplate(archetype);
  return `---
name: ${agentName}
description: Fadeno command broker for ${archetype}; relays the task through the active external executor and never performs it locally.
tools: bash
---

The Fadeno steering extension selected this command broker. You are a relay, not an implementer.

For an engine assignment, run FADENO_HARNESS=omp "\${FADENO_CLI:-fadeno}" dispatch-fallback <run-id> <dispatch-id> and relay stdout verbatim.
For an ordinary # Fadeno step assignment, first write the entire received prompt verbatim to a unique file under .fadeno/local/prompts/, then run FADENO_HARNESS=omp "\${FADENO_CLI:-fadeno}" dispatch --archetype ${archetype} --prompt-file <path> and relay stdout verbatim. If dispatch fails, report the failure and do not perform the task locally. Never paraphrase, truncate, or substitute another executor.

Original role description: ${piece.description}
`;
}
function renderOmpRefusalAgent(archetype, agentName = `fadeno-steering-refused-${archetype}`) {
  return `---
name: ${agentName}
description: Reports why Fadeno refused a ${archetype} spawn, then stops.
tools: read
---

You are a refusal reporter. The task prompt begins with a Fadeno steering refusal. Relay that refusal verbatim, state that the requested work was not started, and stop. Do not inspect the repository or attempt a substitute.
`;
}
function runSteeringApplyOmp(opts = {}) {
  const repoRoot = rootOf(opts);
  if (opts.scope === "user") {
    throw new SteeringError("omp steering materializes at project scope only (.omp/); --scope user would export this repo's dials to every repo on this machine.");
  }
  let profile;
  try {
    profile = loadExecutorProfile(repoRoot, opts.userPathOptions, "omp").profile;
  } catch (err) {
    if (err instanceof ExecutorProfileError) throw new SteeringError(err.message);
    throw err;
  }
  let dialLayers;
  let ignoredLocalDials;
  try {
    const scoped = dialLayersForApply("project", repoRoot, profile, opts.userPathOptions);
    dialLayers = scoped.layers;
    ignoredLocalDials = scoped.ignoredLocal;
  } catch (err) {
    if (err instanceof ExecutorProfileError) throw new SteeringError(err.message);
    throw err;
  }
  const agentDir = (0, import_node_path18.join)(repoRoot, ".omp", "agents");
  const results = [];
  const pending = [];
  const removed = [];
  const materialization2 = {};
  const baseline = {};
  for (const archetype of OMP_STEERING_ARCHETYPES2) {
    let cascade;
    try {
      cascade = resolveDialCascade(archetype, archetype, { bindings: profile.bindings, archetypes: profile.archetypes }, dialLayers);
    } catch (err) {
      if (err instanceof ExecutorProfileError) throw new SteeringError(err.message);
      throw err;
    }
    const executorName = formatDialRef(cascade.ref);
    let compiled = null;
    try {
      compiled = resolveDelivery(cascade.ref, profile, void 0, { archetype });
    } catch {
    }
    const spec = compiled?.spec ?? snapshotExecutor(profile, executorName, archetype);
    if (spec == null) throw new SteeringError(`archetype "${archetype}" resolved to "${executorName}" but no executor exists in profile`);
    if (hostCandidateOf(compiled, spec)) {
      baseline[archetype] = executorName;
      materialization2[archetype] = { kind: "host", adapter: "host", executor: executorName, model: spec.model };
      const hostPath = ompSlotPath(agentDir, archetype, "host");
      pending.push({
        path: hostPath,
        body: stampManagedOmpAgent(renderOmpHostAgent(archetype, compiled?.modelId ?? spec.model ?? null, (0, import_node_path18.basename)(hostPath, ".md")))
      });
      removeManagedOmpFile((0, import_node_path18.join)(agentDir, `fadeno-dispatch-${archetype}.md`), removed);
      removeManagedOmpFile((0, import_node_path18.join)(agentDir, `fadeno-steering-command-${archetype}.md`), removed);
    } else {
      materialization2[archetype] = { kind: "command-broker", adapter: "command", executor: executorName, model: spec.model };
      const commandPath = ompSlotPath(agentDir, archetype, "command");
      pending.push({ path: commandPath, body: stampManagedOmpAgent(renderOmpCommandAgent(archetype, (0, import_node_path18.basename)(commandPath, ".md"))) });
      removeManagedOmpFile((0, import_node_path18.join)(agentDir, `${archetype}.md`), removed);
      removeManagedOmpFile((0, import_node_path18.join)(agentDir, `fadeno-steering-host-${archetype}.md`), removed);
    }
  }
  for (const archetype of OMP_STEERING_ARCHETYPES2) {
    const refusalPath = ompSlotPath(agentDir, archetype, "refusal");
    pending.push({ path: refusalPath, body: stampManagedOmpAgent(renderOmpRefusalAgent(archetype, (0, import_node_path18.basename)(refusalPath, ".md"))) });
  }
  const extensionTemplate = (0, import_node_fs18.readFileSync)((0, import_node_path18.join)(templatesDir(), "omp", "extensions", "fadeno-steering.ts"), "utf8");
  const extensionContent = stampHookVersion(extensionTemplate);
  const extensionBody = `${OMP_EXTENSION_MANAGED_MARK} version=${packageVersion()} digest=${sha256Hex(extensionContent)}
${extensionContent}`;
  const extensionPath = (0, import_node_path18.join)(repoRoot, ".omp", "extensions", "fadeno-steering.ts");
  pending.push({ path: extensionPath, body: extensionBody });
  for (const item of pending) {
    const status = item.path === extensionPath ? ompExtensionEmit(item.path, item.body, opts.force ?? false) : ompManagedEmit(item.path, item.body, opts.force ?? false);
    results.push({ path: item.path, status });
  }
  results.push({ path: (0, import_node_path18.join)(repoRoot, ".omp", "settings.json"), status: ompSettingsEmit(repoRoot) });
  const gitignoreExisted = (0, import_node_fs18.existsSync)((0, import_node_path18.join)(repoRoot, ".gitignore"));
  if (ensureOmpFadenoIgnore(repoRoot)) results.push({ path: (0, import_node_path18.join)(repoRoot, ".gitignore"), status: gitignoreExisted ? "appended" : "created" });
  const conflicts = pending.filter((item) => (0, import_node_fs18.existsSync)(item.path) && (0, import_node_fs18.readFileSync)(item.path, "utf8") !== item.body).map((item) => item.path);
  const restartRequired = results.some((item) => item.status === "created" || item.status === "overwritten");
  return { results, materialization: materialization2, baseline, restartRequired, conflicts, scope: "project", removed, ignoredLocalDials };
}
function ompExtensionEmit(path, body, force) {
  const existed = (0, import_node_fs18.existsSync)(path);
  if (existed) {
    const existing = (0, import_node_fs18.readFileSync)(path, "utf8");
    if (!existing.includes(OMP_EXTENSION_MANAGED_MARK)) return "skipped";
    if (!force && existing === body) return "skipped";
  }
  (0, import_node_fs18.mkdirSync)((0, import_node_path18.join)(path, ".."), { recursive: true });
  (0, import_node_fs18.writeFileSync)(path, body, "utf8");
  return existed ? "overwritten" : "created";
}
function ompSettingsEmit(repoRoot) {
  const path = (0, import_node_path18.join)(repoRoot, ".omp", "settings.json");
  const existed = (0, import_node_fs18.existsSync)(path);
  let settings = {};
  if (existed) {
    try {
      const parsed = JSON.parse((0, import_node_fs18.readFileSync)(path, "utf8"));
      if (parsed == null || typeof parsed !== "object" || Array.isArray(parsed)) return "skipped";
      settings = parsed;
    } catch {
      return "skipped";
    }
  }
  const extensions = settings.extensions;
  if (extensions != null && !Array.isArray(extensions)) return "skipped";
  if (Array.isArray(extensions) && !extensions.every((entry) => typeof entry === "string")) return "skipped";
  const entries = Array.isArray(extensions) ? extensions : [];
  const current = entries.filter((entry) => entry !== OMP_LEGACY_EXTENSION_ENTRY);
  if (current.includes(OMP_PROJECT_EXTENSION_ENTRY) && current.length === entries.length) return "skipped";
  settings.extensions = current.includes(OMP_PROJECT_EXTENSION_ENTRY) ? current : [...current, OMP_PROJECT_EXTENSION_ENTRY];
  (0, import_node_fs18.mkdirSync)((0, import_node_path18.join)(path, ".."), { recursive: true });
  (0, import_node_fs18.writeFileSync)(path, `${JSON.stringify(settings, null, 2)}
`, "utf8");
  return existed ? "overwritten" : "created";
}

// src/commands/init.ts
var SKILLS2 = [];
function runInit(opts) {
  const tpl = templatesDir();
  const repoRoot = opts.repoRoot ?? findRepoRoot(opts.cwd ?? process.cwd());
  const force = opts.force ?? false;
  const withSteering = opts.noSteering === true ? false : opts.withSteering ?? opts.target !== "grok";
  const results = [];
  if (withSteering && opts.target === "grok") {
    throw new Error(
      "Loadout steering is currently supported for Codex, Claude Code, OpenCode, and omp \u2014 not Grok Build."
    );
  }
  copyTree((0, import_node_path19.join)(tpl, "common", "fadeno"), (0, import_node_path19.join)(repoRoot, ".fadeno"), force, results);
  copyTree(
    (0, import_node_path19.join)(tpl, "common", "opencode-agents"),
    (0, import_node_path19.join)(repoRoot, ".opencode", "agents"),
    force,
    results
  );
  ensureGitignored(
    repoRoot,
    [...FADENO_IGNORE_PATTERNS],
    results
  );
  if (!opts.dataOnly) {
    let skillsBase;
    switch (opts.target) {
      case "codex":
        skillsBase = (0, import_node_path19.join)(repoRoot, ".agents", "skills");
        break;
      case "claude":
        skillsBase = (0, import_node_path19.join)(repoRoot, ".claude", "skills");
        break;
      case "grok":
        skillsBase = (0, import_node_path19.join)(repoRoot, ".grok", "skills");
        break;
      case "omp":
        skillsBase = (0, import_node_path19.join)(repoRoot, ".agents", "skills");
        break;
      case "opencode":
        skillsBase = (0, import_node_path19.join)(repoRoot, ".agents", "skills");
        break;
    }
    for (const skill of SKILLS2) {
      const skillSrc = (0, import_node_path19.join)(tpl, "common", "skills", skill);
      const skillDest = (0, import_node_path19.join)(skillsBase, skill);
      const skillMd = (0, import_node_fs19.readFileSync)((0, import_node_path19.join)(skillSrc, "SKILL.md"), "utf8");
      const skillMdPath = (0, import_node_path19.join)(skillDest, "SKILL.md");
      results.push({ path: skillMdPath, status: emitFile(skillMdPath, skillMd, force) });
      const references = (0, import_node_path19.join)(skillSrc, "references");
      if ((0, import_node_fs19.existsSync)(references)) copyTree(references, (0, import_node_path19.join)(skillDest, "references"), force, results);
      if (opts.target === "codex") {
        const policy = (0, import_node_fs19.readFileSync)((0, import_node_path19.join)(tpl, "codex", "openai", `${skill}.yaml`), "utf8");
        const policyPath = (0, import_node_path19.join)(skillDest, "agents", "openai.yaml");
        results.push({ path: policyPath, status: emitFile(policyPath, policy, force) });
      }
    }
    switch (opts.target) {
      case "codex":
        if (withSteering) {
          results.push(...emitCodexSteeringBrokers({ repoRoot, force }));
        } else {
          copyTree((0, import_node_path19.join)(tpl, "codex", "codex-agents"), (0, import_node_path19.join)(repoRoot, ".codex", "agents"), force, results);
        }
        break;
      case "claude": {
        const agentsSrc = (0, import_node_path19.join)(tpl, "claude", "claude-agents");
        const relayModel = relayModelForClaude((0, import_node_path19.join)(repoRoot, ".fadeno", "executors.yaml"));
        for (const file of (0, import_node_fs19.readdirSync)(agentsSrc).sort()) {
          const dest = (0, import_node_path19.join)(repoRoot, ".claude", "agents", file);
          const body = stampRelayModel((0, import_node_fs19.readFileSync)((0, import_node_path19.join)(agentsSrc, file), "utf8"), relayModel);
          results.push({ path: dest, status: emitFile(dest, body, force) });
        }
        break;
      }
      case "grok":
        copyTree((0, import_node_path19.join)(tpl, "grok", "grok-agents"), (0, import_node_path19.join)(repoRoot, ".grok", "agents"), force, results);
        break;
      case "opencode":
        copyTree(
          (0, import_node_path19.join)(tpl, "opencode", "opencode-agents"),
          (0, import_node_path19.join)(repoRoot, ".opencode", "agents"),
          force,
          results
        );
        if (withSteering) {
          appendOpenCodeSteeringResults(results, runSteeringApplyOpenCode({ repoRoot, force }).results);
        }
        break;
      case "omp":
        if (withSteering) {
          appendOmpSteeringResults(results, runSteeringApplyOmp({ repoRoot, force }).results);
          const agentsSrc = (0, import_node_path19.join)(tpl, "omp", "omp-agents");
          for (const file of (0, import_node_fs19.readdirSync)(agentsSrc).sort()) {
            if (!file.startsWith("dispatch-")) continue;
            const dest = (0, import_node_path19.join)(repoRoot, ".omp", "agents", file);
            results.push({ path: dest, status: emitFile(dest, (0, import_node_fs19.readFileSync)((0, import_node_path19.join)(agentsSrc, file), "utf8"), false) });
          }
        } else copyTree((0, import_node_path19.join)(tpl, "omp", "omp-agents"), (0, import_node_path19.join)(repoRoot, ".omp", "agents"), force, results);
        break;
    }
    let bootstrapName;
    switch (opts.target) {
      case "claude":
        bootstrapName = "CLAUDE.md";
        break;
      case "codex":
      case "grok":
      case "opencode":
      case "omp":
        bootstrapName = "AGENTS.md";
        break;
    }
    const bootstrapBody = (0, import_node_fs19.readFileSync)((0, import_node_path19.join)(tpl, opts.target, bootstrapName), "utf8");
    emitBootstrap((0, import_node_path19.join)(repoRoot, bootstrapName), bootstrapBody, force, results);
  }
  if (opts.dataOnly && withSteering && opts.target === "codex") {
    results.push(...emitCodexSteeringBrokers({ repoRoot, force }));
  }
  if (opts.dataOnly && withSteering && opts.target === "opencode") {
    appendOpenCodeSteeringResults(results, runSteeringApplyOpenCode({ repoRoot, force }).results);
  }
  if (opts.dataOnly && withSteering && opts.target === "omp") {
    appendOmpSteeringResults(results, runSteeringApplyOmp({ repoRoot, force }).results);
  }
  if (opts.withHooks) emitHooks(tpl, repoRoot, opts.target, force, results);
  if (withSteering && opts.target === "claude") {
    const steeringPath = (0, import_node_path19.join)(repoRoot, CLAUDE_STEERING_SCRIPT);
    const steeringBody = stampHookVersion(
      (0, import_node_fs19.readFileSync)((0, import_node_path19.join)(tpl, "claude", "hooks", "dispatch-steering.mjs"), "utf8")
    );
    results.push({ path: steeringPath, status: emitFile(steeringPath, steeringBody, force) });
    const guardPath = (0, import_node_path19.join)(repoRoot, CLAUDE_GUARD_SCRIPT);
    const guardBody = (0, import_node_fs19.readFileSync)(
      (0, import_node_path19.join)(tpl, "claude", "hooks", "dispatch-proxy-guard.mjs"),
      "utf8"
    );
    results.push({ path: guardPath, status: emitFile(guardPath, guardBody, force) });
  }
  if (opts.target === "claude") emitClaudeSettings(repoRoot, withSteering, results);
  return { target: opts.target, repoRoot, results };
}
function appendOpenCodeSteeringResults(results, incoming) {
  for (const item of incoming) {
    const prior = results.find((candidate) => candidate.path === item.path);
    if (prior != null && item.status === "appended") continue;
    results.push(item);
  }
}
function appendOmpSteeringResults(results, incoming) {
  for (const item of incoming) {
    const prior = results.find((candidate) => candidate.path === item.path);
    if (prior != null && item.status === "appended") continue;
    results.push(item);
  }
}
var FADENO_BASH_RULE = "Bash(fadeno:*)";
var CLAUDE_STEERING_SCRIPT = (0, import_node_path19.join)(".fadeno", "local", "claude-dispatch-steering.mjs");
var CLAUDE_STEERING_COMMAND = `node ${CLAUDE_STEERING_SCRIPT}`;
var CLAUDE_GUARD_SCRIPT = (0, import_node_path19.join)(".fadeno", "local", "claude-dispatch-proxy-guard.mjs");
var CLAUDE_GUARD_COMMAND = `node ${CLAUDE_GUARD_SCRIPT}`;
var CLAUDE_STEERING_HOOKS = [
  { matcher: "Agent", command: CLAUDE_STEERING_COMMAND },
  { matcher: "Bash", command: CLAUDE_GUARD_COMMAND }
];
function emitClaudeSettings(repoRoot, withSteering, results) {
  const settingsPath = (0, import_node_path19.join)(repoRoot, ".claude", "settings.local.json");
  const existed = (0, import_node_fs19.existsSync)(settingsPath);
  let data = {};
  if (existed) {
    try {
      const parsed = JSON.parse((0, import_node_fs19.readFileSync)(settingsPath, "utf8"));
      if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
        results.push({ path: settingsPath, status: "skipped" });
        return;
      }
      data = parsed;
    } catch {
      results.push({ path: settingsPath, status: "skipped" });
      return;
    }
  }
  const perms = data.permissions && typeof data.permissions === "object" && !Array.isArray(data.permissions) ? data.permissions : {};
  const allow = Array.isArray(perms.allow) ? [...perms.allow] : [];
  let changed = false;
  if (!allow.includes(FADENO_BASH_RULE)) {
    allow.push(FADENO_BASH_RULE);
    perms.allow = allow;
    data.permissions = perms;
    changed = true;
  }
  if (withSteering) {
    const hooks = data.hooks == null ? {} : data.hooks && typeof data.hooks === "object" && !Array.isArray(data.hooks) ? data.hooks : null;
    if (hooks == null) {
      results.push({ path: settingsPath, status: "skipped" });
      return;
    }
    const rawPreToolUse = hooks.PreToolUse;
    if (rawPreToolUse != null && !Array.isArray(rawPreToolUse)) {
      results.push({ path: settingsPath, status: "skipped" });
      return;
    }
    const preToolUse = Array.isArray(rawPreToolUse) ? [...rawPreToolUse] : [];
    const hasCommand = (command2) => preToolUse.some((entry) => {
      if (!entry || typeof entry !== "object" || Array.isArray(entry)) return false;
      const handlers = entry.hooks;
      return Array.isArray(handlers) && handlers.some(
        (handler) => handler != null && typeof handler === "object" && !Array.isArray(handler) && handler.command === command2
      );
    });
    let hooksChanged = false;
    for (const { matcher, command: command2 } of CLAUDE_STEERING_HOOKS) {
      if (hasCommand(command2)) continue;
      preToolUse.push({ matcher, hooks: [{ type: "command", command: command2 }] });
      hooksChanged = true;
    }
    if (hooksChanged) {
      hooks.PreToolUse = preToolUse;
      data.hooks = hooks;
      changed = true;
    }
  }
  if (!changed) {
    results.push({ path: settingsPath, status: "skipped" });
    return;
  }
  (0, import_node_fs19.mkdirSync)((0, import_node_path19.dirname)(settingsPath), { recursive: true });
  (0, import_node_fs19.writeFileSync)(settingsPath, `${JSON.stringify(data, null, 2)}
`, "utf8");
  results.push({ path: settingsPath, status: existed ? "appended" : "created" });
  ensureGitignored(repoRoot, [...FADENO_IGNORE_PATTERNS], results);
}
function ensureGitignored(repoRoot, patterns, results) {
  const gitignorePath = (0, import_node_path19.join)(repoRoot, ".gitignore");
  const existed = (0, import_node_fs19.existsSync)(gitignorePath);
  const content = existed ? (0, import_node_fs19.readFileSync)(gitignorePath, "utf8") : "";
  const lines = content.split(/\r?\n/).map((line) => line.trim());
  const missing3 = patterns.filter((pattern) => {
    if (lines.includes(pattern)) return false;
    if (pattern.startsWith(".fadeno/") && (lines.includes(".fadeno") || lines.includes(".fadeno/"))) return false;
    if (pattern.startsWith(".claude/") && (lines.includes(".claude") || lines.includes(".claude/"))) return false;
    if (pattern.startsWith(".opencode/") && (lines.includes(".opencode") || lines.includes(".opencode/"))) return false;
    return true;
  });
  if (missing3.length === 0) return;
  const sep3 = content.length === 0 || content.endsWith("\n") ? "" : "\n";
  const comment = missing3[0] === ".claude/settings.local.json" ? "# Fadeno: per-user local Claude settings (not committed)" : "# Fadeno: local generated files (not committed)";
  const block = `${sep3}${comment}
${missing3.join("\n")}
`;
  (0, import_node_fs19.writeFileSync)(gitignorePath, content + block, "utf8");
  results.push({ path: gitignorePath, status: existed ? "appended" : "created" });
}
function emitHooks(tpl, repoRoot, target, force, results) {
  const hookFile = (srcRel, destRel, executable = false) => {
    const content = (0, import_node_fs19.readFileSync)((0, import_node_path19.join)(tpl, srcRel), "utf8");
    const dest = (0, import_node_path19.join)(repoRoot, destRel);
    const status = emitFile(dest, content, force);
    if (executable && (status === "created" || status === "overwritten")) (0, import_node_fs19.chmodSync)(dest, 493);
    results.push({ path: dest, status });
  };
  hookFile((0, import_node_path19.join)("common", "hooks", "pre-commit"), (0, import_node_path19.join)(".fadeno", "hooks", "pre-commit"), true);
  hookFile((0, import_node_path19.join)("common", "hooks", "README.md"), (0, import_node_path19.join)(".fadeno", "hooks", "README.md"));
  hookFile(
    (0, import_node_path19.join)("common", "hooks", "fadeno-guard.yml"),
    (0, import_node_path19.join)(".github", "workflows", "fadeno-guard.yml")
  );
  hookFile(
    (0, import_node_path19.join)("common", "hooks", "fadeno-verify.yml"),
    (0, import_node_path19.join)(".github", "workflows", "fadeno-verify.yml")
  );
  if (target === "claude") {
    hookFile(
      (0, import_node_path19.join)("claude", "hooks", "settings.example.json"),
      (0, import_node_path19.join)(".fadeno", "hooks", "claude-settings.example.json")
    );
  }
}

// src/commands/dial.ts
var import_node_child_process8 = require("node:child_process");
var import_node_fs21 = require("node:fs");
var import_node_path21 = require("node:path");
var import_yaml4 = __toESM(require_dist(), 1);

// src/lib/installations.ts
var import_node_crypto10 = require("node:crypto");
var import_node_fs20 = require("node:fs");
var import_node_path20 = require("node:path");
var InstallationError = class extends Error {
};
function emptyInstallationManifest() {
  return { schema_version: 1, runtime: null, harnesses: {} };
}
function validateInstallationManifestDocument(doc) {
  const error = (detail) => ({ severity: "error", detail });
  if (doc == null || typeof doc !== "object" || Array.isArray(doc)) return error("is not a JSON object");
  const manifest = doc;
  if (manifest.schema_version !== 1) return error(`has schema_version ${JSON.stringify(manifest.schema_version)}, and only 1 is supported`);
  if (manifest.harnesses == null || typeof manifest.harnesses !== "object" || Array.isArray(manifest.harnesses)) {
    return error("has no `harnesses` mapping, so it records no installation at all");
  }
  return null;
}
function readInstallationManifest(options = {}) {
  const path = userPaths(options).installationsFile;
  if (!(0, import_node_fs20.existsSync)(path)) return emptyInstallationManifest();
  try {
    const parsed = JSON.parse((0, import_node_fs20.readFileSync)(path, "utf8"));
    const defect = validateInstallationManifestDocument(parsed);
    if (defect != null) {
      throw new InstallationError(`unsupported or malformed installation manifest at ${path}: it ${defect.detail}`);
    }
    return parsed;
  } catch (err) {
    if (err instanceof InstallationError) throw err;
    throw new InstallationError(`could not parse installation manifest ${path}: ${err.message}`);
  }
}
function maintainedHarnesses(options = {}) {
  const manifest = readInstallationManifest(options);
  return Object.keys(manifest.harnesses).sort();
}
function writeInstallationManifest(paths, manifest) {
  (0, import_node_fs20.mkdirSync)((0, import_node_path20.dirname)(paths.installationsFile), { recursive: true });
  const tmp = `${paths.installationsFile}.tmp-${process.pid}-${Date.now()}`;
  (0, import_node_fs20.writeFileSync)(tmp, `${JSON.stringify(manifest, null, 2)}
`, "utf8");
  (0, import_node_fs20.renameSync)(tmp, paths.installationsFile);
}
function fileDigest(path) {
  return (0, import_node_crypto10.createHash)("sha256").update((0, import_node_fs20.readFileSync)(path)).digest("hex");
}
var VERSION_RE = /^(\d+)\.(\d+)\.(\d+)(?:-rc\.(\d+))?$/;
function compareFadenoVersions(a, b) {
  const ma = VERSION_RE.exec(a.trim());
  const mb = VERSION_RE.exec(b.trim());
  if (!ma || !mb) return null;
  const aMajor = Number(ma[1]), aMinor = Number(ma[2]), aPatch = Number(ma[3]);
  const bMajor = Number(mb[1]), bMinor = Number(mb[2]), bPatch = Number(mb[3]);
  if (aMajor !== bMajor) return aMajor > bMajor ? 1 : -1;
  if (aMinor !== bMinor) return aMinor > bMinor ? 1 : -1;
  if (aPatch !== bPatch) return aPatch > bPatch ? 1 : -1;
  const aRc = ma[4] !== void 0 ? Number(ma[4]) : null;
  const bRc = mb[4] !== void 0 ? Number(mb[4]) : null;
  if (aRc === null && bRc === null) return 0;
  if (aRc === null && bRc !== null) return 1;
  if (aRc !== null && bRc === null) return -1;
  if (aRc !== bRc) return aRc > bRc ? 1 : -1;
  return 0;
}
function sourceBundleVersion(sourceDir) {
  const candidates = [
    (0, import_node_path20.join)((0, import_node_path20.dirname)(sourceDir), ".claude-plugin", "plugin.json"),
    (0, import_node_path20.join)((0, import_node_path20.dirname)(sourceDir), ".codex-plugin", "plugin.json")
  ];
  for (const candidate of candidates) {
    try {
      if (!(0, import_node_fs20.existsSync)(candidate)) continue;
      const parsed = JSON.parse((0, import_node_fs20.readFileSync)(candidate, "utf8"));
      if (parsed.name !== "fadeno") continue;
      if (typeof parsed.version === "string" && parsed.version.trim().length > 0) {
        return parsed.version.trim();
      }
    } catch {
    }
  }
  try {
    const pkg = (0, import_node_path20.join)(sourceDir, "package.json");
    if ((0, import_node_fs20.existsSync)(pkg)) {
      const parsed = JSON.parse((0, import_node_fs20.readFileSync)(pkg, "utf8"));
      if (typeof parsed.version === "string" && parsed.version.trim().length > 0) {
        if (parsed.name === "fadeno-runtime" || parsed.name === "fadeno") {
          return parsed.version.trim();
        }
      }
    }
  } catch {
  }
  return null;
}
function readRuntimeVersionAt(binDir) {
  try {
    const pkgPath = (0, import_node_path20.join)(binDir, "package.json");
    if ((0, import_node_fs20.existsSync)(pkgPath)) {
      const parsed = JSON.parse((0, import_node_fs20.readFileSync)(pkgPath, "utf8"));
      if (typeof parsed.version === "string" && parsed.version.trim().length > 0) {
        if (parsed.name === "fadeno-runtime" || parsed.name === "fadeno") {
          return { version: parsed.version.trim(), source: "observed" };
        }
      }
    }
  } catch {
  }
  return { version: null, source: "assumed" };
}
var LOCK_STALE_MS = 12e4;
function isStaleLock(lockPath) {
  try {
    const st = (0, import_node_fs20.statSync)(lockPath);
    return Date.now() - st.mtimeMs > LOCK_STALE_MS;
  } catch {
    try {
      const lst = (0, import_node_fs20.lstatSync)(lockPath);
      return Date.now() - lst.mtimeMs > LOCK_STALE_MS;
    } catch {
      return false;
    }
  }
}
function syncManagedRuntime(paths, sourceDir, manifest, opts = {}) {
  const allowInstall = opts.allowInstall ?? false;
  const trustSource = opts.trustSource ?? false;
  const force = opts.force ?? false;
  const copyFn = opts.copyFn ?? import_node_fs20.cpSync;
  const digestFn = opts.digestFn ?? fileDigest;
  const renameFn = opts.renameFn ?? import_node_fs20.renameSync;
  const rmFn = opts.rmFn ?? import_node_fs20.rmSync;
  const managedDir = paths.managedRuntimeDir;
  const managedCli = paths.managedCli;
  const dataDir = paths.dataDir;
  const lockPath = (0, import_node_path20.join)(dataDir, ".runtime.lock");
  const stagingPath = (0, import_node_path20.join)(dataDir, "runtime.staging");
  const oldPath = (0, import_node_path20.join)(dataDir, "runtime.old");
  const fromVersion = manifest.runtime?.version ?? null;
  if (sourceDir == null || !(0, import_node_fs20.existsSync)((0, import_node_path20.join)(sourceDir, "fadeno"))) {
    if (manifest.runtime != null) {
      return { outcome: "skipped-no-source", from: fromVersion, to: fromVersion };
    }
    return { outcome: "absent", from: null, to: null };
  }
  try {
    if ((0, import_node_path20.resolve)(sourceDir) === (0, import_node_path20.resolve)(managedDir)) {
      const observed = readRuntimeVersionAt(sourceDir);
      const ver = observed.version ?? packageVersion();
      const src = observed.version != null ? "observed" : "assumed";
      if (manifest.runtime != null) {
        if (manifest.runtime.version !== ver) {
          manifest.runtime = { version: ver, path: managedCli, source: manifest.runtime.source, version_source: src, installed_at: (/* @__PURE__ */ new Date()).toISOString() };
          try {
            writeInstallationManifest(paths, manifest);
          } catch {
          }
        }
      } else {
        manifest.runtime = { version: ver, path: managedCli, source: null, version_source: src, installed_at: (/* @__PURE__ */ new Date()).toISOString() };
        try {
          writeInstallationManifest(paths, manifest);
        } catch {
        }
      }
      return { outcome: "current", from: fromVersion, to: ver };
    }
  } catch {
  }
  if (manifest.runtime == null) {
    if (!allowInstall) {
      return { outcome: "absent", from: null, to: null };
    }
    let srcVer = sourceBundleVersion(sourceDir);
    let srcSource = "observed";
    if (srcVer == null && trustSource) {
      srcVer = packageVersion();
      srcSource = "assumed";
    }
    if (srcVer == null) {
      return { outcome: "kept-newer", from: null, to: null };
    }
    (0, import_node_fs20.mkdirSync)(dataDir, { recursive: true });
    try {
      (0, import_node_fs20.mkdirSync)(lockPath);
    } catch (err) {
      if (err.code === "EEXIST") {
        if (isStaleLock(lockPath)) {
          try {
            rmFn(lockPath, { recursive: true, force: true });
          } catch {
          }
          try {
            (0, import_node_fs20.mkdirSync)(lockPath);
          } catch {
            return { outcome: "locked", from: null, to: srcVer };
          }
        } else {
          return { outcome: "locked", from: null, to: srcVer };
        }
      } else {
        throw err;
      }
    }
    let staged2 = false;
    try {
      try {
        rmFn(stagingPath, { recursive: true, force: true });
      } catch {
      }
      try {
        rmFn(oldPath, { recursive: true, force: true });
      } catch {
      }
      copyFn(sourceDir, stagingPath, { recursive: true });
      staged2 = true;
      if (!(0, import_node_fs20.existsSync)((0, import_node_path20.join)(stagingPath, "fadeno"))) throw new InstallationError(`staged runtime missing fadeno binary`);
      if ((0, import_node_fs20.existsSync)((0, import_node_path20.join)(sourceDir, "templates")) && !(0, import_node_fs20.existsSync)((0, import_node_path20.join)(stagingPath, "templates"))) {
        throw new InstallationError(`staged runtime missing templates`);
      }
      if (managedCli.endsWith(".cmd")) {
        (0, import_node_fs20.writeFileSync)((0, import_node_path20.join)(stagingPath, "fadeno.cmd"), '@echo off\r\nnode "%~dp0fadeno" %*\r\n', "utf8");
      }
      renameFn(stagingPath, managedDir);
      staged2 = false;
      manifest.runtime = { version: srcVer, path: managedCli, source: sourceDir, version_source: srcSource, installed_at: (/* @__PURE__ */ new Date()).toISOString() };
      writeInstallationManifest(paths, manifest);
      return { outcome: "installed", from: null, to: srcVer };
    } catch (e) {
      if (staged2) try {
        rmFn(stagingPath, { recursive: true, force: true });
      } catch {
      }
      try {
        rmFn(stagingPath, { recursive: true, force: true });
      } catch {
      }
      try {
        rmFn(oldPath, { recursive: true, force: true });
      } catch {
      }
      throw e;
    } finally {
      try {
        rmFn(lockPath, { recursive: true, force: true });
      } catch {
      }
      try {
        if ((0, import_node_fs20.existsSync)(stagingPath)) rmFn(stagingPath, { recursive: true, force: true });
      } catch {
      }
      try {
        if ((0, import_node_fs20.existsSync)(oldPath)) rmFn(oldPath, { recursive: true, force: true });
      } catch {
      }
    }
  }
  const currentVersion = manifest.runtime.version;
  let sourceVersion = sourceBundleVersion(sourceDir);
  let sourceVersionSource = "observed";
  if (sourceVersion == null && trustSource) {
    sourceVersion = packageVersion();
    sourceVersionSource = "assumed";
  } else if (sourceVersion == null) {
    return { outcome: "kept-newer", from: currentVersion, to: currentVersion };
  }
  const cmp = sourceVersion != null ? compareFadenoVersions(sourceVersion, currentVersion) : null;
  if (cmp === 0) {
    let srcDigest = null;
    let dstDigest = null;
    try {
      srcDigest = digestFn((0, import_node_path20.join)(sourceDir, "fadeno"));
      dstDigest = digestFn((0, import_node_path20.join)(managedDir, "fadeno"));
    } catch {
      srcDigest = "missing-src";
      dstDigest = "missing-dst";
    }
    if (srcDigest === dstDigest) {
      return { outcome: "current", from: currentVersion, to: currentVersion };
    }
  } else if (cmp === -1) {
    if (!force) {
      return { outcome: "kept-newer", from: currentVersion, to: currentVersion };
    }
  } else if (cmp === null) {
    if (!trustSource) {
      return { outcome: "kept-newer", from: currentVersion, to: currentVersion };
    }
    let srcDigest = null;
    let dstDigest = null;
    try {
      srcDigest = digestFn((0, import_node_path20.join)(sourceDir, "fadeno"));
      dstDigest = digestFn((0, import_node_path20.join)(managedDir, "fadeno"));
    } catch {
      srcDigest = "missing-src";
      dstDigest = "missing-dst";
    }
    if (srcDigest === dstDigest) {
      return { outcome: "current", from: currentVersion, to: currentVersion };
    }
  }
  (0, import_node_fs20.mkdirSync)(dataDir, { recursive: true });
  try {
    (0, import_node_fs20.mkdirSync)(lockPath);
  } catch (err) {
    if (err.code === "EEXIST") {
      if (isStaleLock(lockPath)) {
        try {
          rmFn(lockPath, { recursive: true, force: true });
        } catch {
        }
        try {
          (0, import_node_fs20.mkdirSync)(lockPath);
        } catch (e) {
          if (e.code === "EEXIST") return { outcome: "locked", from: currentVersion, to: sourceVersion };
          throw e;
        }
      } else {
        return { outcome: "locked", from: currentVersion, to: sourceVersion };
      }
    } else {
      throw err;
    }
  }
  let staged = false;
  let renamed = false;
  let restoreFailed = false;
  try {
    try {
      rmFn(stagingPath, { recursive: true, force: true });
    } catch {
    }
    try {
      rmFn(oldPath, { recursive: true, force: true });
    } catch {
    }
    copyFn(sourceDir, stagingPath, { recursive: true });
    staged = true;
    if (!(0, import_node_fs20.existsSync)((0, import_node_path20.join)(stagingPath, "fadeno"))) throw new InstallationError(`staged runtime missing fadeno binary`);
    if ((0, import_node_fs20.existsSync)((0, import_node_path20.join)(sourceDir, "templates")) && !(0, import_node_fs20.existsSync)((0, import_node_path20.join)(stagingPath, "templates"))) {
      throw new InstallationError(`staged runtime missing templates`);
    }
    if (managedCli.endsWith(".cmd")) {
      (0, import_node_fs20.writeFileSync)((0, import_node_path20.join)(stagingPath, "fadeno.cmd"), '@echo off\r\nnode "%~dp0fadeno" %*\r\n', "utf8");
    }
    if ((0, import_node_fs20.existsSync)(managedDir)) {
      renameFn(managedDir, oldPath);
      renamed = true;
    }
    renameFn(stagingPath, managedDir);
    staged = false;
    try {
      rmFn(oldPath, { recursive: true, force: true });
    } catch {
    }
    renamed = false;
    manifest.runtime = {
      version: sourceVersion,
      path: managedCli,
      source: sourceDir,
      version_source: sourceVersionSource,
      installed_at: (/* @__PURE__ */ new Date()).toISOString()
    };
    writeInstallationManifest(paths, manifest);
    return { outcome: "refreshed", from: currentVersion, to: sourceVersion };
  } catch (e) {
    if (renamed) {
      let restored = false;
      try {
        if ((0, import_node_fs20.existsSync)(oldPath) && !(0, import_node_fs20.existsSync)(managedDir)) {
          try {
            renameFn(oldPath, managedDir);
            restored = true;
          } catch {
            restoreFailed = true;
          }
        } else if ((0, import_node_fs20.existsSync)(oldPath) && (0, import_node_fs20.existsSync)(managedDir)) {
          try {
            rmFn(managedDir, { recursive: true, force: true });
          } catch {
          }
          try {
            renameFn(oldPath, managedDir);
            restored = true;
          } catch {
            restoreFailed = true;
          }
        }
      } catch {
        restoreFailed = true;
      }
      if (restored) renamed = false;
      else restoreFailed = true;
    }
    if (staged) {
      try {
        rmFn(stagingPath, { recursive: true, force: true });
      } catch {
      }
    }
    try {
      if ((0, import_node_fs20.existsSync)(stagingPath)) rmFn(stagingPath, { recursive: true, force: true });
    } catch {
    }
    throw e;
  } finally {
    try {
      rmFn(lockPath, { recursive: true, force: true });
    } catch {
    }
    try {
      if ((0, import_node_fs20.existsSync)(stagingPath)) rmFn(stagingPath, { recursive: true, force: true });
    } catch {
    }
    if (!restoreFailed) {
      try {
        if ((0, import_node_fs20.existsSync)(oldPath)) rmFn(oldPath, { recursive: true, force: true });
      } catch {
      }
    } else {
      try {
        console.error(`fadeno: runtime rollback preserved at ${oldPath}; restore to ${managedDir} failed \u2014 recover manually`);
      } catch {
      }
    }
  }
}
function recordHarnessInstallation(paths, harness, files, manifest, permissionRules = []) {
  manifest.harnesses[harness] = {
    version: packageVersion(),
    files: files.filter(import_node_fs20.existsSync).map((path) => ({ path, sha256: fileDigest(path) })),
    ...permissionRules.length > 0 ? { permissionRules } : {}
  };
  writeInstallationManifest(paths, manifest);
}

// src/commands/dial.ts
var DialError = class extends Error {
};
function shadowAttachmentView(att, delivery) {
  return {
    model: att.model,
    ...att.effort ? { effort: att.effort } : {},
    ...att.harness ? { harness: att.harness } : {},
    ...att.rate != null ? { rate: att.rate } : {},
    n: att.n ?? null,
    remaining: att.remaining ?? null,
    expired: shadowAttachmentExpired(att),
    ...delivery != null ? { adapter: delivery.spec.adapter, resolved_harness: delivery.harness } : {}
  };
}
function repoRootOf(opts) {
  return opts.repoRoot ?? findRepoRoot(opts.cwd ?? process.cwd());
}
function loadLayered(repoRoot, userPathOptions) {
  try {
    return loadLayeredProfile(repoRoot, userPathOptions, activeHarness(void 0, userPathOptions));
  } catch (err) {
    if (err instanceof ExecutorProfileError) throw new DialError(err.message);
    throw err;
  }
}
function formatSuppressedCanonNote(archetypes) {
  if (archetypes.length === 0) return null;
  return `note: canon archetypes not declared by this catalog: <${archetypes.join(", ")}> (self-contained profile suppresses builtin layering; declare them in .fadeno/executors.yaml to adopt)`;
}
function formatModelFallbackNote(fallback) {
  const parts = [];
  if (fallback.promoted.length > 0) {
    parts.push(
      `user-catalog model${fallback.promoted.length === 1 ? "" : "s"} promoted into this self-contained catalog: ${fallback.promoted.join(", ")}`
    );
  }
  for (const drop of fallback.dropped) {
    parts.push(
      `user-catalog model "${drop.alias}" dropped \u2014 nothing in this catalog can deliver harness/provider "${drop.harness}"`
    );
  }
  parts.push(...fallback.repairs);
  if (parts.length === 0) return null;
  return `note: ${parts.join("; ")}`;
}
function canonSurfacing(layered) {
  const arr = layered.suppressedCanonArchetypes;
  const canonNote = formatSuppressedCanonNote(arr);
  const fallbackNote = formatModelFallbackNote(layered.modelFallback);
  const note = [canonNote, fallbackNote].filter((part) => part != null).join("\n") || null;
  return { suppressed_canon_archetypes: arr, note };
}
function buildDialRef(modelInput, harness, label) {
  const base = parseDialRef(modelInput, label);
  if (harness != null && harness.trim().length > 0) {
    const h = harness.trim();
    if (!BARE_IDENTIFIER_RE.test(h)) {
      throw new DialError(`${label} harness "${h}" is not a bare identifier.`);
    }
    if (base.harness != null && base.harness !== h) {
      throw new DialError(`${label} harness mismatch: "${base.harness}" vs "${h}".`);
    }
    base.harness = h;
  }
  return base;
}
function assertHarnessDeclared(profile, ref) {
  if (ref.harness == null) return;
  if (Object.hasOwn(profile.harnesses ?? {}, ref.harness)) return;
  const declared = declaredHarnesses(profile);
  throw new DialError(
    `unknown harness "${ref.harness}" \u2014 declared harnesses: ${declared.join(", ") || "(none)"}`
  );
}
function levenshtein(a, b) {
  const m = a.length, n = b.length;
  const dp = Array.from({ length: m + 1 }, () => Array(n + 1).fill(0));
  for (let i = 0; i <= m; i++) dp[i][0] = i;
  for (let j = 0; j <= n; j++) dp[0][j] = j;
  for (let i = 1; i <= m; i++) {
    for (let j = 1; j <= n; j++) {
      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
      dp[i][j] = Math.min(dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + cost);
    }
  }
  return dp[m][n];
}
function nearestMatches(target, candidates, limit = 3) {
  const scored = candidates.map((c) => ({ c, d: levenshtein(target, c) }));
  scored.sort((a, b) => a.d - b.d || a.c.localeCompare(b.c));
  return scored.slice(0, limit).map((s) => s.c);
}
function probeModel(profile, harness, modelId, opts = {}) {
  const entry = profile.harnesses?.[harness] ?? null;
  if (modelId === "current-host") return { status: null, note: null };
  if (entry == null) {
    return { status: "unverified", note: `note: cannot verify ${modelId} on ${harness} (no such harness declared) \u2014 dialing unverified` };
  }
  const modelsCommand = entry.models_command;
  if (modelsCommand == null || modelsCommand.length === 0) {
    return { status: "unverified", note: `note: cannot verify ${modelId} on ${harness} (no models_command declared) \u2014 dialing unverified` };
  }
  const userOpts = opts.userPathOptions ?? {};
  if (!opts.force && isModelVerified(userOpts, harness, modelId)) {
    return { status: "cached", note: null };
  }
  const spawnFn = opts.spawn ?? ((command2, spawnOpts) => {
    const run = (0, import_node_child_process8.spawnSync)(command2[0], command2.slice(1), {
      timeout: spawnOpts.timeout,
      encoding: "utf8"
    });
    return { status: run.status, stdout: run.stdout ?? "", stderr: run.stderr ?? "", ...run.error != null ? { error: run.error } : {} };
  });
  let result;
  try {
    result = spawnFn(modelsCommand, { timeout: 1e4 });
  } catch (err) {
    return { status: "unverified", note: `note: cannot verify ${modelId} on ${harness} (${err.message}) \u2014 dialing unverified` };
  }
  if (result.error != null) {
    return { status: "unverified", note: `note: cannot verify ${modelId} on ${harness} (${result.error.message}) \u2014 dialing unverified` };
  }
  if (result.status !== 0) {
    return { status: "unverified", note: `note: cannot verify ${modelId} on ${harness} (models_command exited ${result.status}) \u2014 dialing unverified` };
  }
  const stdout = typeof result.stdout === "string" ? result.stdout : result.stdout.toString("utf8");
  const listedModelId = qualifyListedModelId(entry, modelId);
  const tokens = stdout.split(/[\s,]+/).map((t) => t.trim()).filter((t) => t.length > 0);
  if (tokens.includes(listedModelId)) {
    recordVerifiedModel(userOpts, { harness, model: modelId, verified_at: (/* @__PURE__ */ new Date()).toISOString() });
    return { status: "verified", note: null };
  }
  const nearest = nearestMatches(listedModelId, tokens, 3);
  const suggestion = nearest.length > 0 ? ` \u2014 did you mean ${nearest.map((n) => `"${n}"`).join(", ")}?` : "";
  throw new DialError(`unknown model "${modelId}" (listed as "${listedModelId}") on ${harness}${suggestion}`);
}
function harnessCanProbe(profile, harness) {
  return harness != null && (profile.harnesses?.[harness]?.models_command ?? null) != null;
}
function runDialSetMany(opts) {
  const archetypes = [];
  for (const raw of opts.archetypes) {
    const name = raw.trim();
    if (name.length > 0 && !archetypes.includes(name)) archetypes.push(name);
  }
  if (archetypes.length === 0) {
    throw new DialError("Usage: fadeno dial <archetype>[+<archetype>\u2026] <model>[@effort] [--harness <id>] [--session|--user|--repo] [--force]");
  }
  if ([opts.session, opts.user, opts.repo].filter(Boolean).length > 1) {
    throw new DialError("--session, --user, and --repo are mutually exclusive.");
  }
  const repoRoot = repoRootOf(opts);
  const modelInput = opts.model.trim();
  if (modelInput.length === 0) {
    throw new DialError("Usage: fadeno dial <archetype>[+<archetype>\u2026] <model>[@effort] [--harness <id>] [--session|--user|--repo] [--force]");
  }
  let dial;
  try {
    dial = buildDialRef(modelInput, opts.harness?.trim() || void 0, `model "${modelInput}"`);
  } catch (err) {
    if (err instanceof ExecutorProfileError) throw new DialError(err.message);
    throw err;
  }
  const layered = loadLayered(repoRoot, opts.userPathOptions);
  const profile = layered.profile;
  assertHarnessDeclared(profile, dial);
  try {
    resolveDelivery(dial, profile);
  } catch (err) {
    if (err instanceof ExecutorProfileError) throw new DialError(err.message);
    throw err;
  }
  const failures = [];
  for (const archetype of archetypes) {
    if (archetype === "set" || archetype === "clear" || archetype === "shadow" || archetype === "clear-shadow" || archetype === "resolve") {
      failures.push(`archetype "${archetype}" is a reserved word \u2014 rename the archetype`);
      continue;
    }
    if (!BARE_IDENTIFIER_RE.test(archetype)) {
      failures.push(`archetype "${archetype}" is not a bare lowercase identifier (${BARE_IDENTIFIER_RE.source}).`);
      continue;
    }
  }
  if (failures.length > 0) {
    throw new DialError(
      archetypes.length > 1 ? `nothing was dialed \u2014 ${failures.length} of ${archetypes.length} archetype(s) refused:
  ${failures.join("\n  ")}` : failures[0]
    );
  }
  return archetypes.map((archetype) => runDialSet({ ...opts, archetype }));
}
function providerNoveltyNote(params) {
  const { profile, layers, shadows, archetype, refString, compiled, kind } = params;
  const provider = compiled.provider;
  if (provider == null || provider === "current-host") return null;
  const inUse = /* @__PURE__ */ new Set();
  const archetypes = knownArchetypes(profile.archetypes, layers.session, layers.repo, layers.user);
  const providerOf = (ref) => {
    try {
      const other = resolveDelivery(ref, profile);
      if (other.provider != null) inUse.add(other.provider);
    } catch {
    }
  };
  for (const other of archetypes) {
    if (kind === "dial" && other === archetype) continue;
    try {
      const cascade = resolveDialCascade(other, other, { bindings: profile.bindings, archetypes: profile.archetypes }, layers);
      providerOf(cascade.ref);
    } catch {
    }
  }
  for (const [other, attachment] of Object.entries(shadows)) {
    if (kind === "shadow" && other === archetype) continue;
    providerOf(shadowAttachmentRef(attachment));
  }
  if (inUse.has(provider)) return null;
  const arrow = kind === "shadow" ? "~" : "\u2192";
  const consequence = kind === "shadow" ? "Every sampled dispatch duplicates the prompt to that vendor alongside the primary, and the challenger runs in a worktree of this repo." : "Prompts for this archetype \u2014 and, on a write delivery, the workspace the executor can read \u2014 go to a vendor this repo is not already sending work to.";
  const undo = kind === "shadow" ? `Detach it with \`fadeno dial clear-shadow ${archetype}\`.` : `Change it with \`fadeno dial ${archetype} <model>\`.`;
  return `WARNING: NEW PROVIDER \u2014 ${archetype} ${arrow} ${refString} routes to "${provider}", which nothing else dialed in this repo uses.
${consequence}
${undo}`;
}
function unroutablePrimaryNote(params) {
  const { profile, layers, archetype } = params;
  let resolved;
  try {
    resolved = resolveRole(archetype, archetype, profile, layers);
  } catch {
    return null;
  }
  const routability = explainPairRoutability(resolved.delivery.spec, resolved.delivery.refString);
  if (routability.routable) return null;
  return `WARNING: NO PAIR POSSIBLE \u2014 ${archetype}'s primary (${resolved.delivery.refString}) cannot carry a pair, so this shadow attachment can never be sampled and every dispatch will silently run unpaired.
${routability.reason}`;
}
function codexIdentityNotice(archetype, compiled, repoRoot, userPathOptions) {
  if (!maintainedHarnesses(userPathOptions).includes("codex")) return null;
  const candidate = effectiveCodexAgentCandidates(repoRoot, userPathOptions).find((item) => item.archetype === archetype) ?? null;
  if (candidate == null) return null;
  const neutral = compiled.modelId === "current-host";
  const dial = {
    model: neutral ? null : compiled.modelId,
    effort: neutral ? null : compiled.effectiveEffort,
    lane: compiled.harness === "codex" ? "host" : "command"
  };
  const row = codexAgentIdentityRow(archetype, candidate, dial);
  if (row.status === "current" || row.status === "not_applicable" || row.status === "missing") return null;
  return {
    stale: true,
    status: row.status,
    detail: describeCodexAgentIdentityRow(row),
    // The fix depends on which file loads; `codexIdentityRemediation` is the
    // one place that mapping lives. Non-null by the guard above: every status
    // that reaches here is one it has an answer for.
    remediation: codexIdentityRemediation([row])
  };
}
function runDialSet(opts) {
  const repoRoot = repoRootOf(opts);
  if ([opts.session, opts.user, opts.repo].filter(Boolean).length > 1) {
    throw new DialError("--session, --user, and --repo are mutually exclusive.");
  }
  const archetype = opts.archetype.trim();
  if (archetype === "set" || archetype === "clear" || archetype === "shadow" || archetype === "clear-shadow" || archetype === "resolve") {
    throw new DialError(`archetype "${archetype}" is a reserved word \u2014 rename the archetype`);
  }
  if (!BARE_IDENTIFIER_RE.test(archetype)) {
    throw new DialError(`archetype "${archetype}" is not a bare lowercase identifier (${BARE_IDENTIFIER_RE.source}).`);
  }
  const modelInput = opts.model.trim();
  if (modelInput.length === 0) throw new DialError("Usage: fadeno dial <archetype> <model>[@effort] [--harness <id>] [--session|--user|--repo] [--force]");
  let dial;
  try {
    dial = buildDialRef(modelInput, opts.harness?.trim() || void 0, `model "${modelInput}"`);
  } catch (err) {
    if (err instanceof ExecutorProfileError) throw new DialError(err.message);
    throw err;
  }
  const layered = loadLayered(repoRoot, opts.userPathOptions);
  const profile = layered.profile;
  assertHarnessDeclared(profile, dial);
  let compiled;
  try {
    compiled = resolveDelivery(dial, profile);
  } catch (err) {
    if (err instanceof ExecutorProfileError) throw new DialError(err.message);
    throw err;
  }
  const refString = formatDialRef(dial);
  let verification = null;
  let probeNote = null;
  const notes = [];
  if (!compiled.registered) {
    notes.push(
      `note: ${compiled.model} is not in the model registry \u2014 running on ${compiled.harness}, id passed verbatim (declare it under models: to set a home harness or standard effort)`
    );
  }
  const shouldProbe = compiled.model !== "current-host" && compiled.harness != null;
  const hasModelsCommand = harnessCanProbe(profile, compiled.harness);
  if (shouldProbe) {
    if (!hasModelsCommand) {
      if (!compiled.registered) {
        probeNote = `note: cannot verify ${compiled.modelId} on ${compiled.harness} (no models_command declared) \u2014 dialing unverified`;
        verification = "unverified";
      }
    } else {
      try {
        const probe2 = probeModel(profile, compiled.harness, compiled.modelId, { spawn: opts.spawn, userPathOptions: opts.userPathOptions });
        verification = probe2.status;
        probeNote = probe2.note;
      } catch (err) {
        if (err instanceof DialError) throw err;
        if (err instanceof ExecutorProfileError) throw new DialError(err.message);
        throw err;
      }
    }
  }
  const localState = readLocalDialState(repoRoot);
  const userDials = readUserDials(opts.userPathOptions);
  {
    const novelty = providerNoveltyNote({
      profile,
      layers: { session: localState.dials, repo: profile.dials, user: userDials },
      shadows: localState.shadows,
      archetype,
      refString,
      compiled,
      kind: "dial"
    });
    if (novelty != null) notes.push(novelty);
  }
  const sessionPinned = Object.hasOwn(localState.dials, archetype);
  const repoPinned = Object.hasOwn(profile.dials, archetype) ? profile.dials[archetype] : null;
  if (localState.shadows != null && Object.hasOwn(localState.shadows, archetype)) {
    try {
      const shadowLayers = { session: localState.dials, repo: profile.dials, user: readUserDials(opts.userPathOptions) };
      const unroutable = unroutablePrimaryNote({ profile, layers: shadowLayers, archetype });
      if (unroutable != null) {
        console.warn(
          `fadeno dial warning: archetype "${archetype}" has an existing shadow attachment but its new primary is unroutable for shadow pairs \u2014 the pair degrades to no pair (primary runs solo). To restore pairing, redial to a command delivery for this archetype.`
        );
      }
    } catch {
    }
  }
  const userPinned = Object.hasOwn(userDials, archetype);
  let layer;
  let adaptive = false;
  if (opts.session) layer = "session";
  else if (opts.user) layer = "user";
  else if (opts.repo) layer = "repo";
  else {
    if (sessionPinned) layer = "session";
    else if (repoPinned != null) layer = "repo";
    else if (userPinned) layer = "user";
    else layer = "user";
    adaptive = sessionPinned || repoPinned != null || userPinned;
  }
  let previous = null;
  if (layer === "session" && Object.hasOwn(localState.dials, archetype)) {
    previous = { layer: "session", dial: localState.dials[archetype] };
  } else if (layer === "user" && Object.hasOwn(userDials, archetype)) {
    previous = { layer: "user", dial: userDials[archetype] };
  } else if (layer === "repo" && repoPinned != null) {
    previous = { layer: "repo", dial: repoPinned };
  }
  let narrative = "";
  const modelDisplay = refString;
  if (layer === "user") {
    narrative = `${archetype} \u2192 ${modelDisplay}  [user default \u2014 applies across your repos]`;
  } else if (layer === "session") {
    narrative = `${archetype} \u2192 ${modelDisplay}  [session dial \u2014 this checkout only, sticky until cleared]`;
  } else if (layer === "repo") {
    narrative = `${archetype} \u2192 ${modelDisplay}  [repo pin \u2014 committed in .fadeno/executors.yaml]`;
  }
  if (probeNote) {
  }
  if (layer === "session") {
    withLocalDialStateLock(repoRoot, () => {
      const current = readLocalDialState(repoRoot);
      previous = Object.hasOwn(current.dials, archetype) ? { layer: "session", dial: current.dials[archetype] } : null;
      const nextDials = { ...current.dials, [archetype]: dial };
      writeLocalDialState(repoRoot, { dials: nextDials, shadows: current.shadows, legacyNote: null });
    });
  } else if (layer === "user") {
    const next = { ...userDials, [archetype]: dial };
    writeUserDials(opts.userPathOptions ?? {}, next);
  } else if (layer === "repo") {
    const executorsPath = (0, import_node_path21.join)(repoRoot, ".fadeno", "executors.yaml");
    let docText = "";
    let doc;
    if ((0, import_node_fs21.existsSync)(executorsPath)) {
      docText = (0, import_node_fs21.readFileSync)(executorsPath, "utf8");
      doc = (0, import_yaml4.parseDocument)(docText);
    } else {
      doc = (0, import_yaml4.parseDocument)("");
    }
    if (!doc.has("dials")) {
      doc.set("dials", doc.createNode({}));
    }
    doc.setIn(["dials", archetype], serializeDialRef(dial));
    if (!doc.has("schema_version")) {
      doc.set("schema_version", 3);
    }
    const out = String(doc);
    (0, import_node_fs21.mkdirSync)((0, import_node_path21.join)(repoRoot, ".fadeno"), { recursive: true });
    (0, import_node_fs21.writeFileSync)(executorsPath, out, "utf8");
  }
  return {
    archetype,
    dial,
    refString,
    model: compiled.model,
    model_id: compiled.modelId,
    effort: compiled.effectiveEffort,
    pinned_effort: compiled.pinnedEffort,
    effective_effort: compiled.effectiveEffort,
    harness: compiled.harness,
    variant: compiled.variant,
    layer,
    adaptive,
    repo_pinned: repoPinned,
    previous,
    verification,
    narrative,
    notes: [...notes, ...probeNote != null ? [probeNote] : []],
    codex_materialization: codexIdentityNotice(archetype, compiled, repoRoot, opts.userPathOptions)
  };
}
function runDialClear(opts = {}) {
  const repoRoot = repoRootOf(opts);
  if ([opts.session, opts.user, opts.repo].filter(Boolean).length > 1) {
    throw new DialError("--session, --user, and --repo are mutually exclusive.");
  }
  const archetypeRaw = opts.archetype?.trim() ?? null;
  const archetype = archetypeRaw && archetypeRaw.length > 0 ? archetypeRaw : null;
  if (archetype != null && !BARE_IDENTIFIER_RE.test(archetype)) {
    throw new DialError(`archetype "${archetype}" is not a bare lowercase identifier (${BARE_IDENTIFIER_RE.source}).`);
  }
  if (archetype == null && opts.repo) {
    throw new DialError("repo pins are committed config \u2014 remove them per archetype with `clear <archetype> --repo`");
  }
  if (archetype == null) {
    if (opts.session) {
      return withLocalDialStateLock(repoRoot, () => {
        const state3 = readLocalDialState(repoRoot);
        const count2 = Object.keys(state3.dials).length;
        if (count2 === 0) return { cleared: null, removed: false, archetype: null, layer: "session", remaining: {}, count: 0 };
        writeLocalDialState(repoRoot, { dials: {}, shadows: state3.shadows, legacyNote: null });
        return { cleared: null, removed: true, archetype: null, layer: "session", remaining: {}, count: count2 };
      });
    }
    if (opts.user) {
      const userDials2 = readUserDials(opts.userPathOptions);
      const count2 = Object.keys(userDials2).length;
      if (count2 === 0) return { cleared: null, removed: false, archetype: null, layer: "user", remaining: {}, count: 0 };
      writeUserDials(opts.userPathOptions ?? {}, {});
      return { cleared: null, removed: true, archetype: null, layer: "user", remaining: {}, count: count2 };
    }
    const state2 = readLocalDialState(repoRoot);
    const userDials = readUserDials(opts.userPathOptions);
    const sessionCount = Object.keys(state2.dials).length;
    const userCount = Object.keys(userDials).length;
    const repoPins = (() => {
      try {
        return archetypeDisplaySort(Object.keys(loadLayered(repoRoot, opts.userPathOptions).profile.dials));
      } catch {
        return [];
      }
    })();
    const count = sessionCount + userCount;
    if (count === 0) {
      return { cleared: null, removed: false, archetype: null, layer: null, remaining: {}, count: 0, cleared_layers: { session: 0, user: 0 }, repo_pins_remaining: repoPins };
    }
    const clearedSessionCount = withLocalDialStateLock(repoRoot, () => {
      const current = readLocalDialState(repoRoot);
      const count2 = Object.keys(current.dials).length;
      if (count2 > 0) writeLocalDialState(repoRoot, { dials: {}, shadows: current.shadows, legacyNote: null });
      return count2;
    });
    if (userCount > 0) writeUserDials(opts.userPathOptions ?? {}, {});
    return { cleared: null, removed: true, archetype: null, layer: null, remaining: {}, count: clearedSessionCount + userCount, cleared_layers: { session: clearedSessionCount, user: userCount }, repo_pins_remaining: repoPins };
  }
  if (opts.session) {
    return withLocalDialStateLock(repoRoot, () => {
      const state2 = readLocalDialState(repoRoot);
      if (!Object.hasOwn(state2.dials, archetype)) {
        return { cleared: null, removed: false, archetype, layer: "session", remaining: state2.dials };
      }
      const prev = state2.dials[archetype];
      const nextDials = { ...state2.dials };
      delete nextDials[archetype];
      writeLocalDialState(repoRoot, { dials: nextDials, shadows: state2.shadows, legacyNote: null });
      return { cleared: formatDialRef(prev), removed: true, archetype, layer: "session", remaining: nextDials };
    });
  }
  if (opts.repo) {
    const executorsPath = (0, import_node_path21.join)(repoRoot, ".fadeno", "executors.yaml");
    if (!(0, import_node_fs21.existsSync)(executorsPath)) {
      throw new DialError(`no repo pin for "${archetype}" to clear`);
    }
    const text2 = (0, import_node_fs21.readFileSync)(executorsPath, "utf8");
    const doc = (0, import_yaml4.parseDocument)(text2);
    const dials = doc.get("dials");
    if (dials == null || typeof dials !== "object") {
      throw new DialError(`no repo pin for "${archetype}" to clear`);
    }
    if (!doc.hasIn(["dials", archetype])) {
      throw new DialError(`no repo pin for "${archetype}" to clear`);
    }
    doc.deleteIn(["dials", archetype]);
    const remainingDials = doc.get("dials");
    let empty = false;
    if (remainingDials != null && typeof remainingDials === "object") {
      void remainingDials;
      const dialsNode = doc.get("dials", true);
      if (dialsNode && Array.isArray(dialsNode.items) && dialsNode.items.length === 0) empty = true;
    }
    if (empty) doc.delete("dials");
    const out = String(doc);
    (0, import_node_fs21.writeFileSync)(executorsPath, out, "utf8");
    return { cleared: archetype, removed: true, archetype, layer: "repo", remaining: {} };
  }
  if (opts.user) {
    const userDials = readUserDials(opts.userPathOptions);
    if (!Object.hasOwn(userDials, archetype)) {
      return { cleared: null, removed: false, archetype, layer: "user", remaining: userDials };
    }
    const prev = userDials[archetype];
    const next = { ...userDials };
    delete next[archetype];
    writeUserDials(opts.userPathOptions ?? {}, next);
    return { cleared: prev ? String(prev.model) : archetype, removed: true, archetype, layer: "user", remaining: next };
  }
  const state = readLocalDialState(repoRoot);
  if (!Object.hasOwn(state.dials, archetype)) {
    const layered = loadLayered(repoRoot, opts.userPathOptions);
    const userDials = readUserDials(opts.userPathOptions);
    if (!Object.hasOwn(layered.profile.dials, archetype) && Object.hasOwn(userDials, archetype)) {
      const prev = userDials[archetype];
      const next = { ...userDials };
      delete next[archetype];
      writeUserDials(opts.userPathOptions ?? {}, next);
      return { cleared: formatDialRef(prev), removed: true, archetype, layer: "user", inferred: true, remaining: next };
    }
    const livesAt = Object.hasOwn(layered.profile.dials, archetype) ? "repo" : null;
    return { cleared: null, removed: false, archetype, layer: null, remaining: state.dials, livesAt };
  }
  return withLocalDialStateLock(repoRoot, () => {
    const current = readLocalDialState(repoRoot);
    if (!Object.hasOwn(current.dials, archetype)) {
      return { cleared: null, removed: false, archetype, layer: "session", remaining: current.dials };
    }
    const prev = current.dials[archetype];
    const nextDials = { ...current.dials };
    delete nextDials[archetype];
    writeLocalDialState(repoRoot, { dials: nextDials, shadows: current.shadows, legacyNote: null });
    return { cleared: formatDialRef(prev), removed: true, archetype, layer: "session", remaining: nextDials };
  });
}
function runDialShadow(opts) {
  const repoRoot = repoRootOf(opts);
  const archetype = opts.archetype.trim();
  if (archetype === "set" || archetype === "clear" || archetype === "shadow" || archetype === "clear-shadow" || archetype === "resolve") {
    throw new DialError(`archetype "${archetype}" is a reserved word \u2014 rename the archetype`);
  }
  if (!BARE_IDENTIFIER_RE.test(archetype)) {
    throw new DialError(`archetype "${archetype}" is not a bare lowercase identifier (${BARE_IDENTIFIER_RE.source}).`);
  }
  const modelInput = opts.model.trim();
  if (modelInput.length === 0) throw new DialError("Usage: fadeno dial shadow <archetype> <model>[@effort] [--harness <id>] [--rate <r>] [--n <count>]");
  let dial;
  try {
    dial = buildDialRef(modelInput, opts.harness?.trim() || void 0, `model "${modelInput}"`);
  } catch (err) {
    if (err instanceof ExecutorProfileError) throw new DialError(err.message);
    throw err;
  }
  let rate;
  if (opts.rate != null && opts.rate !== "") {
    const raw = opts.rate;
    const parsed = typeof raw === "string" ? Number(raw) : raw;
    if (typeof parsed !== "number" || !Number.isFinite(parsed) || parsed <= 0 || parsed > 1) {
      throw new DialError(`rate ${JSON.stringify(raw)} is not a number in (0, 1].`);
    }
    rate = parsed;
  }
  let n;
  if (opts.n != null && opts.n !== "") {
    const raw = opts.n;
    const parsed = typeof raw === "string" ? Number(raw) : raw;
    if (typeof parsed !== "number" || !Number.isSafeInteger(parsed) || parsed <= 0) {
      throw new DialError(`n ${JSON.stringify(raw)} is not a positive integer.`);
    }
    n = parsed;
  }
  const layered = loadLayered(repoRoot, opts.userPathOptions);
  const profile = layered.profile;
  assertHarnessDeclared(profile, dial);
  let compiled;
  try {
    compiled = resolveDelivery(dial, profile, profile.host ?? "standalone", { archetype });
  } catch (err) {
    if (err instanceof ExecutorProfileError) throw new DialError(err.message);
    throw err;
  }
  if (deliveryIsHost(compiled)) {
    throw new DialError(`shadow for "${archetype}" must be a command delivery \u2014 host shadows are not dispatchable`);
  }
  const refString = formatDialRef(dial);
  const eligibility = eligibilityFor(compiled.spec, archetype);
  if (eligibility === "forbidden") {
    const conflict = explainEligibilityConflict({ executor: refString, spec: compiled.spec }, archetype);
    throw new DialError(conflict ?? `archetype "${archetype}" is forbidden on model "${compiled.model}"`);
  }
  const notes = [];
  if (!compiled.registered) {
    notes.push(
      `note: ${compiled.model} is not in the model registry \u2014 running on ${compiled.harness}, id passed verbatim (declare it under models: to set a home harness or standard effort)`
    );
  }
  const hasModelsCommand = harnessCanProbe(profile, compiled.harness);
  if (!compiled.registered && !hasModelsCommand) {
    notes.push(`note: cannot verify ${compiled.modelId} on ${compiled.harness} (no models_command declared) \u2014 attaching unverified`);
  } else if (hasModelsCommand) {
    const probe2 = probeModel(profile, compiled.harness, compiled.modelId, { spawn: opts.spawn, userPathOptions: opts.userPathOptions });
    if (probe2.note != null) notes.push(probe2.note);
  }
  const state = readLocalDialState(repoRoot);
  const shadowLayers = { session: state.dials, repo: profile.dials, user: readUserDials(opts.userPathOptions) };
  {
    const novelty = providerNoveltyNote({
      profile,
      layers: shadowLayers,
      shadows: state.shadows,
      archetype,
      refString,
      compiled,
      kind: "shadow"
    });
    if (novelty != null) notes.push(novelty);
  }
  {
    const unroutable = unroutablePrimaryNote({ profile, layers: shadowLayers, archetype });
    if (unroutable != null) {
      throw new DialError(unroutable);
    }
  }
  const nextAttachment = {
    model: dial.model,
    ...dial.effort ? { effort: dial.effort } : {},
    ...dial.harness ? { harness: dial.harness } : {},
    ...rate != null ? { rate } : {},
    ...n != null ? { n, remaining: n } : {}
  };
  const written = withLocalDialStateLock(repoRoot, () => {
    const current = readLocalDialState(repoRoot);
    const nextShadows2 = { ...current.shadows, [archetype]: nextAttachment };
    const path2 = writeLocalDialState(repoRoot, { dials: current.dials, shadows: nextShadows2, legacyNote: null });
    return { previous: current.shadows[archetype] ?? null, nextShadows: nextShadows2, path: path2 };
  });
  const { previous, nextShadows, path } = written;
  const shadow_attachments = {};
  for (const [key, att] of Object.entries(nextShadows)) {
    try {
      const d = shadowAttachmentRef(att);
      const c = resolveDelivery(d, profile);
      shadow_attachments[key] = shadowAttachmentView(att, c);
    } catch {
      shadow_attachments[key] = shadowAttachmentView(att);
    }
  }
  return {
    archetype,
    dial,
    refString,
    model: compiled.model,
    model_id: compiled.modelId,
    effort: compiled.effectiveEffort,
    pinned_effort: compiled.pinnedEffort,
    effective_effort: compiled.effectiveEffort,
    harness: compiled.harness,
    variant: compiled.variant,
    rate: rate ?? null,
    n: n ?? null,
    remaining: n ?? null,
    expired: false,
    path,
    previous,
    shadows: nextShadows,
    shadow_attachments,
    notes
  };
}
function runDialClearShadow(opts = {}) {
  const repoRoot = repoRootOf(opts);
  const archetype = opts.archetype?.trim() ? opts.archetype.trim() : null;
  if (archetype != null && !BARE_IDENTIFIER_RE.test(archetype)) {
    throw new DialError(`archetype "${archetype}" is not a bare lowercase identifier (${BARE_IDENTIFIER_RE.source}).`);
  }
  const state = readLocalDialState(repoRoot);
  const path = (0, import_node_path21.join)(repoRoot, ".fadeno", "local", "dials");
  if (archetype == null) {
    const count = Object.keys(state.shadows).length;
    if (count === 0) {
      return { archetype: null, cleared: null, removed: false, count: 0, shadows: {}, shadow_attachments: {}, path };
    }
    const cleared2 = withLocalDialStateLock(repoRoot, () => {
      const current = readLocalDialState(repoRoot);
      const currentCount = Object.keys(current.shadows).length;
      if (currentCount === 0) return null;
      const path2 = writeLocalDialState(repoRoot, { dials: current.dials, shadows: {}, legacyNote: null });
      return { count: currentCount, path: path2 };
    });
    if (cleared2 == null) return { archetype: null, cleared: null, removed: false, count: 0, shadows: {}, shadow_attachments: {}, path };
    return { archetype: null, cleared: null, removed: true, count: cleared2.count, shadows: {}, shadow_attachments: {}, path: cleared2.path };
  }
  if (!Object.hasOwn(state.shadows, archetype)) {
    throw new DialError(`no shadow attachment for "${archetype}" to clear (.fadeno/local/dials)`);
  }
  const removed = withLocalDialStateLock(repoRoot, () => {
    const current = readLocalDialState(repoRoot);
    const cleared2 = current.shadows[archetype];
    if (cleared2 == null) return null;
    const nextShadows2 = { ...current.shadows };
    delete nextShadows2[archetype];
    const path2 = writeLocalDialState(repoRoot, { dials: current.dials, shadows: nextShadows2, legacyNote: null });
    return { cleared: cleared2, nextShadows: nextShadows2, path: path2 };
  });
  if (removed == null) throw new DialError(`no shadow attachment for "${archetype}" to clear (.fadeno/local/dials)`);
  const { cleared, nextShadows, path: newPath } = removed;
  const shadow_attachments = {};
  const layered = loadLayered(repoRoot, opts.userPathOptions);
  for (const [key, att] of Object.entries(nextShadows)) {
    try {
      const d = shadowAttachmentRef(att);
      const c = resolveDelivery(d, layered.profile);
      shadow_attachments[key] = shadowAttachmentView(att, c);
    } catch {
      shadow_attachments[key] = shadowAttachmentView(att);
    }
  }
  return { archetype, cleared, removed: true, count: 1, shadows: nextShadows, shadow_attachments, path: newPath };
}
function runDialShow(opts = {}) {
  const repoRoot = repoRootOf(opts);
  const layered = loadLayered(repoRoot, opts.userPathOptions);
  const profile = layered.profile;
  const host = profile.host ?? "standalone";
  const dialState = (() => {
    try {
      return readLocalDialState(repoRoot);
    } catch (err) {
      if (err instanceof ExecutorProfileError) throw new DialError(err.message);
      throw err;
    }
  })();
  const userDialsRaw = readUserDials(opts.userPathOptions);
  const userDials = userDialsRaw;
  const sessionDials = dialState.dials;
  const repoDials = profile.dials;
  const shadows = dialState.shadows;
  const legacy_pin_note = dialState.legacyNote;
  const { suppressed_canon_archetypes, note } = canonSurfacing(layered);
  const archetypesSet = knownArchetypes(profile.archetypes, sessionDials, repoDials, userDials, shadows);
  const allArchetypes = archetypeDisplaySort(archetypesSet);
  const layers = { session: sessionDials, repo: repoDials, user: userDials };
  const rows = [];
  const staleDials = [];
  const staleShadows = [];
  const shadow_attachments = {};
  for (const [arch, att] of Object.entries(shadows)) {
    try {
      const d = shadowAttachmentRef(att);
      const c = resolveDelivery(d, profile);
      shadow_attachments[arch] = shadowAttachmentView(att, c);
    } catch {
      staleShadows.push({ archetype: arch, target: att.model });
    }
  }
  for (const archetype of allArchetypes) {
    let cascade;
    try {
      cascade = resolveDialCascade(archetype, archetype, { bindings: profile.bindings, archetypes: profile.archetypes }, layers);
    } catch (err) {
      if (err instanceof ExecutorProfileError) throw new DialError(err.message);
      throw err;
    }
    let compiled;
    try {
      compiled = resolveDelivery(cascade.ref, profile);
    } catch {
      staleDials.push({ archetype, target: formatDialRef(cascade.ref) });
      continue;
    }
    const adapter = compiled.spec.adapter;
    const effort = compiled.effectiveEffort;
    const rowLane = decideLane({
      pinnedEffort: compiled.pinnedEffort,
      effectiveEffort: compiled.effectiveEffort,
      sessionEffort: readSessionEffort(opts.env ?? process.env),
      hostModel: compiled.hostCandidate,
      frame: "held",
      commandLane: commandRoutable(compiled.spec)
    });
    let modelDisplay = compiled.model;
    if (compiled.pinnedEffort != null) {
      modelDisplay = `${compiled.model} @ ${compiled.pinnedEffort}`;
    }
    if (cascade.resolvedVia != null) {
      modelDisplay = `\u2192 ${cascade.resolvedVia}`;
    }
    const row = {
      archetype,
      model: compiled.model,
      model_id: compiled.modelId,
      effort: cascade.resolvedVia != null ? "\u2014" : effort,
      pinned_effort: compiled.pinnedEffort,
      effective_effort: compiled.effectiveEffort,
      harness: compiled.harness,
      harness_explicit: cascade.ref.harness != null,
      variant: compiled.variant,
      source: cascade.source,
      resolvedVia: cascade.resolvedVia,
      dial: cascade.ref,
      refString: compiled.refString,
      adapter,
      // One derivation with `offHostLanes`, which annotates the resolution
      // echo from the same inputs — so the table and the echo cannot name
      // different lanes for the same dial in the same session. Only the two
      // lane fields are lifted: the rest of `LaneDecision` already has its own
      // (differently named, deliberately) homes on this row.
      lane: rowLane.lane,
      lane_reason: rowLane.lane_reason,
      modelDisplay
    };
    const elig = eligibilityFor(compiled.spec, archetype);
    if (elig !== "eligible") row.eligibility = elig;
    if (Object.hasOwn(shadows, archetype) && !staleShadows.some((s) => s.archetype === archetype)) {
      row.shadow = shadow_attachments[archetype];
    }
    rows.push(row);
  }
  return {
    rows,
    dials: { session: sessionDials, repo: repoDials, user: userDials },
    shadows,
    shadow_attachments,
    staleShadows,
    staleDials,
    legacy_pin_note,
    legacy_via_note: dialState.legacyViaNote ?? null,
    suppressed_canon_archetypes,
    note,
    host,
    legacyPinNote: legacy_pin_note
  };
}
function runShadowShow(opts = {}) {
  const result = runDialShow(opts);
  return { ...result, rows: result.rows.filter((row) => row.shadow != null) };
}
function deliveryGuidance(archetype, executorName, spec, conflict) {
  if (conflict != null) {
    return {
      dispatchable: false,
      dispatch_command: null,
      // The kernel's exact refusal, verbatim: it already names the remedy,
      // and rewording it here is how the two drift apart.
      action: `Do NOT dispatch \u2014 it would be refused. ${conflict}`
    };
  }
  if (commandRoutable(spec)) {
    const lane = spec.adapter === "host" ? `Host executor "${executorName}" has a command lane (\`fallback_command\`), and the dispatch delivers there rather than in-session \u2014 an isolated worktree, a dispatch id, and a terminal receipt.` : `Executor "${executorName}" runs outside this harness.`;
    return {
      dispatchable: true,
      dispatch_command: `fadeno dispatch --archetype ${archetype}`,
      action: `Dispatch it: \`fadeno dispatch --archetype ${archetype}\` with the task prompt on stdin. ${lane}`
    };
  }
  return {
    dispatchable: false,
    dispatch_command: null,
    // Same wording discipline as the kernel's refusal: name the remedy that
    // restores a real dispatch, and never present the in-session agent as an
    // equal. It writes a host_delivery row, but that row carries no dispatch
    // id and no terminal receipt, so there is nothing to read back; it also
    // has no isolated worktree and forms no shadow pair.
    action: `Do NOT dispatch. Host executor "${executorName}" declares no fallback_command, so ad-hoc dispatch has nothing to invoke. Either spawn the in-session ${archetype} agent \u2014 which writes a host_delivery row but no dispatch id or terminal receipt, has no isolated worktree, and forms no shadow pair \u2014 or give it a command lane: \`fadeno dial ${archetype} ${executorName === "current-host" ? "<model>" : executorName} --harness <id>\`.`
  };
}
function runDialResolve(opts) {
  const repoRoot = repoRootOf(opts);
  const layered = loadLayered(repoRoot, opts.userPathOptions);
  const profile = layered.profile;
  const host = profile.host ?? "standalone";
  const archetype = opts.archetype.trim();
  if (archetype === "set" || archetype === "clear" || archetype === "shadow" || archetype === "clear-shadow" || archetype === "resolve") {
    throw new DialError(`archetype "${archetype}" is a reserved word \u2014 rename the archetype`);
  }
  if (!BARE_IDENTIFIER_RE.test(archetype)) {
    throw new DialError(`archetype "${archetype}" is not a bare lowercase identifier (${BARE_IDENTIFIER_RE.source}).`);
  }
  const dialState = (() => {
    try {
      return readLocalDialState(repoRoot);
    } catch (err) {
      if (err instanceof ExecutorProfileError) throw new DialError(err.message);
      throw err;
    }
  })();
  const userDials = readUserDials(opts.userPathOptions);
  const layers = { session: dialState.dials, repo: profile.dials, user: userDials };
  let resolved;
  try {
    resolved = resolveRole(archetype, archetype, profile, layers);
  } catch (err) {
    if (err instanceof ExecutorProfileError) throw new DialError(err.message);
    throw err;
  }
  const spec = resolved.delivery.spec;
  const eligibility = eligibilityFor(spec, archetype);
  const attachment = dialState.shadows[archetype];
  let shadow;
  if (attachment != null) {
    const challenger = formatDialRef(shadowAttachmentRef(attachment));
    const digest4 = opts.promptSha256?.trim();
    const rate = attachment.rate ?? null;
    const expired = shadowAttachmentExpired(attachment);
    shadow = {
      attached: true,
      challenger,
      rate,
      n: attachment.n ?? null,
      remaining: attachment.remaining ?? null,
      expired,
      // No rate means every dispatch fires; no digest means the caller cannot
      // be told, and must not read the silence as a "no".
      selected: expired ? false : rate == null ? true : digest4 ? shadowSampleRoll(digest4, archetype, challenger) < rate : null,
      // The PRIMARY's own resolved spec — `spec` above, after write-posture —
      // not the challenger's: this is what a selected pair would have to reuse
      // to reach the command lane.
      ...pairRoutabilityFields(explainPairRoutability(spec, resolved.delivery.refString))
    };
  }
  const relay = (() => {
    try {
      return resolveRelay(profile, host);
    } catch (err) {
      if (err instanceof ExecutorProfileError) {
        throw new DialError(`harnesses.${host}.host.relay: ${err.message}`);
      }
      throw err;
    }
  })();
  return {
    archetype,
    executor: resolved.delivery.refString,
    model: resolved.delivery.model,
    model_id: resolved.delivery.modelId,
    effort: resolved.delivery.effectiveEffort,
    pinned_effort: resolved.delivery.pinnedEffort,
    ...decideLane({
      pinnedEffort: resolved.delivery.pinnedEffort,
      effectiveEffort: resolved.delivery.effectiveEffort,
      sessionEffort: readSessionEffort(opts.env ?? process.env),
      hostModel: resolved.delivery.hostCandidate,
      // `held`, deliberately, and this is the surface where that is the honest
      // answer rather than an optimistic default.
      //
      // `dial resolve` answers for THE DIAL, not for a caller: it takes no
      // `--host-executor` because its consumers are the harness's own steering
      // hooks, which sit inside the session that would deliver the spawn. On
      // Claude that session holds every identity by construction —
      // `runSteeringApplyClaude` writes no per-dial agent file at all, the hook
      // stamps the resolved model onto each spawn — so there is nothing for a
      // caller to prove and `unstated` would be a false negative that routed
      // every Claude host spawn out of process.
      //
      // The frame belongs to `steering resolve`, which is the surface that
      // takes `--host-executor` because Codex's agent FILE wins over any spawn
      // value and the caller therefore must say which agent it is.
      frame: "held",
      commandLane: commandRoutable(spec)
    }),
    harness: resolved.delivery.harness,
    variant: resolved.delivery.variant,
    adapter: spec.adapter,
    host,
    source: resolved.source,
    ...resolved.resolvedVia != null ? { resolved_via: resolved.resolvedVia } : {},
    ...layered.selfContained && layered.modelFallback.promoted.includes(resolved.delivery.model) ? { model_fallback: { promoted_from_user: true, note: formatModelFallbackNote(layered.modelFallback) } } : {},
    ...eligibility !== "eligible" ? { eligibility } : {},
    dial: resolved.delivery.ref,
    delivery: deliveryGuidance(
      archetype,
      resolved.delivery.refString,
      spec,
      // The kernel refuses a forbidden pairing outright, so a resolve that
      // answers "Dispatch it" here would be guidance walking into that
      // refusal. Eligibility is the only conflict left that is knowable at
      // resolve time — permissions are no longer Fadeno's to judge.
      explainEligibilityConflict({ executor: resolved.delivery.refString, spec }, archetype)
    ),
    relay: relay != null ? { ref: relay.refString, model_id: relay.modelId, effort: relay.effort } : null,
    ...shadow != null ? { shadow } : {}
  };
}
function formatShadowLine(shadow, baseIndent) {
  const on = shadow.harness ? ` on ${shadow.harness}` : "";
  const effort = shadow.effort ? ` @ ${shadow.effort}` : "";
  const model = `${shadow.model}${effort}${on}`;
  const rate = shadow.rate != null ? ` rate ${shadow.rate}` : "";
  const budget = shadow.n != null ? shadow.expired ? ` [expired after ${shadow.n} trigger${shadow.n === 1 ? "" : "s"}]` : ` [${shadow.remaining}/${shadow.n} triggers remaining]` : "";
  const transport = shadow.adapter != null ? ` [${shadow.adapter}]` : "";
  return `${baseIndent}  ~ shadow: ${model}${transport}${rate}${budget}`;
}

