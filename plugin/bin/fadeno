function userPaths(options = {}) {
  const env = options.env ?? process.env;
  const home = options.home ?? (0, import_node_os.homedir)();
  const os = options.platform ?? (0, import_node_os.platform)();
  const windows = os === "win32";
  const configHome = env.FADENO_CONFIG_HOME ?? (windows ? env.APPDATA : env.XDG_CONFIG_HOME) ?? (0, import_node_path3.join)(home, windows ? "AppData" : ".config");
  const stateHome = env.FADENO_STATE_HOME ?? (windows ? env.LOCALAPPDATA : env.XDG_STATE_HOME) ?? (windows ? (0, import_node_path3.join)(home, "AppData", "Local") : (0, import_node_path3.join)(home, ".local", "state"));
  const dataHome = env.FADENO_DATA_HOME ?? (windows ? env.LOCALAPPDATA : env.XDG_DATA_HOME) ?? (windows ? (0, import_node_path3.join)(home, "AppData", "Local") : (0, import_node_path3.join)(home, ".local", "share"));
  const configDir = (0, import_node_path3.join)(configHome, "fadeno");
  const stateDir = (0, import_node_path3.join)(stateHome, "fadeno");
  const dataDir = (0, import_node_path3.join)(dataHome, "fadeno");
  const binDir = env.FADENO_BIN_DIR?.trim() || (windows ? (0, import_node_path3.join)(dataDir, "bin") : (0, import_node_path3.join)(home, ".local", "bin"));
  return {
    configHome,
    stateHome,
    dataHome,
    configDir,
    stateDir,
    dataDir,
    executorsFile: (0, import_node_path3.join)(configDir, "executors.yaml"),
    configFile: (0, import_node_path3.join)(configDir, "config.yaml"),
    binDir,
    linkPath: (0, import_node_path3.join)(binDir, windows ? "fadeno.cmd" : "fadeno"),
    dialsFile: (0, import_node_path3.join)(stateDir, "dials.json"),
    modelVerificationsFile: (0, import_node_path3.join)(stateDir, "model-verifications.json")
  };
}
