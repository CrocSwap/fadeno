function digestTree(root) {
  const files = {};
  function walk(dir) {
    for (const entry of (0, import_node_fs27.readdirSync)(dir, { withFileTypes: true })) {
      const full = (0, import_node_path27.join)(dir, entry.name);
      if (entry.isDirectory()) walk(full);
      else if (entry.isFile()) files[(0, import_node_path27.relative)(root, full).split("\\").join("/")] = (0, import_node_crypto12.createHash)("sha256").update((0, import_node_fs27.readFileSync)(full)).digest("hex");
    }
  }
  walk(root);
  return files;
}
function ownedVendoredFiles(repoRoot, init) {
  const owned = {};
  const shared = /* @__PURE__ */ new Set(["AGENTS.md", "CLAUDE.md", ".gitignore", ".claude/settings.local.json"]);
  for (const result of init.results) {
    if (result.status !== "created" && result.status !== "overwritten") continue;
    const rel = (0, import_node_path27.relative)(repoRoot, result.path).split("\\").join("/");
    if (shared.has(rel) || rel.startsWith("../") || !(0, import_node_fs27.existsSync)(result.path)) continue;
    owned[rel] = (0, import_node_crypto12.createHash)("sha256").update((0, import_node_fs27.readFileSync)(result.path)).digest("hex");
  }
  return owned;
}
