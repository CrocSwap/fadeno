var COLLAPSED_STOP_RISKS = /* @__PURE__ */ new Set([
  "settled_dispatch",
  "agent_signed_off",
  "tree_clean"
]);
var COLLAPSED_STOP_ORDER = ["settled_dispatch", "agent_signed_off", "tree_clean"];
function isCollapsedStopRisk(risk) {
  return COLLAPSED_STOP_RISKS.has(risk);
}
var OUTPUT_ID_PREFIX_MIN = 8;
function sleepSync2(ms) {
  if (ms <= 0) return;
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}
function formatElapsed(ms) {
  const totalSeconds = Math.max(0, Math.floor(ms / 1e3));
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor(totalSeconds % 3600 / 60);
  const seconds = totalSeconds % 60;
  if (hours > 0) return `${hours}h ${minutes}m ${seconds}s`;
  if (minutes > 0) return `${minutes}m ${seconds}s`;
  return `${seconds}s`;
}
function str2(value) {
  return typeof value === "string" && value !== "" ? value : null;
}
function bool(value) {
  return typeof value === "boolean" ? value : null;
}
function num(value) {
  return typeof value === "number" && Number.isFinite(value) ? value : null;
}
function loadoutOf(value) {
  if (typeof value === "string") return { name: value === "" ? null : value, source: null };
  if (value != null && typeof value === "object" && !Array.isArray(value)) {
    const row = value;
    return { name: str2(row.name), source: str2(row.source) };
  }
  return { name: null, source: null };
}
function excerpt(text2, max) {
  const oneLine = text2.split("\n")[0].trim();
  return oneLine.length > max ? `${oneLine.slice(0, max - 1)}\u2026` : oneLine;
}
function flatPath(path) {
  const flat = path.split("\r").join("\\r").split("\n").join("\\n");
  return flat.length > PATH_EXCERPT ? `${flat.slice(0, PATH_EXCERPT - 1)}\u2026` : flat;
}
function formatTier(value) {
  const format = str2(value);
  if (format == null) return "unversioned";
  const majorStr = format.split(".")[0];
  const known = parseInt(KNOWN_FORMAT_MAJOR, 10);
  const maj = parseInt(majorStr ?? "", 10);
  if (!Number.isFinite(maj) || !Number.isFinite(known)) {
    return majorStr === KNOWN_FORMAT_MAJOR ? "known" : "newer";
  }
  if (maj === known) return "known";
  if (maj > known) return "newer";
  return "older";
}
function isLegacyCompletion(row) {
  if (str2(row.timestamp) == null) return false;
  if (str2(row.executor) == null && str2(row.archetype) == null) return false;
  return OUTCOME_KEYS.some((key) => key in row);
}
function refusalOf(value) {
  if (value == null || typeof value !== "object" || Array.isArray(value)) return null;
  const row = value;
  const predicate = str2(row.predicate);
  const message = typeof row.message === "string" ? row.message : null;
  if (predicate == null || message == null) return null;
  return { predicate, message };
}
function laneFieldsOf(row) {
  return { sessionEffort: str2(row.session_effort), laneReason: str2(row.lane_reason) };
}
function primaryMergeOf(value) {
  if (value == null || typeof value !== "object" || Array.isArray(value)) return null;
  const row = value;
  const status = str2(row.status);
  if (status == null) return null;
  const out = { status };
  const detail = str2(row.detail);
  if (detail != null) out.detail = detail;
  const snapshot = str2(row.diff_snapshot);
  if (snapshot != null) out.diffSnapshot = snapshot;
  return out;
}
function ignoredOutputDiscardedOf(value) {
  return parseIgnoredOutputDiscarded(value);
}
function dialOf(value) {
  if (value == null || typeof value !== "object" || Array.isArray(value)) return null;
  const row = value;
  const model = str2(row.model);
  if (model == null) return null;
  const out = { model };
  const eff = str2(row.effort);
  if (eff != null) out.effort = eff;
  const harness = str2(row.harness);
  if (harness != null) out.harness = harness;
  else {
    const via = str2(row.via);
    if (via != null) out.harness = legacyDriverHarness(via);
  }
  return out;
}
function compareFormat(a, b) {
  const parts = (v) => v.split(".").map((p) => Number.parseInt(p, 10));
  const [aMajor = -1, aMinor = -1] = parts(a);
  const [bMajor = -1, bMinor = -1] = parts(b);
  if (!Number.isFinite(aMajor) || !Number.isFinite(aMinor)) return -1;
  return aMajor !== bMajor ? aMajor - bMajor : aMinor - bMinor;
}
function harnessFieldsOf(row) {
  const format = str2(row.format);
  const legacy = format == null || compareFormat(format, "1.1") < 0;
  if (!legacy) {
    return { host: str2(row.host), harness: str2(row.harness), variant: str2(row.variant) };
  }
  const driver = str2(row.driver);
  return {
    host: str2(row.host) ?? str2(row.harness),
    harness: driver != null ? legacyDriverHarness(driver) : null,
    variant: null
  };
}
function requestedEntry(row) {
  const loadout = loadoutOf(row.loadout);
  const lane = laneFieldsOf(row);
  return {
    kind: "command",
    format: str2(row.format),
    legacy: false,
    timestamp: str2(row.timestamp),
    dispatchId: str2(row.dispatch_id),
    archetype: str2(row.archetype),
