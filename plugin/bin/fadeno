  if (body.startsWith("---\n")) {
    const close = body.indexOf("\n---\n");
    if (close >= 0) {
      const after = close + "\n---\n".length;
      return `${body.slice(0, after)}${header}
${body.slice(after)}`;
    }
  }
  return `${header}
${body}`;
}
