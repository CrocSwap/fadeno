      dispatch_id: shadowDispatchId,
      pair_id: pairId,
      archetype,
      role,
      resolution: "shadow",
      shadow: true,
      primary_dispatch_id: dispatchId,
      shadow_source: shadowSourceTag,
      gate_eligible: false,
