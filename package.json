{
  "name": "fadeno",
  "version": "0.7.0",
  "description": "A meta-harness for subagent workflows: route archetypes to models, spawn subagents in scaffolded worktrees, and keep a ledger of every dispatch.",
  "keywords": [
    "ai",
    "agents",
    "codex",
    "claude-code",
    "omp",
    "subagents",
    "dispatch",
    "worktrees",
    "skills"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "fadeno": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "plugin/bin",
    "plugin-codex/bin",
    "plugin-omp/bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit -p .",
    "build:bin": "node scripts/build-bin.mjs",
    "build:plugin": "npm run build && node src/cli.ts plugin ./plugin --force && npm run build:bin",
    "build:plugin:codex": "npm run build && node src/cli.ts plugin --codex --force && npm run build:bin",
    "build:plugin:omp": "npm run build && node src/cli.ts plugin --omp --force && npm run build:bin",
    "prepare": "npm run build",
    "dev": "node src/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "focus": "node --test",
    "probe": "node",
    "eval:summary": "node evals/scripts/summarize-results.mjs --results-dir evals/results --valid-only",
    "prepublishOnly": "npm run build",
    "test:fast": "node scripts/test-fast.mjs",
    "test:fast:regen": "node scripts/test-fast-regen.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
